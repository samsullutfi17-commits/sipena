<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hasil Ujian - <%= ujian.judul_ujian %> - SIPENA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/style.css">
    <style>
        .score-circle {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            color: white;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        }
        .score-circle.lulus {
            background: linear-gradient(135deg, #16a34a, #15803d);
        }
        .score-circle.tidak-lulus {
            background: linear-gradient(135deg, #dc2626, #b91c1c);
        }
        .score-val {
            font-size: 2.8rem;
            font-weight: 800;
            line-height: 1;
        }
        .score-max {
            font-size: 0.85rem;
            opacity: 0.85;
        }
        .soal-review-card {
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 16px;
            background: white;
        }
        .soal-review-card.correct {
            border-left: 5px solid #16a34a;
        }
        .soal-review-card.wrong {
            border-left: 5px solid #dc2626;
        }
    </style>
</head>
<body>
    <header class="header">
        <div class="container" style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h1>Hasil Penilaian Akademik</h1>
                <p class="subtitle"><%= ujian.judul_ujian %> &bull; <%= ujian.nama_mk %></p>
            </div>
            <a href="/peserta_logout" class="btn btn-accent"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </header>

    <div class="container" style="max-width: 850px; margin-top: 30px; margin-bottom: 60px;">
        <div class="card text-center" style="padding: 40px 24px; margin-bottom: 30px;">
            <% 
            const isLulus = (scores.total || 0) >= (ujian.nilai_lulus || 60);
            %>
            <div class="score-circle <%= isLulus ? 'lulus' : 'tidak-lulus' %>">
                <span class="score-val"><%= scores.total || 0 %></span>
                <span class="score-max">/ <%= ujian.total_nilai || 100 %></span>
            </div>

            <h2 style="margin-bottom: 8px; color: <%= isLulus ? '#15803d' : '#b91c1c' %>;">
                <%= isLulus ? 'Selamat, Anda Dinyatakan LULUS!' : 'Belum Memenuhi Batas Kelulusan' %>
            </h2>
            <p style="color: var(--text-muted); font-size: 1rem;">
                Nama Peserta: <strong><%= namaPeserta %></strong> (<%= nimPeserta %>) &bull; Batas Kelulusan: <%= ujian.nilai_lulus || 60 %> Poin
            </p>

            <div style="margin-top: 24px;">
                <a href="/peserta_login?status=selesai" class="btn btn-primary">
                    <i class="fas fa-check"></i> Selesai & Kembali ke Portal
                </a>
            </div>
        </div>

        <h3 style="margin-bottom: 20px;"><i class="fas fa-list-check"></i> Rincian Evaluasi Soal</h3>

        <% soalList.forEach(function(s, idx) { 
            const detail = scores.details && scores.details[s.id];
            const isCorrect = detail ? detail.is_correct : false;
            const poinDidapat = detail ? detail.nilai : 0;
            const jawabanPeserta = detail ? detail.jawaban : '-';
        %>
            <div class="soal-review-card <%= isCorrect ? 'correct' : 'wrong' %>">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                    <strong>Soal <%= idx + 1 %> (<%= s.jenis_soal.toUpperCase() %>)</strong>
                    <span class="badge" style="background: <%= isCorrect ? '#dcfce7' : '#fee2e2' %>; color: <%= isCorrect ? '#15803d' : '#b91c1c' %>; padding: 4px 10px; border-radius: 4px; font-weight: 600;">
                        Nilai: <%= poinDidapat %> / <%= s.poin || 4 %> Poin
                    </span>
                </div>

                <div style="margin-bottom: 12px; color: var(--text-dark);">
                    <%- s.pertanyaan %>
                </div>

                <% if (s.pembahasan) { %>
                    <div style="padding: 10px 14px; background: #f8fafc; border-left: 3px solid var(--primary); font-size: 0.9rem; color: #334155; border-radius: 4px;">
                        <strong><i class="fas fa-info-circle"></i> Pembahasan:</strong> <%= s.pembahasan %>
                    </div>
                <% } %>
            </div>
        <% }); %>
    </div>
</body>
</html>
