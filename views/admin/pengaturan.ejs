<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pengaturan Institusi - SIPENA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="stylesheet" href="/assets/css/admin.css">
    <script src="/assets/js/admin-sidebar.js" defer></script>
</head>
<body>
    <header class="header">
        <div class="container header-flex" style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h1>SIPENA – Pengaturan Sistem</h1>
                <p class="subtitle"><%= adminNama %></p>
            </div>
            <a href="/admin/logout" class="btn btn-accent"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </header>

    <div class="admin-container">
        <%- include('../partials/admin_sidebar', { currentPath: '/admin/pengaturan', adminRole: adminRole }) %>

        <main class="admin-main">
            <nav class="breadcrumb">
                <a href="/admin/dashboard">Beranda</a> &raquo;
                <span>Pengaturan</span>
            </nav>

            <h2><i class="fas fa-cog"></i> Pengaturan Identitas Institusi</h2>

            <% if (message) { %>
                <div class="alert alert-success"><%= message %></div>
            <% } %>

            <div class="card" style="max-width: 650px;">
                <form method="POST" action="/admin/pengaturan">
                    <div class="form-group">
                        <label>Nama Perguruan Tinggi / Institusi</label>
                        <input type="text" name="nama_institusi" value="<%= settings.nama_institusi %>" class="form-control" required>
                    </div>

                    <div class="form-group">
                        <label>Fakultas / Unit Kerja</label>
                        <input type="text" name="fakultas_institusi" value="<%= settings.fakultas_institusi %>" class="form-control" required>
                    </div>

                    <div class="form-group">
                        <label>Alamat Lengkap</label>
                        <textarea name="alamat_institusi" rows="2" class="form-control" required><%= settings.alamat_institusi %></textarea>
                    </div>

                    <div class="form-group">
                        <label>Nomor Telepon & Email Resmi</label>
                        <input type="text" name="telepon_institusi" value="<%= settings.telepon_institusi %>" class="form-control" required>
                    </div>

                    <div class="form-group">
                        <label>Website Resmi</label>
                        <input type="text" name="website_institusi" value="<%= settings.website_institusi %>" class="form-control" required>
                    </div>

                    <div style="margin-top: 24px;">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Simpan Perubahan</button>
                    </div>
                </form>
            </div>
        </main>
    </div>
</body>
</html>
