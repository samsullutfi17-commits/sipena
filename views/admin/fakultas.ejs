<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Fakultas - SIPENA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="stylesheet" href="/assets/css/admin.css">
    <script src="/assets/js/admin-sidebar.js" defer></script>
</head>
<body>
    <header class="header">
        <div class="container header-flex" style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h1>SIPENA – Struktur Organisasi</h1>
                <p class="subtitle"><%= adminNama %></p>
            </div>
        </div>
    </header>

    <div class="admin-container">
        <%- include('../partials/admin_sidebar', { currentPath: '/admin/fakultas', adminRole: adminRole }) %>

        <main class="admin-main">
            <nav class="breadcrumb" style="margin-bottom: 14px;">
                <a href="/admin/dashboard">Beranda</a> &raquo;
                <span>Fakultas / Organisasi</span>
            </nav>

            <div class="page-header-row">
                <div>
                    <h2 class="page-title">
                        <i class="fas fa-building"></i> Data Fakultas / Organisasi
                    </h2>
                    <p class="page-subtitle">
                        Kelola data fakultas dan struktur organisasi akademik kampus.
                    </p>
                </div>
                <button type="button" class="btn-primary-action" onclick="document.getElementById('modal-fakultas').style.display='flex'">
                    <i class="fas fa-plus"></i> Tambah Fakultas
                </button>
            </div>

            <% if (message) { %>
                <div class="alert alert-success" style="margin-bottom: 20px;">
                    <i class="fas fa-check-circle" style="margin-right: 6px;"></i> <%= message %>
                </div>
            <% } %>

            <div class="modern-table-card">
                <div style="overflow-x: auto;">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th style="width: 60px; text-align: center;">No</th>
                                <th style="width: 140px;">Kode</th>
                                <th>Nama Fakultas</th>
                                <th style="width: 150px; text-align: center;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (fakultasList.length === 0) { %>
                                <tr>
                                    <td colspan="4" style="text-align: center; padding: 42px; color: #64748b;">
                                        Belum ada data fakultas. Klik tombol <strong>+ Tambah Fakultas</strong> untuk menambahkan.
                                    </td>
                                </tr>
                            <% } else { %>
                                <% fakultasList.forEach(function(f, idx) { %>
                                    <tr>
                                        <td style="text-align: center; color: #64748b; font-weight: 600;"><%= idx + 1 %></td>
                                        <td><span class="kode-badge"><%= f.kode_fakultas %></span></td>
                                        <td><strong style="color: #0f172a; font-size: 0.94rem;"><%= f.nama_fakultas %></strong></td>
                                        <td style="text-align: center;">
                                            <div style="display: flex; gap: 6px; justify-content: center; align-items: center;">
                                                <button type="button" class="btn-action-edit" title="Edit Fakultas" onclick="openModalEditFakultas(<%= JSON.stringify(f) %>)">
                                                    <i class="fas fa-pen-to-square"></i> Edit
                                                </button>
                                                <button type="button" class="btn-action-delete" title="Hapus Fakultas" onclick="openConfirmDeleteFakultas(<%= f.id %>, '<%= (f.nama_fakultas || '').replace(/'/g, '\\\'') %>')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- MODAL 1: TAMBAH FAKULTAS (CENTERED) -->
    <div id="modal-fakultas" class="modal-overlay" style="display: none; position: fixed; inset: 0; width: 100vw; height: 100vh; background: rgba(15,23,42,0.6); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box;">
        <div class="card" style="max-width: 480px; width: 100%; border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.25); border: 1px solid #e2e8f0; padding: 24px; box-sizing: border-box; background: #ffffff;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                <h3 style="margin: 0; font-size: 1.25rem; font-weight: 700; color: #1b4d3e; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-building"></i> Tambah Fakultas
                </h3>
                <button type="button" style="background: none; border: none; font-size: 1.4rem; color: #94a3b8; cursor: pointer;" onclick="document.getElementById('modal-fakultas').style.display='none'">&times;</button>
            </div>
            <form method="POST" action="/admin/fakultas">
                <input type="hidden" name="action" value="create">
                <div class="form-group" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Kode Fakultas <span style="color:#dc2626;">*</span></label>
                    <input type="text" name="kode_fakultas" required class="form-control" placeholder="Contoh: FT / FEB" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                </div>
                <div class="form-group" style="margin-bottom: 18px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Nama Fakultas <span style="color:#dc2626;">*</span></label>
                    <input type="text" name="nama_fakultas" required class="form-control" placeholder="Contoh: Fakultas Teknik" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                </div>
                <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; border-top: 1px solid #f1f5f9; padding-top: 14px;">
                    <button type="button" class="btn btn-secondary" onclick="document.getElementById('modal-fakultas').style.display='none'" style="padding: 9px 18px; border-radius: 8px;">Batal</button>
                    <button type="submit" class="btn btn-primary" style="background: #1b4d3e; border: none; padding: 9px 20px; border-radius: 8px; font-weight: 600;"><i class="fas fa-check"></i> Simpan</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL 2: EDIT FAKULTAS (CENTERED) -->
    <div id="modal-edit-fakultas" class="modal-overlay" style="display: none; position: fixed; inset: 0; width: 100vw; height: 100vh; background: rgba(15,23,42,0.6); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box;">
        <div class="card" style="max-width: 480px; width: 100%; border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.25); border: 1px solid #e2e8f0; padding: 24px; box-sizing: border-box; background: #ffffff;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                <h3 style="margin: 0; font-size: 1.25rem; font-weight: 700; color: #1b4d3e; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-pen-to-square"></i> Edit Fakultas
                </h3>
                <button type="button" style="background: none; border: none; font-size: 1.4rem; color: #94a3b8; cursor: pointer;" onclick="document.getElementById('modal-edit-fakultas').style.display='none'">&times;</button>
            </div>
            <form method="POST" action="/admin/fakultas">
                <input type="hidden" name="action" value="edit">
                <input type="hidden" name="id" id="edit_fakultas_id">

                <div class="form-group" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Kode Fakultas <span style="color:#dc2626;">*</span></label>
                    <input type="text" name="kode_fakultas" id="edit_kode_fakultas" required class="form-control" placeholder="Contoh: FT / FEB" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                </div>
                <div class="form-group" style="margin-bottom: 18px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Nama Fakultas <span style="color:#dc2626;">*</span></label>
                    <input type="text" name="nama_fakultas" id="edit_nama_fakultas" required class="form-control" placeholder="Contoh: Fakultas Teknik" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                </div>
                <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; border-top: 1px solid #f1f5f9; padding-top: 14px;">
                    <button type="button" class="btn btn-secondary" onclick="document.getElementById('modal-edit-fakultas').style.display='none'" style="padding: 9px 18px; border-radius: 8px;">Batal</button>
                    <button type="submit" class="btn btn-primary" style="background: #1b4d3e; border: none; padding: 9px 20px; border-radius: 8px; font-weight: 600;"><i class="fas fa-check"></i> Simpan Perubahan</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL 3: KONFIRMASI HAPUS FAKULTAS -->
    <div id="modal-delete-fakultas" class="modal-overlay" style="display: none; position: fixed; inset: 0; width: 100vw; height: 100vh; background: rgba(15,23,42,0.6); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box;">
        <div class="card" style="max-width: 440px; width: 100%; border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.25); border: 1px solid #e2e8f0; padding: 24px; box-sizing: border-box; background: #ffffff;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                <h3 style="margin: 0; font-size: 1.25rem; font-weight: 700; color: #dc2626; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-trash"></i> Hapus Fakultas
                </h3>
                <button type="button" style="background: none; border: none; font-size: 1.4rem; color: #94a3b8; cursor: pointer;" onclick="closeConfirmDeleteFakultas()">&times;</button>
            </div>
            <p style="color: #334155; margin: 0 0 16px; font-size: 0.95rem; line-height: 1.5;">
                Apakah Anda yakin ingin menghapus fakultas <strong id="deleteFakultasName"></strong>?
            </p>
            <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 12px 14px; color: #991b1b; font-size: 0.85rem; margin-bottom: 20px;">
                <i class="fas fa-triangle-exclamation" style="margin-right: 6px;"></i> Tindakan ini tidak dapat dibatalkan.
            </div>
            <form method="POST" action="/admin/fakultas">
                <input type="hidden" name="action" value="delete">
                <input type="hidden" name="id" id="deleteFakultasId">
                <div style="display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid #f1f5f9; padding-top: 14px;">
                    <button type="button" class="btn btn-secondary" onclick="closeConfirmDeleteFakultas()" style="padding: 9px 18px; border-radius: 8px;">Batal</button>
                    <button type="submit" class="btn btn-primary" style="background: #dc2626; border: none; padding: 9px 20px; border-radius: 8px; font-weight: 600;"><i class="fas fa-trash"></i> Ya, Hapus</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openConfirmDeleteFakultas(id, nama) {
            document.getElementById('deleteFakultasId').value = id;
            document.getElementById('deleteFakultasName').innerText = nama;
            document.getElementById('modal-delete-fakultas').style.display = 'flex';
        }

        function closeConfirmDeleteFakultas() {
            document.getElementById('modal-delete-fakultas').style.display = 'none';
        }

        function openModalEditFakultas(f) {
            document.getElementById('edit_fakultas_id').value = f.id;
            document.getElementById('edit_kode_fakultas').value = f.kode_fakultas || '';
            document.getElementById('edit_nama_fakultas').value = f.nama_fakultas || '';
            document.getElementById('modal-edit-fakultas').style.display = 'flex';
        }

        window.addEventListener('click', function(e) {
            if (e.target === document.getElementById('modal-fakultas')) {
                document.getElementById('modal-fakultas').style.display = 'none';
            }
            if (e.target === document.getElementById('modal-edit-fakultas')) {
                document.getElementById('modal-edit-fakultas').style.display = 'none';
            }
            if (e.target === document.getElementById('modal-delete-fakultas')) {
                document.getElementById('modal-delete-fakultas').style.display = 'none';
            }
        });

        window.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.getElementById('modal-fakultas').style.display = 'none';
                document.getElementById('modal-edit-fakultas').style.display = 'none';
                document.getElementById('modal-delete-fakultas').style.display = 'none';
            }
        });
    </script>
</body>
</html>
