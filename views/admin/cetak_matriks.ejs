                    <p class="sig-name editable-field" id="paperNamaKanan" data-field="nama_pejabat_kanan"><%= formatCetak.nama_pejabat_kanan || ujian.pengampu || (settings && settings.nama_dosen) || 'Samsul Lutfi, S.Pd., M.Pd' %></p>
                    <p>NIDN. <span class="editable-field" id="paperNipKanan" data-field="nip_kanan"><%= formatCetak.nip_kanan || (settings && settings.nidn_dosen) || '0821098902' %></span></p>
                </div>
            </div>
        </div>
    </div>

