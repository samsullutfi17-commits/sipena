<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Matriks Kisi-Kisi - <%= ujian ? ujian.judul_ujian : 'Ujian' %> - <%= (formatCetak && formatCetak.nama_institusi) || (settings && settings.nama_institusi) || 'Universitas Hamzanwadi' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Times+New+Roman&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: "Times New Roman", Times, serif;
            color: #000;
            background-color: #f1f5f9;
            font-size: 11pt;
            line-height: 1.35;
        }

        /* Toolbar on screen only */
        .no-print-toolbar {
            position: sticky;
            top: 0;
            background: #ffffff;
            border-bottom: 2px solid #cbd5e1;
            padding: 12px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
            z-index: 1000;
            font-family: 'Inter', sans-serif;
            flex-wrap: wrap;
            gap: 12px;
        }

        .toolbar-title {
            font-weight: 700;
            font-size: 1rem;
            color: #1e293b;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .toolbar-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            align-items: center;
        }

        .btn {
            font-family: 'Inter', sans-serif;
            font-size: 0.85rem;
            font-weight: 600;
            padding: 8px 14px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            transition: all 0.2s;
        }

        .btn-customize { background: #1b4d3e; color: #fff; }
        .btn-customize:hover { background: #143d22; }
        .btn-live-edit { background: #d97706; color: #fff; }
        .btn-live-edit:hover { background: #b45309; }
        .btn-live-edit.active { background: #10b981; }
        .btn-print { background: #1e5631; color: #fff; }
        .btn-print:hover { background: #143d22; }
        .btn-word { background: #2563eb; color: #fff; }
        .btn-word:hover { background: #1d4ed8; }
        .btn-excel { background: #16a34a; color: #fff; }
        .btn-excel:hover { background: #15803d; }
        .btn-back { background: #64748b; color: #fff; }
        .btn-back:hover { background: #475569; }

        /* Paper sheet in landscape A4 */
        .paper-sheet {
            width: 297mm;
            min-height: 210mm;
            margin: 20px auto;
            background: #ffffff;
            padding: 15mm 20mm 15mm 20mm;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }

        /* Kop Surat */
        .kop-surat {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 2px;
        }

        .kop-logo {
            width: 80px;
            height: 80px;
            flex-shrink: 0;
            object-fit: contain;
        }

        .kop-teks {
            flex: 1;
            text-align: center;
        }

        .kop-instansi {
            font-size: 13.5pt;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .kop-fakultas {
            font-size: 14pt;
            font-weight: bold;
            text-transform: uppercase;
            color: #000;
        }

        .kop-alamat {
            font-size: 9.5pt;
            font-style: italic;
            margin-top: 2px;
            line-height: 1.25;
        }

        .kop-divider {
            border-top: 2.5px solid #000;
            border-bottom: 1px solid #000;
            height: 4px;
            margin: 6px 0 14px 0;
        }

        /* Title */
        .doc-title {
            text-align: center;
            margin-bottom: 14px;
        }

        .doc-title h2 {
            font-size: 13pt;
            font-weight: bold;
            text-transform: uppercase;
            text-decoration: underline;
            margin-bottom: 2px;
        }

        .doc-title p {
            font-size: 10.5pt;
            font-weight: bold;
        }

        /* Identity meta table (2 balanced columns) */
        .meta-table {
            width: 100%;
            margin-bottom: 14px;
            font-size: 10pt;
            border-collapse: collapse;
        }

        .meta-table td {
            padding: 3px 6px;
            vertical-align: top;
        }

        /* Matrix table */
        .matrix-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 9.5pt;
            margin-bottom: 16px;
        }

        .matrix-table th, .matrix-table td {
            border: 1px solid #000;
            padding: 6px 8px;
            vertical-align: top;
        }

        .matrix-table th {
            background-color: #f1f5f9;
            text-align: center;
            font-weight: bold;
            font-size: 9pt;
        }

        .text-center { text-align: center; }
        .text-right { text-align: right; }

        /* Signature block */
        .signature-section {
            display: flex;
            justify-content: space-between;
            margin-top: 24px;
            font-size: 10pt;
            page-break-inside: avoid;
        }

        .sig-box {
            width: 260px;
            text-align: center;
        }

        .sig-space {
            height: 60px;
        }

        .sig-name {
            font-weight: bold;
            text-decoration: underline;
        }

        /* Live Editing Highlights */
        body.live-editing .editable-field {
            outline: 1.5px dashed #2563eb !important;
            outline-offset: 2px;
            cursor: text;
            background: rgba(239, 246, 255, 0.6);
            transition: all 0.15s;
        }

        body.live-editing .editable-field:hover,
        body.live-editing .editable-field:focus {
            background: #dbeafe;
            outline: 2px solid #1d4ed8 !important;
        }

        /* Floating Live Edit Bottom Bar */
        .live-edit-bar {
            display: none;
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: #0f172a;
            color: #ffffff;
            padding: 12px 20px;
            border-radius: 50px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
            z-index: 10000;
            font-family: 'Inter', sans-serif;
            align-items: center;
            gap: 12px;
            border: 1px solid #334155;
            animation: slideUp 0.2s ease-out;
        }

        .live-edit-bar.active {
            display: flex;
        }

        @keyframes slideUp {
            from { transform: translate(-50%, 20px); opacity: 0; }
            to { transform: translate(-50%, 0); opacity: 1; }
        }

        /* Custom Modal for Format Settings */
        .custom-modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(4px);
            z-index: 10001;
            align-items: center;
            justify-content: center;
            padding: 20px;
            font-family: 'Inter', sans-serif;
        }

        .custom-modal-card {
            background: #ffffff;
            border-radius: 14px;
            max-width: 820px;
            width: 100%;
            max-height: 92vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            border: 1px solid #e2e8f0;
            overflow: hidden;
            animation: modalIn 0.2s ease-out;
        }

        @keyframes modalIn {
            from { opacity: 0; transform: scale(0.96) translateY(10px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        .custom-modal-header {
            padding: 18px 24px;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #f8fafc;
        }

        .custom-modal-header h3 {
            margin: 0;
            color: #1b4d3e;
            font-size: 1.25rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .close-btn {
            background: none;
            border: none;
            font-size: 1.5rem;
            color: #94a3b8;
            cursor: pointer;
            border-radius: 6px;
            padding: 2px 8px;
        }

        .close-btn:hover { background: #e2e8f0; color: #0f172a; }

        .modal-tabs {
            display: flex;
            background: #f1f5f9;
            border-bottom: 1px solid #cbd5e1;
            padding: 0 16px;
            overflow-x: auto;
        }

        .modal-tab-btn {
            padding: 12px 18px;
            border: none;
            background: none;
            font-family: inherit;
            font-size: 0.9rem;
            font-weight: 600;
            color: #64748b;
            cursor: pointer;
            border-bottom: 3px solid transparent;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

        .modal-tab-btn.active {
            color: #1b4d3e;
            border-bottom-color: #1b4d3e;
            background: #ffffff;
        }

        .modal-tab-content {
            display: none;
            padding: 20px 24px;
            overflow-y: auto;
            flex: 1;
        }

        .modal-tab-content.active {
            display: block;
        }

        .form-group {
            margin-bottom: 14px;
        }

        .form-group label {
            display: block;
            font-weight: 600;
            font-size: 0.88rem;
            color: #1e293b;
            margin-bottom: 6px;
        }

        .form-control, .form-select {
            width: 100%;
            padding: 9px 12px;
            border: 1.5px solid #cbd5e1;
            border-radius: 8px;
            font-family: inherit;
            font-size: 0.9rem;
            box-sizing: border-box;
        }

        .form-control:focus, .form-select:focus {
            border-color: #1b4d3e;
            outline: none;
            box-shadow: 0 0 0 3px rgba(27,77,62,0.15);
        }

        .custom-modal-footer {
            padding: 16px 24px;
            background: #f8fafc;
            border-top: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .quick-chip {
            padding: 4px 10px;
            font-size: 0.78rem;
            font-weight: 600;
            border-radius: 6px;
            border: 1px solid #cbd5e1;
            background: #ffffff;
            color: #334155;
            cursor: pointer;
            transition: all 0.15s;
        }

        .quick-chip:hover {
            background: #f1f5f9;
            color: #0f172a;
            border-color: #94a3b8;
        }

        .table-rows-builder {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.88rem;
            margin-top: 8px;
        }

        .table-rows-builder th {
            background: #f8fafc;
            padding: 8px 10px;
            border: 1px solid #e2e8f0;
            text-align: left;
            font-weight: 600;
        }

        .table-rows-builder td {
            padding: 8px 10px;
            border: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        /* Print styles */
        @media print {
            @page {
                size: A4 landscape;
                margin: 10mm 15mm 10mm 15mm;
            }

            body {
                background: #ffffff;
                font-size: 9.5pt;
            }

            .no-print-toolbar, .live-edit-bar, .custom-modal-overlay {
                display: none !important;
            }

            .paper-sheet {
                width: 100% !important;
                min-height: auto;
                margin: 0 !important;
                padding: 0 !important;
                box-shadow: none !important;
            }

            .matrix-table th {
                background-color: #eee !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>
    <!-- TOOLBAR ATAS -->
    <div class="no-print-toolbar">
        <div class="toolbar-title">
            <i class="fas fa-table-cells" style="color: #1e5631;"></i>
            <span>Matriks Kisi-Kisi: <strong><%= ujian ? ujian.judul_ujian : 'Ujian' %></strong></span>
            <% if (currentUser) { %>
                <span style="font-size: 0.78rem; background: #e0f2fe; color: #0369a1; padding: 2px 8px; border-radius: 4px; font-weight: 600;">
                    <i class="fas fa-user-circle"></i> <%= currentUser.role.toUpperCase() %>: <%= currentUser.nama_lengkap %>
                </span>
            <% } %>
        </div>
        <div class="toolbar-actions">
            <button type="button" class="btn btn-customize" onclick="openFormatModal()">
                <i class="fas fa-sliders"></i> Sesuaikan Kop & Identitas
            </button>
            <button type="button" class="btn btn-live-edit" id="btnToggleLiveEdit" onclick="toggleLiveEdit()">
                <i class="fas fa-pencil"></i> Edit Cepat di Kertas
            </button>
            <button onclick="window.print()" class="btn btn-print">
                <i class="fas fa-print"></i> Cetak / Simpan PDF
            </button>
            <a href="/admin/kisi_kisi/export_matrix_word?ujian_id=<%= ujian ? ujian.id : 0 %>" class="btn btn-word" title="Unduh format Microsoft Word matriks kisi-kisi">
                <i class="fas fa-file-word"></i> Word (.docx)
            </a>
            <a href="/admin/kisi_kisi/export_excel?ujian_id=<%= ujian ? ujian.id : 0 %>" class="btn btn-excel" title="Unduh spreadsheet Excel lengkap matriks & soal">
                <i class="fas fa-file-excel"></i> Excel (.xlsx)
            </a>
            <a href="/admin/soal/cetak_naskah?ujian_id=<%= ujian ? ujian.id : 0 %>" target="_blank" class="btn btn-back" style="background: #0284c7;" title="Buka cetak naskah soal lengkap">
                <i class="fas fa-file-alt"></i> Naskah Soal PDF
            </a>
            <a href="/admin/kisi_kisi?ujian_id=<%= ujian ? ujian.id : 0 %>" class="btn btn-back">
                <i class="fas fa-arrow-left"></i> Kembali
            </a>
        </div>
    </div>

    <!-- FLOATING LIVE EDIT BAR -->
    <div id="liveEditFloatingBar" class="live-edit-bar">
        <span><i class="fas fa-magic" style="color: #facc15;"></i> <strong>Mode Edit Cepat Aktif:</strong> Klik teks pada kertas untuk mengedit langsung.</span>
        <button type="button" class="btn btn-sm" style="background: #334155; color: #fff; padding: 6px 12px;" onclick="addRowDirect()">
            <i class="fas fa-plus"></i> Baris Identitas
        </button>
        <button type="button" class="btn btn-sm" style="background: #10b981; color: #fff; padding: 6px 14px;" onclick="saveDirectChanges()">
            <i class="fas fa-check"></i> Simpan Perubahan
        </button>
        <button type="button" class="btn btn-sm" style="background: #ef4444; color: #fff; padding: 6px 12px;" onclick="toggleLiveEdit()">
            <i class="fas fa-times"></i> Keluar
        </button>
    </div>

    <!-- PRINTABLE PAPER SHEET (A4 LANDSCAPE) -->
    <div class="paper-sheet" id="printPaper">
        <!-- 1. KOP SURAT / KORPS -->
        <div id="paperKopSection" style="<%= formatCetak.tampilkan_kop ? '' : 'display: none;' %>">
            <div class="kop-surat">
                <% if (formatCetak.tampilkan_logo) { %>
                    <img src="<%= formatCetak.logo_path || '/assets/img/logo_hamzanwadi.png' %>" id="paperLogoImg" alt="Logo" class="kop-logo" onerror="this.src='/assets/img/logo_hamzanwadi.png'">
                <% } %>
                <div class="kop-teks">
                    <div class="kop-instansi editable-field" id="paperNamaInstitusi" data-field="nama_institusi"><%= formatCetak.nama_institusi || 'UNIVERSITAS HAMZANWADI' %></div>
                    <% if (formatCetak.sub_institusi) { %>
                        <div class="kop-fakultas editable-field" id="paperSubInstitusi" data-field="sub_institusi"><%= formatCetak.sub_institusi %></div>
                    <% } %>
                    <div class="kop-alamat editable-field" id="paperAlamatInstitusi" data-field="alamat_institusi"><%= formatCetak.alamat_institusi || 'Jl. TGKH. Muhammad Zainuddin Abdul Madjid No. 132, Pancor, Selong, Lombok Timur, NTB 83611' %></div>
                    <div class="kop-alamat editable-field" id="paperKontakInstitusi" data-field="kontak_institusi"><%= formatCetak.kontak_institusi || 'Telp. (0376) 22954, Website: http://hamzanwadi.ac.id, email: universitas@hamzanwadi.ac.id' %></div>
                </div>
            </div>
            <% if (formatCetak.tampilkan_garis) { %>
                <div class="kop-divider" id="paperKopDivider"></div>
            <% } %>
        </div>

        <!-- 2. JUDUL DOKUMEN MATRIKS KISI-KISI -->
        <div class="doc-title" id="paperTitleSection">
            <h2 class="editable-field" id="paperJudulMatriks" data-field="judul_matriks"><%= formatCetak.judul_matriks || 'KISI-KISI PENULISAN BUTIR SOAL UJIAN' %></h2>
            <p class="editable-field" id="paperSubJudul" data-field="sub_judul"><%= formatCetak.sub_judul || ('TAHUN AKADEMIK ' + (ujian.tahun_akademik || '2024/2025') + ' • SEMESTER ' + (ujian && ujian.jenis_ujian ? ujian.jenis_ujian : 'GANJIL')) %></p>
        </div>

        <!-- 3. TABEL IDENTITAS SOAL & KISI-KISI (DINAMIS 2-KOLOM OTOMATIS TERSUSUN RAPI) -->
        <table class="meta-table" id="paperMetaTable">
            <tbody id="paperMetaBody">
                <% (formatCetak.identitas_rows || []).forEach(function(r, rIdx) { %>
                    <tr data-row-idx="<%= rIdx %>">
                        <td style="width: 18%;">
                            <strong class="meta-label editable-field" data-role="kiri-label"><%= r.kiri_label %></strong>
                        </td>
                        <td style="width: 2%;">:</td>
                        <td style="width: 38%;">
                            <span class="meta-val editable-field" data-role="kiri-val"><%= r.kiri_val %></span>
                        </td>
                        <td style="width: 18%;">
                            <strong class="meta-label editable-field" data-role="kanan-label"><%= r.kanan_label %></strong>
                        </td>
                        <td style="width: 2%;">:</td>
                        <td style="width: 22%;">
                            <span class="meta-val editable-field" data-role="kanan-val"><%= r.kanan_val %></span>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>

        <!-- 4. MATRIKS KISI-KISI TABEL -->
        <table class="matrix-table">
            <thead>
                <tr>
                    <th style="width: 35px;">No</th>
                    <th style="width: 22%;">Capaian Pembelajaran (CPMK)</th>
                    <th style="width: 18%;">Bahan Kajian / Materi</th>
                    <th>Indikator Pencapaian Butir Soal</th>
                    <th style="width: 65px;">Bentuk</th>
                    <th style="width: 55px;">Level</th>
                    <th style="width: 65px;">Kesulitan</th>
                    <th style="width: 45px;">No. Soal</th>
                    <th style="width: 50px;">Bobot</th>
                </tr>
            </thead>
            <tbody>
                <% if (!soalList || soalList.length === 0) { %>
                    <tr>
                        <td colspan="9" class="text-center" style="padding: 24px; color: #64748b;">
                            Belum ada butir soal dalam kisi-kisi ujian ini. Gunakan tombol "Generate Kisi-Kisi AI" untuk menyusun otomatis.
                        </td>
                    </tr>
                <% } else { %>
                    <% 
                        function getJenisLabel(code) {
                            const map = {
                                'pg': 'Pilihan Ganda (PG)',
                                'pg_kompleks': 'PG Kompleks',
                                'tf': 'Benar / Salah',
                                'menjodohkan': 'Menjodohkan',
                                'short': 'Isian Singkat',
                                'isian': 'Isian Singkat',
                                'esai': 'Uraian / Esai',
                                'essay': 'Uraian / Esai'
                            };
                            return map[(code || '').toLowerCase()] || (code ? code.toUpperCase() : 'Pilihan Ganda');
                        }
                    %>
                    <% soalList.forEach(function(s, idx) { %>
                        <% 
                            let jType = 'PG';
                            const code = (s.jenis_soal || '').toLowerCase();
                            if (code === 'pg_kompleks') jType = 'PG Kompleks';
                            else if (code === 'tf') jType = 'Benar/Salah';
                            else if (code === 'menjodohkan') jType = 'Menjodohkan';
                            else if (code === 'short' || code === 'isian') jType = 'Isian Singkat';
                            else if (code === 'esai' || code === 'essay') jType = 'Uraian/Esai';
                        %>
                        <tr>
                            <td class="text-center"><%= idx + 1 %></td>
                            <td><strong><%= s.cpmk || 'Capaian Pembelajaran Mata Kuliah' %></strong></td>
                            <td><%= s.materi_pokok || (ujian.nama_mk || ujian.judul_ujian) %></td>
                            <td><%= s.indikator || (s.pertanyaan ? s.pertanyaan.replace(/<[^>]*>?/gm, '').substring(0, 90) + '...' : '-') %></td>
                            <td class="text-center"><strong><%= jType %></strong></td>
                            <td class="text-center"><strong><%= s.level_kognitif || 'C2' %></strong></td>
                            <td class="text-center" style="text-transform: capitalize;"><%= s.tingkat_kesulitan || 'sedang' %></td>
                            <td class="text-center"><strong><%= idx + 1 %></strong></td>
                            <td class="text-center"><strong><%= s.poin || 4 %></strong></td>
                        </tr>
                    <% }); %>
                    <tr style="background: #f8fafc; font-weight: bold;">
                        <td colspan="4" class="text-right" style="padding-right: 12px;">Total Distribusi Poin & Butir Soal:</td>
                        <td class="text-center"><%= soalList.length %> Butir</td>
                        <td colspan="2" class="text-center">
                            M: <%= soalList.filter(s => (s.tingkat_kesulitan || '').toLowerCase() === 'mudah').length %> | 
                            S: <%= soalList.filter(s => (s.tingkat_kesulitan || '').toLowerCase() === 'sedang').length %> | 
                            D: <%= soalList.filter(s => (s.tingkat_kesulitan || '').toLowerCase() === 'sulit').length %>
                        </td>
                        <td class="text-center">1 - <%= soalList.length %></td>
                        <td class="text-center"><%= soalList.reduce((acc, s) => acc + (s.poin || 0), 0) %></td>
                    </tr>
                <% } %>
            </tbody>
        </table>

        <!-- 5. TANDA TANGAN / PENGESAHAN (KUSTOMISASI BEBAS) -->
        <div id="paperSigSection" style="<%= formatCetak.tampilkan_ttd !== false ? '' : 'display: none;' %>">
            <div class="signature-section">
                <div class="sig-box">
                    <p>Mengetahui,</p>
