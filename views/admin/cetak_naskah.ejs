                    <p style="margin: 2px 0 0; font-size: 9pt;">NIDN. <%= formatCetak.nip_kiri || (settings && settings.nidn_kaprodi) || '0812048501' %></p>
                </div>
                <% if (formatCetak.nama_pengawas || formatCetak.tampilkan_pengawas) { %>
                <div style="flex: 1;">
                    <p style="margin: 0 0 4px; font-size: 10pt;">Diverifikasi Oleh,</p>
                    <p style="margin: 0; font-weight: bold; font-size: 10pt;"><%= formatCetak.jabatan_pengawas || 'Pengawas Ujian' %></p>
                    <div style="height: 55px;"></div>
                    <p style="margin: 0; font-weight: bold; text-decoration: underline; font-size: 10pt;"><%= formatCetak.nama_pengawas || 'Pengawas Ujian' %></p>
                    <p style="margin: 2px 0 0; font-size: 9pt;">NIDN. <%= formatCetak.nip_pengawas || '-' %></p>
                </div>
                <% } %>
                <div style="flex: 1;">
                    <p style="margin: 0 0 4px; font-size: 10pt;"><%= formatCetak.kota_ttd || 'Selong' %>, <%= formatCetak.tanggal_ttd || new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
                    <p style="margin: 0; font-weight: bold; font-size: 10pt;"><%= formatCetak.jabatan_kanan || 'Dosen Pengampu Mata Kuliah' %></p>
                    <div style="height: 55px;"></div>
                    <p style="margin: 0; font-weight: bold; text-decoration: underline; font-size: 10pt;"><%= formatCetak.nama_pejabat_kanan || ujian.pengampu || (settings && settings.nama_dosen) || 'Samsul Lutfi, S.Pd., M.Pd' %></p>
                    <p style="margin: 2px 0 0; font-size: 9pt;">NIDN. <%= formatCetak.nip_kanan || (settings && settings.nidn_dosen) || '0821098902' %></p>
                </div>
            </div>
        </div>

        <!-- 7. LAMPIRAN I: KUNCI JAWABAN & PEDOMAN PENILAIAN -->
        <div class="appendix-section">
            <div class="appendix-title">LAMPIRAN I: KUNCI JAWABAN & PEDOMAN PENILAIAN</div>
            <div class="appendix-subtitle">Naskah Evaluasi: <%= ujian.judul_ujian %> | Mata Kuliah: <%= ujian.nama_mk %> | Pengampu: <%= ujian.pengampu || 'Dosen Pengampu' %></div>

            <table class="appendix-table">
                <thead>
                    <tr>
                        <th style="width: 5%;">No</th>
                        <th style="width: 16%;">Bentuk Soal</th>
                        <th style="width: 10%;">Level Bloom</th>
                        <th style="width: 8%;">Bobot</th>
                        <th style="width: 30%;">Kunci Jawaban</th>
                        <th style="width: 31%;">Pembahasan & Rubrik Penskoran</th>
                    </tr>
                </thead>
                <tbody>
                    <% soalList.forEach(function(s, idx) { %>
                        <% 
                            let kunci = '-';
                            if (s.opsi && s.opsi.length > 0) {
                                const correct = s.opsi.filter(o => o.benar);
                                if (correct.length > 0) {
                                    kunci = correct.map(o => {
                                        const lIdx = s.opsi.indexOf(o);
                                        const letter = String.fromCharCode(65 + (lIdx >= 0 ? lIdx : 0));
                                        return letter + '. ' + (o.teks || o.teks_opsi || '');
                                    }).join(' | ');
                                }
                            } else if (s.kunci_jawaban) {
                                kunci = s.kunci_jawaban;
                            } else if (s.pembahasan) {
                                kunci = s.pembahasan;
                            }
                        %>
                        <tr>
                            <td style="text-align: center; font-weight: bold;"><%= idx + 1 %></td>
                            <td><%= getJenisLabel(s.jenis_soal) %></td>
                            <td style="text-align: center;"><%= s.level_kognitif || 'C3' %></td>
                            <td style="text-align: center;"><%= s.poin || 4 %> Poin</td>
                            <td style="font-weight: 600; color: #15803d;"><%= kunci %></td>
                            <td><%= s.pembahasan || '-' %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <!-- 8. LAMPIRAN II: MATRIKS KISI-KISI BUTIR SOAL -->
        <div class="appendix-section">
            <div class="appendix-title">LAMPIRAN II: MATRIKS KISI-KISI PENULISAN SOAL</div>
            <div class="appendix-subtitle">Sebaran Taksonomi Bloom & Indikator Capaian Mata Kuliah: <%= ujian.nama_mk %></div>

            <table class="appendix-table">
                <thead>
                    <tr>
                        <th style="width: 4%;">No</th>
                        <th style="width: 25%;">Capaian Pembelajaran (CPMK)</th>
                        <th style="width: 21%;">Bahan Kajian / Materi Pokok</th>
                        <th style="width: 25%;">Indikator Pencapaian Butir Soal</th>
                        <th style="width: 10%;">Bentuk</th>
                        <th style="width: 8%;">Kognitif</th>
                        <th style="width: 7%;">Bobot</th>
                    </tr>
                </thead>
                <tbody>
                    <% soalList.forEach(function(s, idx) { %>
                        <tr>
                            <td style="text-align: center; font-weight: bold;"><%= idx + 1 %></td>
                            <td><strong><%= s.cpmk || 'Capaian Pembelajaran Mata Kuliah' %></strong></td>
                            <td><%= s.materi_pokok || ujian.nama_mk || 'Materi Pokok' %></td>
                            <td><%= s.indikator || (s.pertanyaan ? s.pertanyaan.replace(/<[^>]*>?/gm, '').substring(0, 80) + '...' : '-') %></td>
                            <td style="text-align: center;"><%= getJenisLabel(s.jenis_soal) %></td>
                            <td style="text-align: center; font-weight: 600;"><%= s.level_kognitif || 'C3' %></td>
                            <td style="text-align: center;"><%= s.poin || 4 %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

