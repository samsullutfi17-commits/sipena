<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Naskah Soal - <%= ujian.judul_ujian %> - <%= (formatCetak && formatCetak.nama_institusi) || 'Universitas Hamzanwadi' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Times+New+Roman&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: "Times New Roman", Times, serif;
            color: #000;
            background-color: #f1f5f9;
            font-size: 12pt;
            line-height: 1.4;
        }

        /* Toolbar on screen only */
        .no-print-toolbar {
            position: sticky;
            top: 0;
            background: #ffffff;
            border-bottom: 2px solid #cbd5e1;
            padding: 12px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
            z-index: 1000;
            font-family: 'Inter', sans-serif;
            flex-wrap: wrap;
            gap: 10px;
        }

        .toolbar-title {
            font-weight: 700;
            font-size: 1rem;
            color: #1e293b;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .toolbar-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            align-items: center;
        }

        .btn {
            font-family: 'Inter', sans-serif;
            font-size: 0.85rem;
            font-weight: 600;
            padding: 8px 14px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            transition: all 0.2s;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        }

        .btn-customize { background: #1b4d3e; color: #fff; }
        .btn-customize:hover { background: #143d22; }
        .btn-live-edit { background: #f8fafc; color: #1e293b; border: 1.5px solid #cbd5e1; }
        .btn-live-edit.active { background: #fef08a; border-color: #eab308; color: #854d0e; }
        .btn-print { background: #059669; color: #fff; }
        .btn-print:hover { background: #047857; }
        .btn-word { background: #2563eb; color: #fff; }
        .btn-word:hover { background: #1d4ed8; }
        .btn-excel { background: #16a34a; color: #fff; }
        .btn-excel:hover { background: #15803d; }
        .btn-back { background: #64748b; color: #fff; }
        .btn-back:hover { background: #475569; }

        /* Paper sheet */
        .paper-sheet {
            width: 210mm;
            min-height: 297mm;
            margin: 24px auto;
            background: #ffffff;
            padding: 20mm 20mm 25mm 20mm;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            position: relative;
        }

        /* Kop Surat matching Image 2 */
        .kop-surat {
            display: flex;
            align-items: center;
            gap: 18px;
            margin-bottom: 4px;
        }

        .kop-logo {
            width: 85px;
            height: 85px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .kop-logo img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .kop-text {
            flex: 1;
            text-align: center;
        }

        .kop-univ {
            font-size: 17pt;
            font-weight: bold;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            margin-bottom: 2px;
        }

        .kop-sub {
            font-size: 11pt;
            font-weight: bold;
            text-transform: uppercase;
            margin-bottom: 2px;
            color: #1e293b;
        }

        .kop-address {
            font-size: 9.5pt;
            line-height: 1.35;
        }

        .kop-contact {
            font-size: 9pt;
            line-height: 1.35;
        }

        .kop-contact a {
            color: #0000ee;
            text-decoration: underline;
        }

        /* Double border line */
        .kop-divider {
            border-top: 3px solid #000;
            border-bottom: 1px solid #000;
            height: 4px;
            margin: 6px 0 16px 0;
        }

        /* Title */
        .exam-title-box {
            text-align: center;
            margin-bottom: 14px;
        }

        .exam-title-main {
            font-size: 12pt;
            font-weight: bold;
            text-transform: uppercase;
        }

        .exam-title-sub {
            font-size: 12pt;
            font-weight: bold;
            text-transform: uppercase;
        }

        /* Boxed Metadata Table matching Image 2 */
        .exam-meta-table {
            width: 100%;
            border-collapse: collapse;
            border: 1.5px solid #000;
            margin-bottom: 16px;
            font-size: 11pt;
        }

        .exam-meta-table td {
            border: 1px solid #000;
            padding: 5px 10px;
            vertical-align: middle;
            width: 50%;
        }

        .meta-row {
            display: flex;
            align-items: baseline;
        }

        .meta-label {
            width: 110px;
            flex-shrink: 0;
            font-weight: normal;
        }

        .meta-sep {
            width: 16px;
            text-align: center;
            flex-shrink: 0;
        }

        .meta-val {
            flex: 1;
            font-weight: normal;
        }

        /* Petunjuk */
        .petunjuk-box {
            margin-bottom: 16px;
        }

        .petunjuk-title {
            font-weight: bold;
            font-style: italic;
            font-size: 11pt;
            margin-bottom: 4px;
        }

        .petunjuk-list {
            padding-left: 24px;
            font-style: italic;
            font-size: 11pt;
            line-height: 1.45;
        }

        .petunjuk-list li {
            margin-bottom: 2px;
        }

        /* Section Heading */
        .section-heading {
            font-weight: bold;
            font-style: italic;
            font-size: 13pt;
            margin: 16px 0 12px 0;
            letter-spacing: 0.5px;
        }

        /* Questions */
        .soal-item {
            margin-bottom: 18px;
            page-break-inside: avoid;
        }

        .soal-header {
            display: flex;
            align-items: flex-start;
            gap: 6px;
            margin-bottom: 6px;
        }

        .soal-num {
            font-weight: bold;
            min-width: 22px;
        }

        .soal-text {
            flex: 1;
            text-align: justify;
        }

        .soal-image-box {
            margin: 10px 0 12px 28px;
            max-width: 550px;
        }

        .soal-image-box img {
            max-width: 100%;
            height: auto;
            border: 1px solid #94a3b8;
            border-radius: 4px;
        }

        .opsi-list {
            list-style: none;
            padding-left: 28px;
            margin-top: 6px;
        }

        .opsi-item {
            display: flex;
            gap: 10px;
            margin-bottom: 4px;
        }

        .opsi-letter {
            font-weight: normal;
            min-width: 18px;
        }

        .opsi-text {
            flex: 1;
        }

        /* Appendix Tables */
        .appendix-section {
            margin-top: 30px;
            page-break-before: always;
        }

        .appendix-title {
            text-align: center;
            font-size: 13pt;
            font-weight: bold;
            margin-bottom: 6px;
            text-transform: uppercase;
        }

        .appendix-subtitle {
            text-align: center;
            font-size: 10pt;
            font-style: italic;
            margin-bottom: 14px;
            color: #334155;
        }

        .appendix-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 9pt;
            margin-bottom: 24px;
        }

        .appendix-table th, .appendix-table td {
            border: 1px solid #000000;
            padding: 6px 8px;
            vertical-align: top;
        }

        .appendix-table th {
            background-color: #f1f5f9;
            font-weight: bold;
            text-align: center;
        }

        /* Live Editing Highlights */
        body.live-editing .editable-field {
            outline: 1.5px dashed #3b82f6 !important;
            outline-offset: 2px;
            cursor: text;
            background: rgba(239, 246, 255, 0.5);
            transition: all 0.15s;
        }

        body.live-editing .editable-field:hover,
        body.live-editing .editable-field:focus {
            background: #dbeafe;
            outline: 2px solid #2563eb !important;
        }

        /* Floating Live Edit Bottom Bar */
        .live-edit-bar {
            display: none;
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: #0f172a;
            color: #ffffff;
            padding: 12px 20px;
            border-radius: 50px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
            z-index: 10000;
            font-family: 'Inter', sans-serif;
            align-items: center;
            gap: 12px;
            border: 1px solid #334155;
            animation: slideUp 0.2s ease-out;
        }

        .live-edit-bar.active {
            display: flex;
        }

        @keyframes slideUp {
            from { transform: translate(-50%, 20px); opacity: 0; }
            to { transform: translate(-50%, 0); opacity: 1; }
        }

        /* Custom Modal for Format Settings */
        .custom-modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(4px);
            z-index: 10001;
            align-items: center;
            justify-content: center;
            padding: 20px;
            font-family: 'Inter', sans-serif;
        }

        .custom-modal-card {
            background: #ffffff;
            border-radius: 14px;
            max-width: 820px;
            width: 100%;
            max-height: 92vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            border: 1px solid #e2e8f0;
            overflow: hidden;
            animation: modalIn 0.2s ease-out;
        }

        @keyframes modalIn {
            from { opacity: 0; transform: scale(0.96) translateY(10px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        .custom-modal-header {
            padding: 18px 24px;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #f8fafc;
        }

        .custom-modal-header h3 {
            margin: 0;
            color: #1b4d3e;
            font-size: 1.25rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .close-btn {
            background: none;
            border: none;
            font-size: 1.5rem;
            color: #94a3b8;
            cursor: pointer;
            border-radius: 6px;
            padding: 2px 8px;
        }

        .close-btn:hover { background: #e2e8f0; color: #0f172a; }

        .modal-tabs {
            display: flex;
            background: #f1f5f9;
            border-bottom: 1px solid #cbd5e1;
            padding: 0 16px;
            overflow-x: auto;
        }

        .modal-tab-btn {
            padding: 12px 18px;
            border: none;
            background: none;
            font-family: inherit;
            font-size: 0.9rem;
            font-weight: 600;
            color: #64748b;
            cursor: pointer;
            border-bottom: 3px solid transparent;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

        .modal-tab-btn.active {
            color: #1b4d3e;
            border-bottom-color: #1b4d3e;
            background: #ffffff;
        }

        .modal-tab-content {
            display: none;
            padding: 20px 24px;
            overflow-y: auto;
            flex: 1;
        }

        .modal-tab-content.active {
            display: block;
        }

        .form-group {
            margin-bottom: 14px;
        }

        .form-group label {
            display: block;
            font-weight: 600;
            font-size: 0.88rem;
            color: #1e293b;
            margin-bottom: 6px;
        }

        .form-control, .form-select {
            width: 100%;
            padding: 9px 12px;
            border: 1.5px solid #cbd5e1;
            border-radius: 8px;
            font-family: inherit;
            font-size: 0.9rem;
            box-sizing: border-box;
        }

        .form-control:focus, .form-select:focus {
            border-color: #1b4d3e;
            outline: none;
            box-shadow: 0 0 0 3px rgba(27,77,62,0.15);
        }

        .custom-modal-footer {
            padding: 16px 24px;
            background: #f8fafc;
            border-top: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .quick-chip {
            padding: 4px 10px;
            font-size: 0.78rem;
            font-weight: 600;
            border-radius: 6px;
            border: 1px solid #cbd5e1;
            background: #ffffff;
            color: #334155;
            cursor: pointer;
            transition: all 0.15s;
        }

        .quick-chip:hover {
            background: #f1f5f9;
            color: #0f172a;
            border-color: #94a3b8;
        }

        .table-rows-builder {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.88rem;
            margin-top: 8px;
        }

        .table-rows-builder th {
            background: #f8fafc;
            padding: 8px 10px;
            border: 1px solid #e2e8f0;
            text-align: left;
            font-weight: 600;
        }

        .table-rows-builder td {
            padding: 8px 10px;
            border: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        /* Print media styles */
        @media print {
            body {
                background: #ffffff;
                color: #000000;
            }

            .no-print-toolbar, .live-edit-bar, .custom-modal-overlay {
                display: none !important;
            }

            .paper-sheet {
                width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
                box-shadow: none !important;
            }

            .appendix-section {
                page-break-before: always !important;
            }

            @page {
                size: A4;
                margin: 20mm 20mm 20mm 20mm;
            }
        }
    </style>
</head>
<body>

    <!-- SCREEN TOOLBAR -->
    <div class="no-print-toolbar">
        <div class="toolbar-title">
            <i class="fas fa-file-alt" style="color: #1e5631;"></i>
            <span>Naskah Ujian: <strong><%= ujian.judul_ujian %></strong></span>
            <% if (currentUser) { %>
                <span style="font-size: 0.78rem; background: #e0f2fe; color: #0369a1; padding: 2px 8px; border-radius: 4px; font-weight: 600;">
                    <i class="fas fa-user-circle"></i> <%= currentUser.role.toUpperCase() %>: <%= currentUser.nama_lengkap %>
                </span>
            <% } %>
        </div>
        <div class="toolbar-actions">
            <button type="button" class="btn btn-customize" onclick="openFormatModal()">
                <i class="fas fa-sliders"></i> Sesuaikan Kop & Identitas
            </button>
            <button type="button" class="btn btn-live-edit" id="btnToggleLiveEdit" onclick="toggleLiveEdit()">
                <i class="fas fa-pencil"></i> Edit Cepat di Kertas
            </button>
            <a href="/admin/soal/export_word?ujian_id=<%= ujian.id %>" class="btn btn-word" title="Unduh format Microsoft Word lengkap kop & kisi-kisi">
                <i class="fas fa-file-word"></i> Word (.docx)
            </a>
            <a href="/admin/soal/export_excel?ujian_id=<%= ujian.id %>" class="btn btn-excel" title="Unduh spreadsheet Excel bank soal & kisi-kisi">
                <i class="fas fa-file-excel"></i> Excel (.xlsx)
            </a>
            <a href="/admin/kisi_kisi/cetak_matriks?ujian_id=<%= ujian.id %>" target="_blank" class="btn btn-back" style="background: #0284c7;" title="Buka cetak matriks kisi-kisi">
                <i class="fas fa-table-cells"></i> Matriks PDF
            </a>
            <button onclick="window.print()" class="btn btn-print" title="Cetak fisik atau simpan sebagai dokumen PDF">
                <i class="fas fa-print"></i> Cetak / Simpan PDF
            </button>
            <a href="/admin/kisi_kisi?ujian_id=<%= ujian.id %>" class="btn btn-back">
                <i class="fas fa-arrow-left"></i> Kembali
            </a>
        </div>
    </div>

    <!-- FLOATING LIVE EDIT BAR -->
    <div id="liveEditFloatingBar" class="live-edit-bar">
        <span><i class="fas fa-magic" style="color: #facc15;"></i> <strong>Mode Edit Cepat Aktif:</strong> Klik teks pada kertas untuk mengedit langsung.</span>
        <button type="button" class="btn btn-sm" style="background: #334155; color: #fff; padding: 6px 12px;" onclick="addRowDirect()">
            <i class="fas fa-plus"></i> Baris Identitas
        </button>
        <button type="button" class="btn btn-sm" style="background: #334155; color: #fff; padding: 6px 12px;" onclick="addPetunjukDirect()">
            <i class="fas fa-plus"></i> Butir Petunjuk
        </button>
        <button type="button" class="btn btn-sm" style="background: #10b981; color: #fff; padding: 6px 14px;" onclick="saveDirectChanges()">
            <i class="fas fa-check"></i> Simpan Perubahan
        </button>
        <button type="button" class="btn btn-sm" style="background: #ef4444; color: #fff; padding: 6px 12px;" onclick="toggleLiveEdit()">
            <i class="fas fa-times"></i> Keluar
        </button>
    </div>

    <!-- PRINTABLE PAPER SHEET -->
    <div class="paper-sheet" id="printPaper">

        <!-- 1. KOP SURAT / KORPS -->
        <div id="paperKopSection" style="<%= formatCetak.tampilkan_kop ? '' : 'display: none;' %>">
            <div class="kop-surat">
                <% if (formatCetak.tampilkan_logo) { %>
                    <div class="kop-logo" id="paperLogoBox">
                        <img src="<%= formatCetak.logo_path || '/assets/img/logo_hamzanwadi.png' %>" id="paperLogoImg" alt="Logo Institusi" onerror="this.src='/assets/img/logo_hamzanwadi.png'">
                    </div>
                <% } %>
                <div class="kop-text">
                    <div class="kop-univ editable-field" id="paperNamaInstitusi" data-field="nama_institusi"><%= formatCetak.nama_institusi || 'UNIVERSITAS HAMZANWADI' %></div>
                    <% if (formatCetak.sub_institusi) { %>
                        <div class="kop-sub editable-field" id="paperSubInstitusi" data-field="sub_institusi"><%= formatCetak.sub_institusi %></div>
                    <% } %>
                    <div class="kop-address editable-field" id="paperAlamatInstitusi" data-field="alamat_institusi"><%= formatCetak.alamat_institusi || 'Jln. TGKH. Muhammad Zainuddin Abdul Madjid No. 132 Pancor, Selong Lombok Timur 83612' %></div>
                    <div class="kop-contact editable-field" id="paperKontakInstitusi" data-field="kontak_institusi"><%= formatCetak.kontak_institusi || 'Telp. (0376) 22954, Website: http://hamzanwadi.ac.id, email: universitas@hamzanwadi.ac.id' %></div>
                </div>
            </div>

            <% if (formatCetak.tampilkan_garis) { %>
                <div class="kop-divider" id="paperKopDivider"></div>
            <% } %>
        </div>

        <!-- 2. JUDUL NASKAH & TAHUN AKADEMIK -->
        <div class="exam-title-box" id="paperTitleSection">
            <div class="exam-title-main editable-field" id="paperJudulUtama" data-field="judul_utama"><%= formatCetak.judul_utama %></div>
            <div class="exam-title-sub editable-field" id="paperSubJudul" data-field="sub_judul"><%= formatCetak.sub_judul %></div>
        </div>

        <!-- 3. TABEL IDENTITAS SOAL (2-KOLOM BERBINGKAI) -->
        <table class="exam-meta-table" id="paperMetaTable">
            <tbody id="paperMetaBody">
                <% (formatCetak.identitas_rows || []).forEach(function(r, rIdx) { %>
                    <tr data-row-idx="<%= rIdx %>">
                        <td>
                            <div class="meta-row">
                                <span class="meta-label editable-field" data-role="kiri-label"><%= r.kiri_label %></span>
                                <span class="meta-sep">:</span>
                                <span class="meta-val editable-field" data-role="kiri-val"><%= r.kiri_val %></span>
                            </div>
                        </td>
                        <td>
                            <div class="meta-row">
                                <span class="meta-label editable-field" data-role="kanan-label"><%= r.kanan_label %></span>
                                <span class="meta-sep">:</span>
                                <span class="meta-val editable-field" data-role="kanan-val"><%= r.kanan_val %></span>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>

        <!-- 4. PETUNJUK PENGERJAAN SOAL -->
        <div class="petunjuk-box" id="paperPetunjukSection" style="<%= formatCetak.tampilkan_petunjuk ? '' : 'display: none;' %>">
            <div class="petunjuk-title editable-field" id="paperJudulPetunjuk" data-field="judul_petunjuk"><%= formatCetak.judul_petunjuk || 'PETUNJUK:' %></div>
            <ol type="a" class="petunjuk-list" id="paperPetunjukList">
                <% (formatCetak.petunjuk_items || []).forEach(function(p, pIdx) { %>
                    <li class="editable-field" data-petunjuk-idx="<%= pIdx %>"><%= p %></li>
                <% }); %>
            </ol>
        </div>

        <!-- 5. HEADING SOAL -->
        <div class="section-heading">SOAL</div>

        <!-- 6. DAFTAR BUTIR SOAL -->
        <div class="soal-container">
            <% 
                function getJenisLabel(code) {
                    const map = {
                        'pg': 'Pilihan Ganda (PG)',
                        'pg_kompleks': 'PG Kompleks',
                        'tf': 'Benar / Salah',
                        'menjodohkan': 'Menjodohkan',
                        'short': 'Isian Singkat',
                        'isian': 'Isian Singkat',
                        'esai': 'Uraian / Esai',
                        'essay': 'Uraian / Esai'
                    };
                    return map[(code || '').toLowerCase()] || (code ? code.toUpperCase() : 'Pilihan Ganda');
                }
            %>
            <% soalList.forEach(function(s, idx) { %>
                <div class="soal-item">
                    <div class="soal-header">
                        <span class="soal-num"><%= idx + 1 %>.</span>
                        <div class="soal-text"><%- s.pertanyaan %></div>
                    </div>

                    <% if (s.gambar_soal) { %>
                        <div class="soal-image-box">
                            <img src="<%= s.gambar_soal %>" alt="Ilustrasi Soal <%= idx + 1 %>">
                        </div>
                    <% } %>

                    <% if (s.opsi && s.opsi.length > 0) { %>
                        <ul class="opsi-list">
                            <% const letters = ['a', 'b', 'c', 'd', 'e']; %>
                            <% s.opsi.forEach(function(o, oIdx) { %>
                                <li class="opsi-item">
                                    <span class="opsi-letter"><%= letters[oIdx] || oIdx + 1 %>.</span>
                                    <span class="opsi-text"><%= o.teks || o.teks_opsi || '' %></span>
                                </li>
                            <% }); %>
                        </ul>
                    <% } else { %>
                        <div style="padding-left: 28px; margin-top: 6px; color: #64748b; font-style: italic; font-size: 10pt;">
                            [ Lembar Jawaban / Uraian Mahasiswa: ................................................................................................................................................................. ]
                        </div>
                    <% } %>
                </div>
            <% }); %>
