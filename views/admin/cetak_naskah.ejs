                        </div>
                    </div>

                    <div class="form-group" style="background: #f8fafc; padding: 14px; border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 14px;">
                        <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer; color: #1e293b; margin: 0;">
                            <input type="checkbox" id="cfg_simpan_ujian" checked disabled style="margin-top: 3px; transform: scale(1.15);">
                            <div>
                                <strong>Terapkan pada Ujian Ini (<%= ujian.judul_ujian %>)</strong>
                                <div style="font-size: 0.8rem; color: #64748b;">Perubahan akan langsung terpasang pada naskah soal ujian ini, cetak PDF, unduhan Word (.docx), dan Excel (.xlsx).</div>
                            </div>
                        </label>
                    </div>

                    <div class="form-group" style="background: #f8fafc; padding: 14px; border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 14px;">
                        <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer; color: #1e293b; margin: 0;">
                            <input type="checkbox" id="cfg_jadikan_default_saya" checked style="margin-top: 3px; transform: scale(1.15);">
                            <div>
                                <strong>Simpan Sebagai Format Bawaan Profil Saya (<%= currentUser ? currentUser.nama_lengkap : 'Dosen' %>)</strong>
                                <div style="font-size: 0.8rem; color: #64748b;">Format ini akan otomatis menjadi template default untuk setiap ujian baru yang Anda kelola ke depannya.</div>
                            </div>
                        </label>
                    </div>

                    <% if (currentUser && currentUser.role === 'admin') { %>
                        <div class="form-group" style="background: #fefce8; padding: 14px; border-radius: 8px; border: 1px solid #fef08a;">
                            <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer; color: #854d0e; margin: 0;">
                                <input type="checkbox" id="cfg_jadikan_default_kampus" style="margin-top: 3px; transform: scale(1.15);">
                                <div>
                                    <strong>Jadikan Format Standar Kampus (Global Institusi)</strong>
                                    <div style="font-size: 0.8rem; color: #a16207;">Khusus Administrator: Menyimpan nama institusi, alamat, dan logo ini sebagai default seluruh sistem.</div>
                                </div>
                            </label>
                        </div>
                    <% } %>
                </div>
            </div>

            <div class="custom-modal-footer">
                <button type="button" class="btn btn-back" style="background: #ef4444;" onclick="resetToCampusDefault()">
                    <i class="fas fa-rotate-left"></i> Reset ke Bawaan Kampus
                </button>
                <div style="display: flex; gap: 10px;">
                    <button type="button" class="btn btn-back" onclick="closeFormatModal()">Batal</button>
                    <button type="button" class="btn btn-customize" id="btnSaveFormatModal" onclick="saveFormatModalData()">
                        <i class="fas fa-floppy-disk"></i> Simpan & Terapkan Perubahan
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- CLIENT SCRIPT -->
    <script>
        // State for dynamic identity rows and instruction items
        const initialFormat = <%- JSON.stringify(formatCetak) %>;
        let currentIdentitasRows = JSON.parse(JSON.stringify(initialFormat.identitas_rows || []));
        let currentPetunjukItems = JSON.parse(JSON.stringify(initialFormat.petunjuk_items || []));
        let liveEditActive = false;

        // Modal management
        function openFormatModal() {
            populateModalFields();
            document.getElementById('modalFormatCetak').style.display = 'flex';
        }

        function closeFormatModal() {
            document.getElementById('modalFormatCetak').style.display = 'none';
        }

        function switchModalTab(tabId) {
            document.querySelectorAll('.modal-tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.modal-tab-content').forEach(c => c.classList.remove('active'));
            event.currentTarget.classList.add('active');
            const target = document.getElementById(tabId);
            if (target) target.classList.add('active');
        }

        function populateModalFields() {
            renderModalMetaRows();
            renderModalPetunjukItems();
            updateLogoPreview(document.getElementById('cfg_logo_path').value);
        }

        function updateLogoPreview(val) {
            const preview = document.getElementById('cfg_logo_preview');
            const paperLogo = document.getElementById('paperLogoImg');
            const targetSrc = val || '/assets/img/logo_hamzanwadi.png';
            if (preview) preview.src = targetSrc;
            if (paperLogo) paperLogo.src = targetSrc;
        }

        function setPresetLogo(path) {
            document.getElementById('cfg_logo_path').value = path;
            updateLogoPreview(path);
            const statusEl = document.getElementById('cfg_logo_upload_status');
            if (statusEl) {
                statusEl.style.display = 'block';
                statusEl.style.color = '#15803d';
                statusEl.innerHTML = '<i class="fas fa-check-circle"></i> Menggunakan Logo Standar Universitas Hamzanwadi.';
            }
        }

        function clearLogo() {
            document.getElementById('cfg_logo_path').value = '';
            const preview = document.getElementById('cfg_logo_preview');
            if (preview) preview.src = '';
            const paperLogo = document.getElementById('paperLogoImg');
            if (paperLogo) paperLogo.src = '';
            const statusEl = document.getElementById('cfg_logo_upload_status');
            if (statusEl) {
                statusEl.style.display = 'block';
                statusEl.style.color = '#dc2626';
                statusEl.innerHTML = '<i class="fas fa-info-circle"></i> Logo dikosongkan.';
            }
        }

        async function handleLogoFileUpload(event) {
            const file = event.target.files && event.target.files[0];
            if (!file) return;

            const statusEl = document.getElementById('cfg_logo_upload_status');
            statusEl.style.display = 'block';
            statusEl.style.color = '#0284c7';
            statusEl.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sedang membaca & mengunggah logo...';

            const reader = new FileReader();
            reader.onload = async function(e) {
                const dataUrl = e.target.result;
                updateLogoPreview(dataUrl);

                try {
                    const formData = new FormData();
                    formData.append('logo_file', file);

                    const res = await fetch('/admin/api/upload_logo', {
                        method: 'POST',
                        body: formData
                    });
                    const result = await res.json();
                    if (result.success && result.url) {
                        document.getElementById('cfg_logo_path').value = result.url;
                        updateLogoPreview(result.url);
                        statusEl.style.color = '#15803d';
                        statusEl.innerHTML = '<i class="fas fa-check-circle"></i> Logo berhasil diunggah (' + file.name + ')!';
                    } else {
                        document.getElementById('cfg_logo_path').value = dataUrl;
                        statusEl.style.color = '#b45309';
                        statusEl.innerHTML = '<i class="fas fa-check-circle"></i> Logo berhasil dimuat langsung (' + file.name + ')!';
                    }
                } catch (err) {
                    console.warn('Fallback to dataUrl:', err);
                    document.getElementById('cfg_logo_path').value = dataUrl;
                    statusEl.style.color = '#b45309';
                    statusEl.innerHTML = '<i class="fas fa-check-circle"></i> Logo berhasil dimuat langsung!';
                }
            };
            reader.readAsDataURL(file);
        }

        function renderModalMetaRows() {
            const tbody = document.getElementById('modalMetaRowsBody');
            tbody.innerHTML = '';
            currentIdentitasRows.forEach((r, idx) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><input type="text" class="form-control" style="padding: 6px 8px; font-size: 0.85rem;" value="${r.kiri_label || ''}" onchange="currentIdentitasRows[${idx}].kiri_label = this.value"></td>
                    <td><input type="text" class="form-control" style="padding: 6px 8px; font-size: 0.85rem;" value="${r.kiri_val || ''}" onchange="currentIdentitasRows[${idx}].kiri_val = this.value"></td>
                    <td><input type="text" class="form-control" style="padding: 6px 8px; font-size: 0.85rem;" value="${r.kanan_label || ''}" onchange="currentIdentitasRows[${idx}].kanan_label = this.value"></td>
                    <td><input type="text" class="form-control" style="padding: 6px 8px; font-size: 0.85rem;" value="${r.kanan_val || ''}" onchange="currentIdentitasRows[${idx}].kanan_val = this.value"></td>
                    <td style="text-align: center;">
                        <button type="button" class="btn btn-sm" style="background: #fee2e2; color: #dc2626; padding: 4px 8px; border-radius: 4px;" onclick="removeModalRow(${idx})" title="Hapus baris ini">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function addModalRow(kLabel = '', kVal = '', rLabel = '', rVal = '') {
            currentIdentitasRows.push({
                kiri_label: kLabel,
                kiri_val: kVal,
                kanan_label: rLabel,
                kanan_val: rVal
            });
            renderModalMetaRows();
        }

        function addModalRowPreset(kLabel, kVal, rLabel, rVal) {
            addModalRow(kLabel, kVal, rLabel, rVal);
        }

        function removeModalRow(idx) {
            currentIdentitasRows.splice(idx, 1);
            renderModalMetaRows();
        }

        function renderModalPetunjukItems() {
            const container = document.getElementById('modalPetunjukListContainer');
            container.innerHTML = '';
            const letters = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'];
            currentPetunjukItems.forEach((p, idx) => {
                const row = document.createElement('div');
                row.style.display = 'flex';
                row.style.gap = '8px';
                row.style.alignItems = 'center';
                row.innerHTML = `
                    <span style="font-weight: 700; width: 22px; text-align: center; color: #64748b;">${letters[idx] || idx + 1}.</span>
                    <input type="text" class="form-control" style="flex: 1; padding: 7px 10px;" value="${p}" onchange="currentPetunjukItems[${idx}] = this.value">
                    <button type="button" class="btn btn-sm" style="background: #fee2e2; color: #dc2626; padding: 6px 10px; border-radius: 4px;" onclick="removeModalPetunjukItem(${idx})">
                        <i class="fas fa-trash"></i>
                    </button>
                `;
                container.appendChild(row);
            });
        }

        function addModalPetunjukItem(text = '') {
            currentPetunjukItems.push(text || 'Isi petunjuk pengerjaan baru di sini...');
            renderModalPetunjukItems();
        }

        function removeModalPetunjukItem(idx) {
            currentPetunjukItems.splice(idx, 1);
            renderModalPetunjukItems();
        }

        function setPresetPetunjuk(type) {
            if (type === 'take_home') {
                currentPetunjukItems = [
                    "Berdo'a sebelum mengerjakan soal !",
                    "Isi identitas Anda terlebih dahulu !",
                    "Soal Ujian ini dikerjakan di rumah (Take Home).",
                    "Kumpulkan naskah jawaban tepat waktu sesuai jadwal yang ditentukan."
                ];
            } else if (type === 'tatap_muka') {
                currentPetunjukItems = [
                    "Berdo'a sebelum mengerjakan ujian.",
                    "Tuliskan identitas nama, NIM, dan kelas pada lembar jawaban.",
                    "Dilarang bekerjasama atau menggunakan alat komunikasi selama ujian berlangsung.",
                    "Periksa kembali lembar jawaban Anda sebelum diserahkan kepada pengawas."
                ];
            } else if (type === 'praktikum') {
                currentPetunjukItems = [
                    "Periksa koneksi perangkat komputer dan environment aplikasi sebelum mulai.",
                    "Simpan project/source code dengan format NIM_Nama_Ujian.",
                    "Unggah hasil pekerjaan ke server laboratorium sebelum waktu habis."
                ];
            }
            renderModalPetunjukItems();
        }

        // Save Format from Modal
        async function saveFormatModalData() {
            const btn = document.getElementById('btnSaveFormatModal');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Menyimpan...';

            const payload = {
                ujian_id: '<%= ujian.id %>',
                format_cetak: {
                    tampilkan_kop: document.getElementById('cfg_tampilkan_kop').checked,
                    tampilkan_logo: document.getElementById('cfg_tampilkan_logo').checked,
                    logo_path: document.getElementById('cfg_logo_path').value,
                    nama_institusi: document.getElementById('cfg_nama_institusi').value,
                    sub_institusi: document.getElementById('cfg_sub_institusi').value,
                    alamat_institusi: document.getElementById('cfg_alamat_institusi').value,
                    kontak_institusi: document.getElementById('cfg_kontak_institusi').value,
                    tampilkan_garis: document.getElementById('cfg_tampilkan_garis').checked,
                    judul_utama: document.getElementById('cfg_judul_utama').value,
                    sub_judul: document.getElementById('cfg_sub_judul').value,
                    identitas_rows: currentIdentitasRows,
                    nama_pejabat_kanan: document.getElementById('cfg_nama_dosen') ? document.getElementById('cfg_nama_dosen').value : '',
                    nip_kanan: document.getElementById('cfg_nip_dosen') ? document.getElementById('cfg_nip_dosen').value : '',
                    nama_pejabat_kiri: document.getElementById('cfg_nama_kaprodi') ? document.getElementById('cfg_nama_kaprodi').value : '',
                    nip_kiri: document.getElementById('cfg_nip_kaprodi') ? document.getElementById('cfg_nip_kaprodi').value : '',
                    tampilkan_pengawas: document.getElementById('cfg_tampilkan_pengawas') ? document.getElementById('cfg_tampilkan_pengawas').checked : false,
                    nama_pengawas: document.getElementById('cfg_nama_pengawas') ? document.getElementById('cfg_nama_pengawas').value : '',
                    nip_pengawas: document.getElementById('cfg_nip_pengawas') ? document.getElementById('cfg_nip_pengawas').value : '',
                    tampilkan_petunjuk: document.getElementById('cfg_tampilkan_petunjuk').checked,
                    judul_petunjuk: document.getElementById('cfg_judul_petunjuk').value,
                    petunjuk_items: currentPetunjukItems
                },
                jadikan_default_saya: document.getElementById('cfg_jadikan_default_saya').checked,
                jadikan_default_kampus: document.getElementById('cfg_jadikan_default_kampus') ? document.getElementById('cfg_jadikan_default_kampus').checked : false
            };

            try {
                const res = await fetch('/admin/api/simpan_format_cetak', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                if (result.success) {
                    alert('Format korps dan identitas naskah berhasil disimpan!');
                    window.location.reload();
                } else {
                    throw new Error(result.message || 'Gagal menyimpan format');
                }
            } catch (err) {
                alert('Terjadi kesalahan: ' + err.message);
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-floppy-disk"></i> Simpan & Terapkan Perubahan';
            }
        }

        async function resetToCampusDefault() {
            if (!confirm('Apakah Anda yakin ingin mereset seluruh format naskah ujian ini kembali ke format standar kampus?')) return;
            try {
                const res = await fetch('/admin/api/reset_format_cetak', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ujian_id: '<%= ujian.id %>' })
                });
                const result = await res.json();
                if (result.success) {
                    alert('Format berhasil dikembalikan ke standar kampus!');
                    window.location.reload();
                }
            } catch (err) {
                alert('Gagal mereset format: ' + err.message);
            }
        }

        // Live Inline Edit Mode on Paper
        function toggleLiveEdit() {
            liveEditActive = !liveEditActive;
            const btn = document.getElementById('btnToggleLiveEdit');
            const floatingBar = document.getElementById('liveEditFloatingBar');

            if (liveEditActive) {
                document.body.classList.add('live-editing');
                btn.classList.add('active');
                btn.innerHTML = '<i class="fas fa-check"></i> Selesai Edit';
                floatingBar.classList.add('active');
                document.querySelectorAll('.editable-field').forEach(el => {
                    el.contentEditable = "true";
                });
            } else {
                document.body.classList.remove('live-editing');
                btn.classList.remove('active');
                btn.innerHTML = '<i class="fas fa-pencil"></i> Edit Cepat di Kertas';
                floatingBar.classList.remove('active');
                document.querySelectorAll('.editable-field').forEach(el => {
                    el.contentEditable = "false";
                });
            }
        }

        function addRowDirect() {
            const tableBody = document.getElementById('paperMetaBody');
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>
                    <div class="meta-row">
                        <span class="meta-label editable-field" contenteditable="true" data-role="kiri-label">Label Baru</span>
                        <span class="meta-sep">:</span>
                        <span class="meta-val editable-field" contenteditable="true" data-role="kiri-val">Nilai Baru</span>
                    </div>
                </td>
                <td>
                    <div class="meta-row">
                        <span class="meta-label editable-field" contenteditable="true" data-role="kanan-label">Label Baru</span>
                        <span class="meta-sep">:</span>
                        <span class="meta-val editable-field" contenteditable="true" data-role="kanan-val">Nilai Baru</span>
                    </div>
                </td>
            `;
            tableBody.appendChild(tr);
        }

        function addPetunjukDirect() {
            const list = document.getElementById('paperPetunjukList');
            const li = document.createElement('li');
            li.className = 'editable-field';
            li.contentEditable = "true";
            li.innerText = 'Tulis butir petunjuk pengerjaan baru di sini...';
            list.appendChild(li);
        }

        async function saveDirectChanges() {
            // Read values directly from DOM
            const namaInstitusi = document.getElementById('paperNamaInstitusi') ? document.getElementById('paperNamaInstitusi').innerText.trim() : '';
            const subInstitusi = document.getElementById('paperSubInstitusi') ? document.getElementById('paperSubInstitusi').innerText.trim() : '';
            const alamatInstitusi = document.getElementById('paperAlamatInstitusi') ? document.getElementById('paperAlamatInstitusi').innerText.trim() : '';
            const kontakInstitusi = document.getElementById('paperKontakInstitusi') ? document.getElementById('paperKontakInstitusi').innerText.trim() : '';
            const judulUtama = document.getElementById('paperJudulUtama') ? document.getElementById('paperJudulUtama').innerText.trim() : '';
            const subJudul = document.getElementById('paperSubJudul') ? document.getElementById('paperSubJudul').innerText.trim() : '';
            const judulPetunjuk = document.getElementById('paperJudulPetunjuk') ? document.getElementById('paperJudulPetunjuk').innerText.trim() : 'PETUNJUK:';

            const extractedRows = [];
            document.querySelectorAll('#paperMetaBody tr').forEach(tr => {
                const kLabel = tr.querySelector('[data-role="kiri-label"]');
                const kVal = tr.querySelector('[data-role="kiri-val"]');
                const rLabel = tr.querySelector('[data-role="kanan-label"]');
                const rVal = tr.querySelector('[data-role="kanan-val"]');
                if (kLabel || rLabel) {
                    extractedRows.push({
                        kiri_label: kLabel ? kLabel.innerText.trim() : '',
                        kiri_val: kVal ? kVal.innerText.trim() : '',
                        kanan_label: rLabel ? rLabel.innerText.trim() : '',
                        kanan_val: rVal ? rVal.innerText.trim() : ''
                    });
                }
            });

            const extractedPetunjuk = [];
            document.querySelectorAll('#paperPetunjukList li').forEach(li => {
                const text = li.innerText.trim();
                if (text) extractedPetunjuk.push(text);
            });

            const payload = {
                ujian_id: '<%= ujian.id %>',
                format_cetak: {
                    tampilkan_kop: initialFormat.tampilkan_kop !== false,
                    tampilkan_logo: initialFormat.tampilkan_logo !== false,
                    logo_path: initialFormat.logo_path || '/assets/img/logo_hamzanwadi.png',
                    nama_institusi: namaInstitusi,
                    sub_institusi: subInstitusi,
                    alamat_institusi: alamatInstitusi,
                    kontak_institusi: kontakInstitusi,
                    tampilkan_garis: initialFormat.tampilkan_garis !== false,
                    judul_utama: judulUtama,
                    sub_judul: subJudul,
                    identitas_rows: extractedRows.length > 0 ? extractedRows : currentIdentitasRows,
                    tampilkan_petunjuk: true,
                    judul_petunjuk: judulPetunjuk,
                    petunjuk_items: extractedPetunjuk.length > 0 ? extractedPetunjuk : currentPetunjukItems
                },
                jadikan_default_saya: true
            };

            try {
                const res = await fetch('/admin/api/simpan_format_cetak', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                if (result.success) {
                    alert('Perubahan berhasil disimpan permanen ke naskah ujian ini dan template profil Anda!');
                    toggleLiveEdit();
                } else {
                    throw new Error(result.message);
                }
            } catch (err) {
                alert('Gagal menyimpan perubahan: ' + err.message);
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('open_format') === 'true') {
                openFormatModal();
            }
        });

        window.addEventListener('click', function(e) {
            if (e.target.classList.contains('custom-modal-overlay')) {
                closeFormatModal();
            }
        });

        window.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeFormatModal();
            }
        });
    </script>
</body>
</html>
