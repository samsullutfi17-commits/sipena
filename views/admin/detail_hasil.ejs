<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Jawaban Peserta - SIPENA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="stylesheet" href="/assets/css/admin.css">
    <script src="/assets/js/admin-sidebar.js" defer></script>
</head>
<body>
    <header class="header">
        <div class="container header-flex" style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h1>SIPENA – Detail Penilaian Peserta</h1>
                <p class="subtitle"><%= adminNama %></p>
            </div>
        </div>
    </header>

    <div class="admin-container">
        <%- include('../partials/admin_sidebar', { currentPath: '/admin/detail_hasil', adminRole: adminRole }) %>

        <main class="admin-main">
            <nav class="breadcrumb">
                <a href="/admin/dashboard">Beranda</a> &raquo;
                <a href="/admin/hasil">Laporan Hasil</a> &raquo;
                <span>Detail Jawaban</span>
            </nav>

            <div class="card" style="margin-bottom: 20px;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <h3 style="margin-bottom: 4px;"><%= mahasiswa.nama_lengkap %> (<%= mahasiswa.nim %>)</h3>
                        <p style="color: var(--text-muted); margin: 0;"><%= ujian.judul_ujian %> &bull; <%= ujian.nama_mk %></p>
                    </div>
                    <div style="text-align: right;">
                        <span style="font-size: 2rem; font-weight: 800; color: <%= sesi.nilai_total >= (ujian.nilai_lulus || 60) ? '#16a34a' : '#dc2626' %>;">
                            <%= sesi.nilai_total %>
                        </span>
                        <div style="font-size: 0.85rem; color: var(--text-muted);">Total Nilai Akhir</div>
                    </div>
                </div>
            </div>

            <h3 style="margin-bottom: 16px;">Analisis Butir Jawaban</h3>

            <% soalList.forEach(function(s, idx) { 
                const j = jawabanList.find(item => item.id_soal === s.id);
                const isCorrect = j ? j.is_correct : false;
                const nilai = j ? j.nilai : 0;
            %>
                <div class="card" style="margin-bottom: 16px; border-left: 4px solid <%= isCorrect ? '#16a34a' : '#dc2626' %>;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <strong>Soal <%= idx + 1 %> (<%= s.jenis_soal.toUpperCase() %>)</strong>
                        <span class="badge <%= isCorrect ? 'badge-success' : 'badge-danger' %>">
                            Nilai: <%= nilai %> / <%= s.poin || 4 %> Poin
                        </span>
                    </div>

                    <div style="margin-bottom: 10px; color: var(--text-dark); white-space: pre-line;">
                        <%- s.pertanyaan %>
                    </div>

                    <% if (['menjodohkan', 'matching'].includes((s.jenis_soal || '').toLowerCase())) { 
                        const correctPairs = (s.data_tambahan && s.data_tambahan.pairs) || s.matching_pairs || {};
                        let studentMatches = {};
                        try {
                            studentMatches = j && j.jawaban ? (typeof j.jawaban === 'object' ? j.jawaban : JSON.parse(j.jawaban)) : {};
                        } catch(e) {
                            studentMatches = {};
                        }
                    %>
                        <div style="padding: 12px 14px; background: #faf5ff; border: 1px solid #e9d5ff; border-radius: 8px; font-size: 0.9rem; margin-bottom: 8px;">
                            <strong style="color: #7e22ce; display: block; margin-bottom: 8px;"><i class="fas fa-link"></i> Evaluasi Pasangan Menjodohkan:</strong>
                            <div style="display: flex; flex-direction: column; gap: 6px;">
                                <% Object.entries(correctPairs).forEach(function([k, correctV], pIdx) { 
                                    const userV = studentMatches[k] || '(Tidak dijawab)';
                                    const isPairCorrect = studentMatches[k] && studentMatches[k].trim() === correctV.trim();
                                %>
                                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 6px 10px; background: <%= isPairCorrect ? '#f0fdf4' : '#fef2f2' %>; border: 1px solid <%= isPairCorrect ? '#bbf7d0' : '#fecaca' %>; border-radius: 6px;">
                                        <div><strong><%= pIdx + 1 %>. <%= k %></strong> &rarr; <%= userV %></div>
                                        <div><span class="badge <%= isPairCorrect ? 'badge-success' : 'badge-danger' %>"><%= isPairCorrect ? 'Cocok ✔' : 'Kunci: ' + correctV %></span></div>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    <% } else { %>
                        <div style="padding: 10px 14px; background: #f8fafc; border-radius: 6px; font-size: 0.9rem; margin-bottom: 8px;">
                            <strong>Jawaban Peserta:</strong> <code><%= j ? j.jawaban : '(Tidak dijawab)' %></code>
                        </div>
                    <% } %>

                    <% if (s.pembahasan) { %>
                        <div style="font-size: 0.85rem; color: #475569;">
                            <strong>Pembahasan:</strong> <%= s.pembahasan %>
                        </div>
                    <% } %>
                </div>
            <% }); %>

            <div style="margin-top: 20px;">
                <a href="/admin/hasil" class="btn btn-secondary">&larr; Kembali ke Daftar Hasil</a>
            </div>
        </main>
    </div>
</body>
</html>
