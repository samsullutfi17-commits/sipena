<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Program Studi - SIPENA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="stylesheet" href="/assets/css/admin.css">
    <script src="/assets/js/admin-sidebar.js" defer></script>
</head>
<body>
    <header class="header">
        <div class="container header-flex" style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h1>SIPENA – Program Studi</h1>
                <p class="subtitle"><%= adminNama %></p>
            </div>
        </div>
    </header>

    <div class="admin-container">
        <%- include('../partials/admin_sidebar', { currentPath: '/admin/prodi', adminRole: adminRole }) %>

        <main class="admin-main">
            <nav class="breadcrumb" style="margin-bottom: 14px;">
                <a href="/admin/dashboard">Beranda</a> &raquo;
                <span>Program Studi</span>
            </nav>

            <div class="page-header-row">
                <div>
                    <h2 class="page-title">
                        <i class="fas fa-graduation-cap"></i> Data Program Studi
                    </h2>
                    <p class="page-subtitle">
                        Kelola data jurusan/program studi serta fakultas naungan.
                    </p>
                </div>
                <button type="button" class="btn-primary-action" onclick="document.getElementById('modal-prodi').style.display='flex'">
                    <i class="fas fa-plus"></i> Tambah Program Studi
                </button>
            </div>

            <% if (message) { %>
                <div class="alert alert-success" style="margin-bottom: 20px;">
                    <i class="fas fa-check-circle" style="margin-right: 6px;"></i> <%= message %>
                </div>
            <% } %>

            <div class="modern-table-card">
                <div style="overflow-x: auto;">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th style="width: 50px; text-align: center;">No</th>
                                <th style="width: 110px;">Kode</th>
                                <th>Nama Program Studi</th>
                                <th>Fakultas</th>
                                <th>Ketua Program Studi & NIDN</th>
                                <th style="width: 140px; text-align: center;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (prodiList.length === 0) { %>
                                <tr>
                                    <td colspan="6" style="text-align: center; padding: 42px; color: #64748b;">
                                        Belum ada data program studi. Klik tombol <strong>+ Tambah Program Studi</strong> untuk menambahkan.
                                    </td>
                                </tr>
                            <% } else { %>
                                <% prodiList.forEach(function(p, idx) { %>
                                    <tr>
                                        <td style="text-align: center; color: #64748b; font-weight: 600;"><%= idx + 1 %></td>
                                        <td><span class="kode-badge"><%= p.kode_prodi %></span></td>
                                        <td><strong style="color: #0f172a; font-size: 0.94rem;"><%= p.nama_prodi %></strong></td>
                                        <td><span class="pill-badge"><%= p.nama_fakultas %></span></td>
                                        <td>
                                            <div style="font-weight: 600; color: #1e293b; font-size: 0.9rem;">
                                                <i class="fas fa-user-tie" style="color: #1b4d3e; margin-right: 4px;"></i> <%= p.nama_kaprodi || (typeof settings !== 'undefined' && settings.nama_kaprodi) || 'Dr. H. M. Zain, M.Pd.' %>
                                            </div>
                                            <div style="font-size: 0.78rem; color: #64748b; margin-top: 2px;">
                                                NIDN: <%= p.nidn_kaprodi || (typeof settings !== 'undefined' && settings.nidn_kaprodi) || '0812048501' %>
                                            </div>
                                        </td>
                                        <td style="text-align: center;">
                                            <div style="display: flex; gap: 6px; justify-content: center; align-items: center;">
                                                <button type="button" class="btn-action-edit" title="Edit Program Studi" onclick="openModalEditProdi(<%= JSON.stringify(p) %>)">
                                                    <i class="fas fa-pen-to-square"></i> Edit
                                                </button>
                                                <button type="submit" class="btn-action-delete" title="Hapus Prodi" onclick="openConfirmDeleteProdi(<%= p.id %>, '<%= (p.nama_prodi || '').replace(/'/g, '\\\'') %>')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- MODAL TAMBAH PRODI -->
    <div id="modal-prodi" class="modal-overlay" style="display: none; position: fixed; inset: 0; width: 100vw; height: 100vh; background: rgba(15,23,42,0.6); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box;">
        <div class="card" style="max-width: 480px; width: 100%; border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.25); border: 1px solid #e2e8f0; padding: 24px; box-sizing: border-box; background: #ffffff;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                <h3 style="margin: 0; font-size: 1.25rem; font-weight: 700; color: #1b4d3e; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-graduation-cap"></i> Tambah Program Studi
                </h3>
                <button type="button" style="background: none; border: none; font-size: 1.4rem; color: #94a3b8; cursor: pointer;" onclick="document.getElementById('modal-prodi').style.display='none'">&times;</button>
            </div>
            <form method="POST" action="/admin/prodi">
                <input type="hidden" name="action" value="create">
                <div class="form-group" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Fakultas Naungan</label>
                    <select name="id_fakultas" class="form-select" required style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                        <option value="">-- Pilih Fakultas --</option>
                        <% fakultasList.forEach(function(f) { %>
                            <option value="<%= f.id %>"><%= f.nama_fakultas %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Kode Prodi</label>
                    <input type="text" name="kode_prodi" required class="form-control" placeholder="Contoh: TI / SI" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                </div>
                <div class="form-group" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Nama Program Studi</label>
                    <input type="text" name="nama_prodi" required class="form-control" placeholder="Contoh: S1 Teknik Informatika" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                </div>
                <div class="form-group" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Nama Ketua Program Studi (Kaprodi)</label>
                    <input type="text" name="nama_kaprodi" class="form-control" placeholder="Contoh: <%= (typeof settings !== 'undefined' && settings.nama_kaprodi) || 'Dr. H. M. Zain, M.Pd.' %>" value="<%= (typeof settings !== 'undefined' && settings.nama_kaprodi) || 'Dr. H. M. Zain, M.Pd.' %>" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                </div>
                <div class="form-group" style="margin-bottom: 18px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">NIDN / NIP Kaprodi</label>
                    <input type="text" name="nidn_kaprodi" class="form-control" placeholder="Contoh: <%= (typeof settings !== 'undefined' && settings.nidn_kaprodi) || '0812048501' %>" value="<%= (typeof settings !== 'undefined' && settings.nidn_kaprodi) || '0812048501' %>" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                </div>
                <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; border-top: 1px solid #f1f5f9; padding-top: 14px;">
                    <button type="button" class="btn btn-secondary" onclick="document.getElementById('modal-prodi').style.display='none'" style="padding: 9px 18px; border-radius: 8px;">Batal</button>
                    <button type="submit" class="btn btn-primary" style="background: #1b4d3e; border: none; padding: 9px 20px; border-radius: 8px; font-weight: 600;">Simpan</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL EDIT PRODI -->
    <div id="modal-edit-prodi" class="modal-overlay" style="display: none; position: fixed; inset: 0; width: 100vw; height: 100vh; background: rgba(15,23,42,0.6); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box;">
        <div class="card" style="max-width: 480px; width: 100%; border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.25); border: 1px solid #e2e8f0; padding: 24px; box-sizing: border-box; background: #ffffff;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                <h3 style="margin: 0; font-size: 1.25rem; font-weight: 700; color: #1b4d3e; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-pen-to-square"></i> Edit Program Studi
                </h3>
                <button type="button" style="background: none; border: none; font-size: 1.4rem; color: #94a3b8; cursor: pointer;" onclick="document.getElementById('modal-edit-prodi').style.display='none'">&times;</button>
            </div>
            <form method="POST" action="/admin/prodi">
                <input type="hidden" name="action" value="edit">
                <input type="hidden" name="id" id="edit_prodi_id">

                <div class="form-group" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Fakultas Naungan</label>
                    <select name="id_fakultas" id="edit_id_fakultas" class="form-select" required style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                        <option value="">-- Pilih Fakultas --</option>
                        <% fakultasList.forEach(function(f) { %>
                            <option value="<%= f.id %>"><%= f.nama_fakultas %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Kode Prodi</label>
                    <input type="text" name="kode_prodi" id="edit_kode_prodi" required class="form-control" placeholder="Contoh: TI / SI" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                </div>
                <div class="form-group" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Nama Program Studi</label>
                    <input type="text" name="nama_prodi" id="edit_nama_prodi" required class="form-control" placeholder="Contoh: S1 Teknik Informatika" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                </div>
                <div class="form-group" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Nama Ketua Program Studi (Kaprodi)</label>
                    <input type="text" name="nama_kaprodi" id="edit_nama_kaprodi" class="form-control" placeholder="Contoh: <%= (typeof settings !== 'undefined' && settings.nama_kaprodi) || 'Dr. H. M. Zain, M.Pd.' %>" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                </div>
                <div class="form-group" style="margin-bottom: 18px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">NIDN / NIP Kaprodi</label>
                    <input type="text" name="nidn_kaprodi" id="edit_nidn_kaprodi" class="form-control" placeholder="Contoh: <%= (typeof settings !== 'undefined' && settings.nidn_kaprodi) || '0812048501' %>" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                </div>
                <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; border-top: 1px solid #f1f5f9; padding-top: 14px;">
                    <button type="button" class="btn btn-secondary" onclick="document.getElementById('modal-edit-prodi').style.display='none'" style="padding: 9px 18px; border-radius: 8px;">Batal</button>
                    <button type="submit" class="btn btn-primary" style="background: #1b4d3e; border: none; padding: 9px 20px; border-radius: 8px; font-weight: 600;">Simpan Perubahan</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL DELETE PRODI -->
    <div id="modal-delete-prodi" class="modal-overlay" style="display: none; position: fixed; inset: 0; width: 100vw; height: 100vh; background: rgba(15,23,42,0.6); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box;">
        <div class="card" style="max-width: 440px; width: 100%; border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.25); border: 1px solid #e2e8f0; padding: 24px; box-sizing: border-box; background: #ffffff;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                <h3 style="margin: 0; font-size: 1.25rem; font-weight: 700; color: #dc2626; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-trash"></i> Hapus Program Studi
                </h3>
                <button type="button" style="background: none; border: none; font-size: 1.4rem; color: #94a3b8; cursor: pointer;" onclick="closeConfirmDeleteProdi()">&times;</button>
            </div>
            <p style="color: #334155; margin: 0 0 16px; font-size: 0.95rem; line-height: 1.5;">
                Apakah Anda yakin ingin menghapus program studi <strong id="deleteProdiName"></strong>?
            </p>
            <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 12px 14px; color: #991b1b; font-size: 0.85rem; margin-bottom: 20px;">
                <i class="fas fa-triangle-exclamation" style="margin-right: 6px;"></i> Tindakan ini tidak dapat dibatalkan.
            </div>
            <form method="POST" action="/admin/prodi">
                <input type="hidden" name="action" value="delete">
                <input type="hidden" name="id" id="deleteProdiId">
                <div style="display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid #f1f5f9; padding-top: 14px;">
                    <button type="button" class="btn btn-secondary" onclick="closeConfirmDeleteProdi()" style="padding: 9px 18px; border-radius: 8px;">Batal</button>
                    <button type="submit" class="btn btn-primary" style="background: #dc2626; border: none; padding: 9px 20px; border-radius: 8px; font-weight: 600;"><i class="fas fa-trash"></i> Ya, Hapus</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openConfirmDeleteProdi(id, nama) {
            document.getElementById('deleteProdiId').value = id;
            document.getElementById('deleteProdiName').innerText = nama;
            document.getElementById('modal-delete-prodi').style.display = 'flex';
        }

        function closeConfirmDeleteProdi() {
            document.getElementById('modal-delete-prodi').style.display = 'none';
        }

        const defaultKaprodiName = <%- JSON.stringify((typeof settings !== 'undefined' && settings.nama_kaprodi) || 'Dr. H. M. Zain, M.Pd.') %>;
        const defaultKaprodiNidn = <%- JSON.stringify((typeof settings !== 'undefined' && settings.nidn_kaprodi) || '0812048501') %>;

        function openModalEditProdi(p) {
            document.getElementById('edit_prodi_id').value = p.id;
            document.getElementById('edit_id_fakultas').value = p.id_fakultas || '';
            document.getElementById('edit_kode_prodi').value = p.kode_prodi || '';
            document.getElementById('edit_nama_prodi').value = p.nama_prodi || '';
            document.getElementById('edit_nama_kaprodi').value = p.nama_kaprodi || defaultKaprodiName;
            document.getElementById('edit_nidn_kaprodi').value = p.nidn_kaprodi || defaultKaprodiNidn;
            document.getElementById('modal-edit-prodi').style.display = 'flex';
        }

        window.addEventListener('click', function(e) {
            if (e.target === document.getElementById('modal-prodi')) {
                document.getElementById('modal-prodi').style.display = 'none';
            }
            if (e.target === document.getElementById('modal-edit-prodi')) {
                document.getElementById('modal-edit-prodi').style.display = 'none';
            }
        });

        window.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.getElementById('modal-prodi').style.display = 'none';
                document.getElementById('modal-edit-prodi').style.display = 'none';
            }
        });
    </script>
</body>
</html>
