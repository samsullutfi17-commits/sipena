<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bank Soal - <%= currentUjian ? currentUjian.judul_ujian : 'Ujian' %> - SIPENA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="stylesheet" href="/assets/css/admin.css">
    <script src="/assets/js/admin-sidebar.js" defer></script>
    <style>
        .custom-modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(4px);
            z-index: 9999;
            align-items: center;
            justify-content: center;
            padding: 20px;
            box-sizing: border-box;
        }

        .custom-modal-card {
            background: #ffffff;
            border-radius: 14px;
            max-width: 680px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            border: 1px solid #e2e8f0;
            animation: modalScaleIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes modalScaleIn {
            from { opacity: 0; transform: scale(0.95) translateY(6px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        .custom-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 24px 16px;
            border-bottom: 1px solid #f1f5f9;
        }

        .custom-modal-header h3 {
            margin: 0;
            font-size: 1.25rem;
            font-weight: 700;
            color: #1b4d3e;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .close-modal-btn {
            background: none;
            border: none;
            font-size: 1.5rem;
            color: #94a3b8;
            cursor: pointer;
            line-height: 1;
            padding: 4px;
            border-radius: 6px;
            transition: all 0.15s ease;
        }

        .close-modal-btn:hover {
            color: #0f172a;
            background: #f1f5f9;
        }

        .custom-modal-body {
            padding: 20px 24px;
        }

        .dropdown-cetak {
            position: relative;
            display: inline-block;
        }

        .btn-cetak-soal {
            background: #ffffff;
            color: #1e293b;
            border: 1.5px solid #cbd5e1;
            padding: 10px 18px;
            border-radius: 8px;
            font-size: 0.92rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        }

        .btn-cetak-soal:hover {
            background: #f8fafc;
            border-color: #94a3b8;
            color: #0f172a;
        }

        /* Searchable Custom Select for Jenis Penilaian */
        .searchable-select-wrap {
            position: relative;
            display: inline-block;
            min-width: 270px;
        }

        .searchable-trigger {
            background: #ffffff;
            border: 1.5px solid #cbd5e1;
            border-radius: 8px;
            padding: 9px 14px;
            font-size: 0.9rem;
            font-weight: 600;
            color: #1e293b;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 1px 2px rgba(0,0,0,0.04);
            user-select: none;
        }

        .searchable-trigger:hover, .searchable-trigger.active {
            border-color: #1b4d3e;
            box-shadow: 0 0 0 3px rgba(27, 77, 62, 0.12);
        }

        .searchable-dropdown {
            display: none;
            position: absolute;
            top: calc(100% + 6px);
            left: 0;
            min-width: 320px;
            background: #ffffff;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            box-shadow: 0 12px 28px -4px rgba(0,0,0,0.18), 0 4px 8px -2px rgba(0,0,0,0.08);
            z-index: 1050;
            overflow: hidden;
            animation: fadeInMenu 0.15s ease-out;
        }

        .searchable-dropdown.show {
            display: block;
        }

        .searchable-search-box {
            padding: 10px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            position: relative;
        }

        .searchable-search-input {
            width: 100%;
            padding: 8px 12px 8px 32px;
            font-size: 0.86rem;
            border: 1.5px solid #cbd5e1;
            border-radius: 6px;
            outline: none;
            background: #ffffff;
            transition: border-color 0.15s;
        }

        .searchable-search-input:focus {
            border-color: #1b4d3e;
        }

        .searchable-search-icon {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 0.8rem;
            color: #94a3b8;
        }

        .searchable-options-list {
            max-height: 240px;
            overflow-y: auto;
            margin: 0;
            padding: 6px 0;
            list-style: none;
        }

        .searchable-option-item {
            padding: 9px 14px;
            font-size: 0.88rem;
            color: #334155;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            transition: background 0.12s;
        }

        .searchable-option-item:hover {
            background: #f1f5f9;
            color: #0f172a;
        }

        .searchable-option-item.selected {
            background: #f0fdf4;
            color: #166534;
            font-weight: 600;
        }

        .searchable-empty-hint {
            padding: 14px;
            text-align: center;
            font-size: 0.82rem;
            color: #94a3b8;
            display: none;
        }

        .dropdown-menu-cetak {
            display: none;
            position: absolute;
            right: 0;
            top: calc(100% + 6px);
            background: #ffffff;
            min-width: 280px;
            border-radius: 10px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            border: 1px solid #e2e8f0;
            z-index: 100;
            overflow: hidden;
            animation: fadeInMenu 0.15s ease-out;
        }

        .dropdown-menu-cetak.show {
            display: block;
        }

        @keyframes fadeInMenu {
            from { opacity: 0; transform: translateY(-6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .dropdown-item-cetak {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            color: #334155;
            text-decoration: none;
            font-size: 0.88rem;
            transition: background 0.15s ease;
            border-bottom: 1px solid #f1f5f9;
        }

        .dropdown-item-cetak:last-child {
            border-bottom: none;
        }

        .dropdown-item-cetak:hover {
            background: #f8fafc;
            color: #0f172a;
        }

        .quick-chip {
            padding: 3px 9px;
            font-size: 0.76rem;
            font-weight: 600;
            border-radius: 6px;
            border: 1px solid #cbd5e1;
            background: #ffffff;
            color: #475569;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .quick-chip:hover {
            background: #f1f5f9;
            color: #0f172a;
            border-color: #94a3b8;
        }
    </style>
</head>
<body>
    <header class="header">
        <div class="container header-flex" style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h1>SIPENA – Bank Soal</h1>
                <p class="subtitle"><%= adminNama %> &bull; <%= currentUjian ? currentUjian.judul_ujian : '' %></p>
            </div>
        </div>
    </header>

    <div class="admin-container">
        <%- include('../partials/admin_sidebar', { currentPath: '/admin/soal', adminRole: adminRole }) %>

        <main class="admin-main">
            <nav class="breadcrumb" style="margin-bottom: 12px;">
                <a href="/admin/dashboard">Beranda</a> &raquo;
                <a href="/admin/ujian">Penilaian</a> &raquo;
                <span>Bank Soal</span>
            </nav>

            <!-- TAB NAVIGASI ELEGAN: PENILAIAN, BANK SOAL, KISI-KISI -->
            <div class="nav-tabs-wrapper">
                <a href="/admin/ujian" class="nav-tab-pill">
                    <i class="fas fa-file-lines"></i>
                    <span>Daftar Penilaian</span>
                </a>
                <a href="/admin/soal?ujian_id=<%= selectedUjianId %>" class="nav-tab-pill active">
                    <i class="fas fa-question-circle"></i>
                    <span>Bank Soal</span>
                </a>
                <a href="/admin/kisi_kisi?ujian_id=<%= selectedUjianId %>" class="nav-tab-pill">
                    <i class="fas fa-table-cells"></i>
                    <span>Matriks Kisi-Kisi</span>
                </a>
            </div>

            <div class="page-header-row">
                <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
                    <div>
                        <h2 class="page-title"><i class="fas fa-question-circle"></i> Bank Soal</h2>
                        <p class="page-subtitle">Kelola butir soal evaluasi, kunci jawaban, bobot poin, dan indikator kisi-kisi.</p>
                    </div>

                    <!-- Pilihan Judul Penilaian Rapi dengan Pencarian -->
                    <div class="searchable-select-wrap" id="wrapPilihPenilaianSoal">
                        <% 
                            const activeUjian = ujianList.find(u => u.id === selectedUjianId);
                            const activeTitle = activeUjian ? activeUjian.judul_ujian : 'Pilih Judul Penilaian...';
                            const activeMk = activeUjian && activeUjian.nama_mk && activeUjian.nama_mk !== '-' ? activeUjian.nama_mk : '';
                        %>
                        <div class="searchable-trigger" id="triggerPilihPenilaianSoal" onclick="toggleSearchablePenilaianSoal(event)" title="Pilih Judul Penilaian">
                            <div style="display: flex; align-items: center; gap: 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                <i class="fas fa-file-signature" style="color: #1b4d3e; font-size: 0.95rem;"></i>
                                <span id="labelPilihPenilaianSoal" style="overflow: hidden; text-overflow: ellipsis;">
                                    <strong><%= activeTitle %></strong>
                                    <% if (activeMk) { %>
                                        <span style="color: #64748b; font-weight: normal; font-size: 0.82rem; margin-left: 4px;">(<%= activeMk %>)</span>
                                    <% } %>
                                </span>
                            </div>
                            <i class="fas fa-chevron-down" style="font-size: 0.8rem; color: #64748b; transition: transform 0.2s;" id="chevronPenilaianSoal"></i>
                        </div>
                        <div class="searchable-dropdown" id="dropdownPilihPenilaianSoal">
                            <div class="searchable-search-box">
                                <i class="fas fa-search searchable-search-icon"></i>
                                <input type="text" class="searchable-search-input" id="searchPenilaianSoalInput" placeholder="Cari nama / judul penilaian atau mata kuliah..." oninput="filterOptionsPenilaianSoal(this.value)" autocomplete="off">
                            </div>
                            <ul class="searchable-options-list" id="listPenilaianSoal">
                                <% ujianList.forEach(function(u) { %>
                                    <li class="searchable-option-item <%= u.id === selectedUjianId ? 'selected' : '' %>" data-title="<%= ((u.judul_ujian || '') + ' ' + (u.nama_mk || '')).toLowerCase() %>" onclick="selectPenilaianSoal(<%= u.id %>)">
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <i class="fas <%= u.id === selectedUjianId ? 'fa-check-circle text-success' : 'fa-circle-dot text-muted' %>" style="font-size: 0.85rem;"></i>
                                            <div>
                                                <div style="font-weight: 600; color: #0f172a;"><%= u.judul_ujian %></div>
                                                <% if (u.nama_mk && u.nama_mk !== '-') { %>
                                                    <div style="font-size: 0.76rem; color: #64748b;"><%= u.nama_mk %> &bull; <span class="kode-badge" style="font-size: 0.68rem; padding: 1px 5px;"><%= u.jenis_ujian %></span></div>
                                                <% } %>
                                            </div>
                                        </div>
                                        <% if (u.id === selectedUjianId) { %>
                                            <span style="font-size: 0.72rem; background: #dcfce7; color: #15803d; padding: 2px 6px; border-radius: 4px; font-weight: 700;">Aktif</span>
                                        <% } %>
                                    </li>
                                <% }); %>
                            </ul>
                            <div class="searchable-empty-hint" id="emptyPenilaianSoalHint">
                                <i class="fas fa-search" style="margin-right: 4px;"></i> Judul penilaian tidak ditemukan
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TATA LETAK FITUR: 1. + Tambah Soal Manual, 2. Generate Soal, 3. Cetak / Export -->
                <div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
                    <!-- 1. + Tambah Soal Manual -->
                    <button type="button" class="btn-primary-action" onclick="openModal('create-soal-modal')">
                        <i class="fas fa-plus"></i> Tambah Soal Manual
                    </button>

                    <!-- 2. AI Generate Soal -->
                    <button type="button" class="btn btn-accent" style="border-radius: 8px; font-weight: 600; padding: 10px 18px;" onclick="openModal('ai-modal')">
                        <i class="fas fa-wand-magic-sparkles"></i> AI Generate Soal
                    </button>

                    <!-- 3. Cetak / Export -->
                    <div class="dropdown-cetak">
                        <button type="button" class="btn-cetak-soal" onclick="toggleCetakMenuSoal(event)">
                            <i class="fas fa-print" style="color: #1b4d3e;"></i> Cetak / Export <i class="fas fa-caret-down"></i>
                        </button>
                        <div class="dropdown-menu-cetak" id="cetakDropdownSoal">
                            <a href="/admin/soal/cetak_naskah?ujian_id=<%= selectedUjianId %>" target="_blank" class="dropdown-item-cetak">
                                <i class="fas fa-file-pdf" style="color: #dc2626; font-size: 1.15rem;"></i>
                                <div>
                                    <strong style="color: #0f172a;">Cetak Naskah Soal (PDF)</strong>
                                    <div style="font-size: 0.74rem; color: #64748b;">Naskah lengkap terlampir kunci & kisi-kisi</div>
                                </div>
                            </a>
                            <a href="/admin/soal/export_word?ujian_id=<%= selectedUjianId %>" class="dropdown-item-cetak">
                                <i class="fas fa-file-word" style="color: #2563eb; font-size: 1.15rem;"></i>
                                <div>
                                    <strong style="color: #0f172a;">Unduh Naskah Soal (.docx)</strong>
                                    <div style="font-size: 0.74rem; color: #64748b;">Format Microsoft Word siap edit & terlampir kisi-kisi</div>
                                </div>
                            </a>
                            <a href="/admin/soal/export_excel?ujian_id=<%= selectedUjianId %>" class="dropdown-item-cetak">
                                <i class="fas fa-file-excel" style="color: #16a34a; font-size: 1.15rem;"></i>
                                <div>
                                    <strong style="color: #0f172a;">Unduh Matriks & Soal (.xlsx)</strong>
                                    <div style="font-size: 0.74rem; color: #64748b;">2 Sheet: Matriks Kisi-Kisi & Naskah Soal</div>
                                </div>
                            </a>
                            <a href="/admin/kisi_kisi/cetak_matriks?ujian_id=<%= selectedUjianId %>" target="_blank" class="dropdown-item-cetak">
                                <i class="fas fa-table-cells" style="color: #059669; font-size: 1.15rem;"></i>
                                <div>
                                    <strong style="color: #0f172a;">Cetak Matriks Kisi-Kisi (PDF)</strong>
                                    <div style="font-size: 0.74rem; color: #64748b;">Tabel matriks sebaran kompetensi & butir soal</div>
                                </div>
                            </a>
                            <a href="/admin/kisi_kisi/export_matrix_word?ujian_id=<%= selectedUjianId %>" class="dropdown-item-cetak">
                                <i class="fas fa-table" style="color: #0d9488; font-size: 1.15rem;"></i>
                                <div>
                                    <strong style="color: #0f172a;">Unduh Matriks Kisi-Kisi (.docx)</strong>
                                    <div style="font-size: 0.74rem; color: #64748b;">Format tabel matriks Microsoft Word</div>
                                </div>
                            </a>
                            <div style="border-top: 1px solid #e2e8f0; margin: 4px 0;"></div>
                            <a href="/admin/soal/cetak_naskah?ujian_id=<%= selectedUjianId %>&open_format=true" target="_blank" class="dropdown-item-cetak" style="background: #f0fdf4;">
                                <i class="fas fa-sliders" style="color: #166534; font-size: 1.15rem;"></i>
                                <div>
                                    <strong style="color: #166534;">Sesuaikan Kop & Identitas Naskah</strong>
                                    <div style="font-size: 0.74rem; color: #15803d;">Atur korps, logo, identitas (Dosen / Admin)</div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <% if (message) { %>
                <div class="alert alert-success" style="margin-bottom: 20px;">
                    <i class="fas fa-check-circle" style="margin-right: 6px;"></i> <%= message %>
                </div>
            <% } %>

            <div class="modern-table-card" style="padding: 20px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; border-bottom: 1px solid #e2e8f0; padding-bottom: 14px;">
                    <h3 style="margin: 0; font-size: 1.2rem; color: #0f172a; font-weight: 700;">Daftar Soal (<%= soalList.length %> Butir)</h3>
                    <span class="pill-badge pill-badge-purple" style="font-size: 0.88rem; padding: 6px 14px;">Total Poin: <%= soalList.reduce((acc, s) => acc + (s.poin || 0), 0) %></span>
                </div>

                <% if (soalList.length === 0) { %>
                    <p class="text-center" style="padding: 40px; color: #64748b; font-size: 0.95rem;">
                        Belum ada soal untuk penilaian ini. Klik tombol <strong>"Tambah Soal Manual"</strong> atau <strong>"AI Generate Soal"</strong> untuk membuat soal!
                    </p>
                <% } else { %>
                    <% soalList.forEach(function(s, idx) { %>
                        <div style="border: 1px solid #e2e8f0; border-radius: 10px; padding: 18px; margin-bottom: 16px; background: #ffffff; transition: box-shadow 0.15s ease;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
                                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                    <span class="pill-badge pill-badge-success" style="font-weight: 700;">No. <%= idx + 1 %></span>
                                    <% 
                                        let jsoalLabel = 'Pilihan Ganda';
                                        let jBadgeClass = 'pill-badge';
                                        const jCode = (s.jenis_soal || '').toLowerCase();
                                        if (jCode === 'pg_kompleks') {
                                            jsoalLabel = 'PG Kompleks';
                                            jBadgeClass = 'pill-badge-warning';
                                        } else if (jCode === 'tf') {
                                            jsoalLabel = 'Benar / Salah';
                                            jBadgeClass = 'pill-badge-success';
                                        } else if (jCode === 'menjodohkan') {
                                            jsoalLabel = 'Menjodohkan';
                                            jBadgeClass = 'pill-badge-purple';
                                        } else if (jCode === 'short' || jCode === 'isian') {
                                            jsoalLabel = 'Isian Singkat';
                                            jBadgeClass = 'pill-badge-warning';
                                        } else if (jCode === 'esai' || jCode === 'essay') {
                                            jsoalLabel = 'Uraian / Esai';
                                            jBadgeClass = 'pill-badge-danger';
                                        }
                                    %>
                                    <span class="<%= jBadgeClass %>" style="font-weight: 600;"><%= jsoalLabel %></span>
                                    <span class="pill-badge"><%= s.tingkat_kesulitan || 'sedang' %></span>
                                    <span class="kode-badge" style="font-size: 0.8rem; padding: 2px 7px;"><%= s.level_kognitif || 'C1' %></span>
                                    <% if (s.gambar || s.gambar_soal) { %>
                                        <span class="pill-badge" style="background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; font-weight: 600;">
                                            <i class="fas fa-image"></i> Bergambar
                                        </span>
                                    <% } %>
                                </div>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="font-weight: 700; font-size: 0.9rem; color: #0f172a; background: #f1f5f9; padding: 4px 10px; border-radius: 6px;"><%= s.poin || 4 %> Poin</span>
                                    <button type="button" class="btn-action-edit" title="Edit Soal" onclick="openEditSoalModalById(<%= s.id %>)">
                                        <i class="fas fa-pen-to-square"></i> Edit
                                    </button>
                                    <form method="POST" action="/admin/soal" style="display: inline-block; margin: 0;" onsubmit="return confirmDelete('Apakah Anda yakin ingin menghapus butir soal No. <%= idx + 1 %> ini?');">
                                        <input type="hidden" name="action" value="delete">
                                        <input type="hidden" name="id_ujian" value="<%= selectedUjianId %>">
                                        <input type="hidden" name="soal_id" value="<%= s.id %>">
                                        <button type="submit" class="btn-action-delete" title="Hapus Soal">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <div style="font-size: 1.02rem; margin-bottom: 14px; color: #0f172a; line-height: 1.6; white-space: pre-line;">
                                <%- s.pertanyaan %>
                            </div>

                            <% if (s.gambar || s.gambar_soal) { %>
                                <div style="margin-bottom: 16px; max-width: 540px; border-radius: 10px; overflow: hidden; border: 1.5px solid #cbd5e1; background: #ffffff; box-shadow: 0 1px 4px rgba(0,0,0,0.06);">
                                    <div style="padding: 6px 12px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between;">
                                        <span style="font-size: 0.8rem; font-weight: 600; color: #0369a1; display: flex; align-items: center; gap: 6px;">
                                            <i class="fas fa-image"></i> Gambar / Stimulus Soal
                                        </span>
                                        <a href="<%= s.gambar || s.gambar_soal %>" target="_blank" style="font-size: 0.78rem; color: #2563eb; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;">
                                            <i class="fas fa-arrow-up-right-from-square"></i> Buka Gambar
                                        </a>
                                    </div>
                                    <div style="padding: 10px; text-align: center; background: #fafafa;">
                                        <img src="<%= s.gambar || s.gambar_soal %>" alt="Gambar Soal <%= idx + 1 %>" style="max-height: 280px; max-width: 100%; object-fit: contain; border-radius: 6px;">
                                    </div>
                                </div>
                            <% } %>

                            <% if (s.jenis_soal === 'menjodohkan' || s.jenis_soal === 'matching') { 
                                const pairs = (s.data_tambahan && s.data_tambahan.pairs && Object.keys(s.data_tambahan.pairs).length > 0)
                                    ? s.data_tambahan.pairs
                                    : (s.matching_pairs || {});
                            %>
                                <div style="margin-left: 6px; margin-bottom: 14px; background: #faf5ff; border: 1.5px solid #e9d5ff; border-radius: 8px; padding: 12px 16px;">
                                    <div style="font-weight: 700; color: #7e22ce; font-size: 0.88rem; margin-bottom: 10px; display: flex; align-items: center; gap: 6px;">
                                        <i class="fas fa-link"></i> Pasangan Kunci Menjodohkan:
                                    </div>
                                    <div style="display: flex; flex-direction: column; gap: 8px;">
                                        <% Object.entries(pairs).forEach(function([k, v], pIdx) { %>
                                            <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; background: #ffffff; border: 1px solid #d8b4fe; border-radius: 6px; padding: 8px 14px; font-size: 0.9rem;">
                                                <div style="font-weight: 600; color: #581c87; flex: 1.2;">
                                                    <span style="display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; background: #9333ea; color: #fff; font-size: 0.75rem; margin-right: 6px;"><%= pIdx + 1 %></span>
                                                    <%= k %>
                                                </div>
                                                <div style="color: #a855f7; font-size: 0.9rem;">
                                                    <i class="fas fa-arrow-right"></i>
                                                </div>
                                                <div style="color: #1e293b; flex: 1.8; font-weight: 500; background: #fdf4ff; padding: 6px 10px; border-radius: 4px; border: 1px dashed #c084fc;">
                                                    <%= v %>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                </div>
                            <% } else if (s.data_tambahan && typeof s.data_tambahan.jawaban_benar === 'boolean') { %>
                                <div style="margin-left: 10px; margin-bottom: 14px; padding: 10px 14px; border-radius: 6px; background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; font-size: 0.92rem;">
                                    <strong><i class="fas fa-check-double"></i> Kunci Jawaban:</strong> <%= s.data_tambahan.jawaban_benar ? 'BENAR (True)' : 'SALAH (False)' %>
                                </div>
                            <% } else if (s.opsi && s.opsi.length > 0) { %>
                                <div style="margin-left: 10px; margin-bottom: 14px; display: flex; flex-direction: column; gap: 6px;">
                                    <% s.opsi.forEach(function(o, oIdx) { %>
                                        <div style="padding: 6px 12px; border-radius: 6px; background: <%= o.benar ? '#f0fdf4' : '#f8fafc' %>; border: 1px solid <%= o.benar ? '#bbf7d0' : '#e2e8f0' %>; color: <%= o.benar ? '#15803d' : '#334155' %>; font-weight: <%= o.benar ? '600' : 'normal' %>; font-size: 0.92rem;">
                                            <strong><%= String.fromCharCode(65 + oIdx) %>.</strong> <%= o.teks || o.teks_opsi %> <%= o.benar ? '✔ (Kunci Jawaban)' : '' %>
                                        </div>
                                    <% }); %>
                                </div>
                            <% } else if (s.data_tambahan && s.data_tambahan.keywords) { %>
                                <div style="margin-left: 10px; margin-bottom: 14px; padding: 10px 14px; border-radius: 6px; background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; font-size: 0.92rem;">
                                    <strong><i class="fas fa-key"></i> Kata Kunci Penilaian Otomatis:</strong> <%= s.data_tambahan.keywords %>
                                </div>
                            <% } else if (s.kunci_jawaban) { %>
                                <div style="margin-left: 10px; margin-bottom: 14px; padding: 10px 14px; border-radius: 6px; background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; font-size: 0.92rem;">
                                    <strong><i class="fas fa-key"></i> Kunci Jawaban / Pedoman Penilaian:</strong> <%= s.kunci_jawaban %>
                                </div>
                            <% } %>

                            <% if (s.pembahasan) { %>
                                <div style="font-size: 0.88rem; color: #475569; background: #f8fafc; padding: 10px 14px; border-radius: 6px; border-left: 3px solid #1b4d3e;">
                                    <strong style="color: #1b4d3e;">Pembahasan / Rubrik:</strong> <%= s.pembahasan %>
                                </div>
                            <% } %>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </main>
    </div>

    <!-- MODAL 1: TAMBAH SOAL MANUAL (CENTERED) -->
    <div id="create-soal-modal" class="custom-modal-overlay">
        <div class="custom-modal-card">
            <div class="custom-modal-header">
                <h3><i class="fas fa-plus-circle"></i> Tambah Soal Manual</h3>
                <button type="button" class="close-modal-btn" onclick="closeModal('create-soal-modal')" title="Tutup">&times;</button>
            </div>

            <form method="POST" action="/admin/soal" enctype="multipart/form-data" class="custom-modal-body">
                <input type="hidden" name="action" value="create">
                <input type="hidden" name="id_ujian" value="<%= selectedUjianId %>">

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
                    <div class="form-group">
                        <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Jenis Soal</label>
                        <select name="jenis_soal" id="jenis_soal_select" class="form-select" onchange="switchSoalType(this.value, 'create')" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                            <option value="pg" selected>Pilihan Ganda (PG 5 Opsi)</option>
                            <option value="pg_kompleks">PG Kompleks (Multi Kunci)</option>
                            <option value="tf">Benar / Salah (True/False)</option>
                            <option value="menjodohkan">Menjodohkan (Matching)</option>
                            <option value="short">Isian Singkat (Short Answer)</option>
                            <option value="esai">Uraian / Esai (Essay Kasus)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Bobot Poin <span style="color:#dc2626;">*</span></label>
                        <input type="number" name="poin" value="4" class="form-control" required style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
                    <div class="form-group">
                        <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Tingkat Kesulitan</label>
                        <select name="tingkat_kesulitan" class="form-select" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                            <option value="mudah">Mudah</option>
                            <option value="sedang" selected>Sedang</option>
                            <option value="sulit">Sulit</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Level Kognitif</label>
                        <select name="level_kognitif" class="form-select" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                            <option value="C1">C1 - Mengingat</option>
                            <option value="C2" selected>C2 - Memahami</option>
                            <option value="C3">C3 - Menerapkan</option>
                            <option value="C4">C4 - Menganalisis</option>
                            <option value="C5">C5 - Mengevaluasi</option>
                        </select>
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Teks Pertanyaan <span style="color:#dc2626;">*</span></label>
                    <textarea name="pertanyaan" rows="3" required class="form-control" placeholder="Tuliskan teks butir soal pertanyaan..." style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-family: inherit;"></textarea>
                </div>

                <!-- Sisipkan Gambar Soal / Stimulus Visual (Manual / AI) -->
                <div style="margin-bottom: 16px; background: #f8fafc; border: 1.5px dashed #cbd5e1; border-radius: 10px; padding: 14px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; flex-wrap: wrap; gap: 6px;">
                        <label style="font-weight: 700; font-size: 0.88rem; color: #1e293b; display: flex; align-items: center; gap: 6px; margin: 0;">
                            <i class="fas fa-image" style="color: #0284c7;"></i> Sisipkan Gambar / Stimulus Soal <span style="font-size: 0.78rem; font-weight: normal; color: #64748b;">(Opsional)</span>
                        </label>
                        <button type="button" class="btn btn-sm" id="btn_ai_img_create" onclick="openAiImageGeneratorModal('create')" style="background: linear-gradient(135deg, #4f46e5, #7c3aed); color: white; border: none; border-radius: 6px; padding: 5px 12px; font-size: 0.8rem; font-weight: 600; display: inline-flex; align-items: center; gap: 5px; cursor: pointer; box-shadow: 0 1px 2px rgba(79,70,229,0.2);">
                            <i class="fas fa-wand-magic-sparkles"></i> Generate AI
                        </button>
                    </div>
                    <div id="create_gambar_status_msg" style="display: none; padding: 8px 12px; border-radius: 6px; font-size: 0.82rem; margin-bottom: 10px;"></div>
                    <p style="font-size: 0.8rem; color: #64748b; margin-bottom: 10px;">
                        Unggah berkas gambar (JPG/PNG/SVG), tempel tautan URL, atau rancang diagram otomatis dengan AI.
                    </p>
                    <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 8px;">
                        <input type="file" id="create_gambar_file" name="gambar_file" accept="image/*" class="form-control" style="flex: 1; padding: 6px 10px; font-size: 0.84rem; border: 1.5px solid #cbd5e1; border-radius: 6px;" onchange="handleImageFileSelected(this, 'create')">
                        <span style="font-size: 0.8rem; color: #94a3b8; font-weight: 600;">ATAU</span>
                        <input type="text" name="gambar" id="create_gambar_url" placeholder="URL Gambar (https://... atau /admin/uploads/...)" class="form-control" style="flex: 1.2; padding: 7px 10px; font-size: 0.84rem; border: 1.5px solid #cbd5e1; border-radius: 6px;" oninput="handleImageUrlInput(this.value, 'create')">
                    </div>
                    <!-- Preview Box Create -->
                    <div id="create_gambar_preview_box" style="display: none; margin-top: 10px; padding: 10px; background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: 8px;">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; flex-wrap: wrap; gap: 6px;">
                            <span style="font-size: 0.82rem; font-weight: 600; color: #166534;"><i class="fas fa-check-circle"></i> Pratinjau Gambar Terpasang</span>
                            <div style="display: flex; gap: 6px;">
                                <button type="button" onclick="openAiImageGeneratorModal('create')" style="background: #e0e7ff; color: #4338ca; border: 1px solid #c7d2fe; border-radius: 4px; padding: 3px 8px; font-size: 0.75rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 4px;">
                                    <i class="fas fa-arrows-rotate"></i> Ganti / Generate AI
                                </button>
                                <button type="button" onclick="removeQuestionImage('create')" style="background: #fee2e2; color: #ef4444; border: 1px solid #fca5a5; border-radius: 4px; padding: 3px 8px; font-size: 0.75rem; font-weight: 600; cursor: pointer;">
                                    <i class="fas fa-trash"></i> Hapus Gambar
                                </button>
                            </div>
                        </div>
                        <div style="text-align: center; background: #f8fafc; padding: 6px; border-radius: 6px;">
                            <img id="create_gambar_preview_img" src="" alt="Pratinjau Gambar" style="max-height: 220px; max-width: 100%; object-fit: contain; border-radius: 4px;">
                        </div>
                    </div>
                </div>

                <!-- Type 1: PG (Pilihan Ganda 5 Opsi, 1 Kunci) -->
                <div id="create_type_pg_container" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 8px;">Opsi Jawaban (Pilih Satu Kunci yang Benar):</label>
                    <% ['A', 'B', 'C', 'D', 'E'].forEach(function(letter, idx) { %>
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                            <input type="radio" name="opsi_benar" value="<%= idx %>" <%= idx === 0 ? 'checked' : '' %> style="transform: scale(1.2);">
                            <span style="font-weight: 700; width: 20px;"><%= letter %>.</span>
                            <input type="text" name="opsi_teks[]" placeholder="Teks opsi <%= letter %>" class="form-control" style="flex: 1; padding: 8px 12px; border: 1.5px solid #cbd5e1; border-radius: 6px;">
                        </div>
                    <% }); %>
                </div>

                <!-- Type 2: PG Kompleks (Multi Kunci Benar) -->
                <div id="create_type_pg_kompleks_container" style="display: none; margin-bottom: 14px; background: #fffbeb; border: 1.5px solid #fef3c7; border-radius: 8px; padding: 14px;">
                    <label style="font-weight: 700; font-size: 0.88rem; color: #92400e; display: block; margin-bottom: 6px;">
                        <i class="fas fa-list-check"></i> Pilihan Ganda Kompleks (Centang Semua Pilihan yang Benar):
                    </label>
                    <p style="font-size: 0.82rem; color: #78350f; margin-bottom: 10px;">
                        Centang kotak pada opsi yang bernilai benar. Peserta dapat memilih lebih dari satu jawaban.
                    </p>
                    <% ['A', 'B', 'C', 'D', 'E'].forEach(function(letter, idx) { %>
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                            <input type="checkbox" name="pgk_opsi_benar" value="<%= idx %>" <%= (idx === 0 || idx === 1) ? 'checked' : '' %> style="transform: scale(1.2);">
                            <span style="font-weight: 700; width: 20px; color: #92400e;"><%= letter %>.</span>
                            <input type="text" name="pgk_opsi_teks[]" placeholder="Pernyataan opsi <%= letter %>" class="form-control" style="flex: 1; padding: 8px 12px; border: 1.5px solid #cbd5e1; border-radius: 6px;">
                        </div>
                    <% }); %>
                </div>

                <!-- Type 3: TF (Benar / Salah) -->
                <div id="create_type_tf_container" style="display: none; margin-bottom: 14px; background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 14px;">
                    <label style="font-weight: 700; font-size: 0.88rem; color: #1e293b; display: block; margin-bottom: 8px;">
                        <i class="fas fa-check-double"></i> Kunci Jawaban Benar / Salah:
                    </label>
                    <div style="display: flex; gap: 20px;">
                        <label style="display: flex; align-items: center; gap: 8px; font-weight: 700; color: #16a34a; cursor: pointer; padding: 6px 14px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 6px;">
                            <input type="radio" name="jawaban_tf" value="true" checked style="transform: scale(1.15);"> BENAR
                        </label>
                        <label style="display: flex; align-items: center; gap: 8px; font-weight: 700; color: #dc2626; cursor: pointer; padding: 6px 14px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 6px;">
                            <input type="radio" name="jawaban_tf" value="false" style="transform: scale(1.15);"> SALAH
                        </label>
                    </div>
                </div>

                <!-- Type 4: Menjodohkan (Matching) -->
                <div id="create_type_menjodohkan_container" style="display: none; margin-bottom: 14px; background: #faf5ff; border: 1.5px solid #e9d5ff; border-radius: 8px; padding: 14px;">
                    <label style="font-weight: 700; font-size: 0.88rem; color: #7e22ce; display: block; margin-bottom: 6px;">
                        <i class="fas fa-link"></i> Pasangan Soal Menjodohkan (Premis <=> Pasangan Jawaban):
                    </label>
                    <p style="font-size: 0.82rem; color: #64748b; margin-bottom: 10px;">
                        Tuliskan item pernyataan/premis di kolom kiri dan pasangan kunci jawabannya di kolom kanan.
                    </p>
                    <div id="create_matching_rows_wrap" style="display: flex; flex-direction: column; gap: 8px;">
                        <% for (let i = 1; i <= 3; i++) { %>
                            <div class="matching-pair-row" style="display: flex; gap: 8px; align-items: center;">
                                <span style="font-weight: 700; color: #9333ea; width: 20px;"><%= i %>.</span>
                                <input type="text" name="matching_keys[]" placeholder="Premis <%= i %> (Kolom Kiri)" class="form-control" style="flex: 1; padding: 8px 10px; border: 1.5px solid #cbd5e1; border-radius: 6px;">
                                <span style="color: #a855f7;"><i class="fas fa-arrow-right"></i></span>
                                <input type="text" name="matching_values[]" placeholder="Kunci Pasangan <%= i %> (Kolom Kanan)" class="form-control" style="flex: 1; padding: 8px 10px; border: 1.5px solid #cbd5e1; border-radius: 6px;">
                            </div>
                        <% } %>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addMatchingRow('create_matching_rows_wrap')" style="margin-top: 10px; font-size: 0.82rem;">
                        <i class="fas fa-plus"></i> Tambah Baris Pasangan
                    </button>
                </div>

                <!-- Type 5: Short / Isian Singkat -->
                <div id="create_type_short_container" style="display: none; margin-bottom: 14px; background: #f0fdf4; border: 1.5px solid #bbf7d0; border-radius: 8px; padding: 14px;">
                    <label style="font-weight: 700; font-size: 0.88rem; color: #166534; display: block; margin-bottom: 6px;">
                        <i class="fas fa-pen-nib"></i> Kunci Jawaban Isian Singkat:
                    </label>
                    <p style="font-size: 0.82rem; color: #15803d; margin-bottom: 8px;">
                        Tuliskan jawaban yang diterima. Pisahkan dengan tanda koma (,) bila terdapat variasi penulisan/sinonim.
                    </p>
                    <input type="text" name="keywords" placeholder="Contoh: Enkripsi, Kriptografi, Enkripsi Data" class="form-control" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 6px;">
                </div>

                <!-- Type 6: Esai / Uraian Kasus -->
                <div id="create_type_esai_container" style="display: none; margin-bottom: 14px; background: #eff6ff; border: 1.5px solid #bfdbfe; border-radius: 8px; padding: 14px;">
                    <label style="font-weight: 700; font-size: 0.88rem; color: #1e40af; display: block; margin-bottom: 6px;">
                        <i class="fas fa-file-lines"></i> Kata Kunci Penilaian Otomatis Esai:
                    </label>
                    <p style="font-size: 0.82rem; color: #1d4ed8; margin-bottom: 8px;">
                        Tuliskan kata kunci materi penting yang harus ada dalam uraian peserta. Skor otomatis akan dihitung dari persentase kata kunci yang ditemukan.
                    </p>
                    <textarea name="keywords" rows="3" placeholder="Contoh: integritas, kerahasiaan, ketersediaan, otentikasi (pisahkan dengan koma)" class="form-control" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 6px; font-family: inherit;"></textarea>
                </div>

                <div class="form-group" style="margin-bottom: 16px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Penjelasan / Pembahasan (Opsional)</label>
                    <textarea name="pembahasan" rows="2" class="form-control" placeholder="Tuliskan ulasan kunci pembahasan..." style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-family: inherit;"></textarea>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; border-top: 1px solid #f1f5f9; padding-top: 16px;">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('create-soal-modal')" style="padding: 10px 18px; border-radius: 8px;">Batal</button>
                    <button type="submit" class="btn btn-primary" style="background: #1b4d3e; border: none; padding: 10px 22px; border-radius: 8px; font-weight: 600;"><i class="fas fa-check"></i> Simpan Soal</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL 2: EDIT SOAL (CENTERED) -->
    <div id="edit-soal-modal" class="custom-modal-overlay">
        <div class="custom-modal-card">
            <div class="custom-modal-header">
                <h3><i class="fas fa-pen-to-square"></i> Edit Butir Soal</h3>
                <button type="button" class="close-modal-btn" onclick="closeModal('edit-soal-modal')" title="Tutup">&times;</button>
            </div>

            <form method="POST" action="/admin/soal" enctype="multipart/form-data" class="custom-modal-body">
                <input type="hidden" name="action" value="edit">
                <input type="hidden" name="id_ujian" value="<%= selectedUjianId %>">
                <input type="hidden" name="soal_id" id="edit_soal_id">

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
                    <div class="form-group">
                        <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Jenis Soal</label>
                        <select name="jenis_soal" id="edit_soal_jenis" class="form-select" onchange="switchSoalType(this.value, 'edit')" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                            <option value="pg">Pilihan Ganda (PG 5 Opsi)</option>
                            <option value="pg_kompleks">PG Kompleks (Multi Kunci)</option>
                            <option value="tf">Benar / Salah (True/False)</option>
                            <option value="menjodohkan">Menjodohkan (Matching)</option>
                            <option value="short">Isian Singkat (Short Answer)</option>
                            <option value="esai">Uraian / Esai (Essay Kasus)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Bobot Poin <span style="color:#dc2626;">*</span></label>
                        <input type="number" name="poin" id="edit_soal_poin" required class="form-control" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
                    <div class="form-group">
                        <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Tingkat Kesulitan</label>
                        <select name="tingkat_kesulitan" id="edit_soal_kesulitan" class="form-select" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                            <option value="mudah">Mudah</option>
                            <option value="sedang">Sedang</option>
                            <option value="sulit">Sulit</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Level Kognitif</label>
                        <select name="level_kognitif" id="edit_soal_kognitif" class="form-select" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                            <option value="C1">C1 - Mengingat</option>
                            <option value="C2">C2 - Memahami</option>
                            <option value="C3">C3 - Menerapkan</option>
                            <option value="C4">C4 - Menganalisis</option>
                            <option value="C5">C5 - Mengevaluasi</option>
                        </select>
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Teks Pertanyaan <span style="color:#dc2626;">*</span></label>
                    <textarea name="pertanyaan" id="edit_soal_pertanyaan" rows="3" required class="form-control" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-family: inherit;"></textarea>
                </div>

                <!-- Sisipkan Gambar Soal / Stimulus Visual (Edit) -->
                <div style="margin-bottom: 16px; background: #f8fafc; border: 1.5px dashed #cbd5e1; border-radius: 10px; padding: 14px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; flex-wrap: wrap; gap: 6px;">
                        <label style="font-weight: 700; font-size: 0.88rem; color: #1e293b; display: flex; align-items: center; gap: 6px; margin: 0;">
                            <i class="fas fa-image" style="color: #0284c7;"></i> Gambar / Stimulus Soal
                        </label>
                        <button type="button" class="btn btn-sm" id="btn_ai_img_edit" onclick="openAiImageGeneratorModal('edit')" style="background: linear-gradient(135deg, #4f46e5, #7c3aed); color: white; border: none; border-radius: 6px; padding: 5px 12px; font-size: 0.8rem; font-weight: 600; display: inline-flex; align-items: center; gap: 5px; cursor: pointer; box-shadow: 0 1px 2px rgba(79,70,229,0.2);">
                            <i class="fas fa-wand-magic-sparkles"></i> Generate AI
                        </button>
                    </div>
                    <div id="edit_gambar_status_msg" style="display: none; padding: 8px 12px; border-radius: 6px; font-size: 0.82rem; margin-bottom: 10px;"></div>
                    <p style="font-size: 0.8rem; color: #64748b; margin-bottom: 10px;">
                        Ganti gambar dengan berkas baru, ubah URL gambar, atau generate/ganti ulang kapan pun dengan AI.
                    </p>
                    <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 8px;">
                        <input type="file" id="edit_gambar_file" name="gambar_file" accept="image/*" class="form-control" style="flex: 1; padding: 6px 10px; font-size: 0.84rem; border: 1.5px solid #cbd5e1; border-radius: 6px;" onchange="handleImageFileSelected(this, 'edit')">
                        <span style="font-size: 0.8rem; color: #94a3b8; font-weight: 600;">ATAU</span>
                        <input type="text" name="gambar" id="edit_gambar_url" placeholder="URL Gambar (https://... atau /admin/uploads/...)" class="form-control" style="flex: 1.2; padding: 7px 10px; font-size: 0.84rem; border: 1.5px solid #cbd5e1; border-radius: 6px;" oninput="handleImageUrlInput(this.value, 'edit')">
                    </div>
                    <!-- Preview Box Edit -->
                    <div id="edit_gambar_preview_box" style="display: none; margin-top: 10px; padding: 10px; background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: 8px;">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; flex-wrap: wrap; gap: 6px;">
                            <span style="font-size: 0.82rem; font-weight: 600; color: #166534;"><i class="fas fa-check-circle"></i> Pratinjau Gambar Terpasang</span>
                            <div style="display: flex; gap: 6px;">
                                <button type="button" onclick="openAiImageGeneratorModal('edit')" style="background: #e0e7ff; color: #4338ca; border: 1px solid #c7d2fe; border-radius: 4px; padding: 3px 8px; font-size: 0.75rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 4px;">
                                    <i class="fas fa-arrows-rotate"></i> Ganti / Generate AI
                                </button>
                                <button type="button" onclick="removeQuestionImage('edit')" style="background: #fee2e2; color: #ef4444; border: 1px solid #fca5a5; border-radius: 4px; padding: 3px 8px; font-size: 0.75rem; font-weight: 600; cursor: pointer;">
                                    <i class="fas fa-trash"></i> Hapus Gambar
                                </button>
                            </div>
                        </div>
                        <div style="text-align: center; background: #f8fafc; padding: 6px; border-radius: 6px;">
                            <img id="edit_gambar_preview_img" src="" alt="Pratinjau Gambar" style="max-height: 220px; max-width: 100%; object-fit: contain; border-radius: 4px;">
                        </div>
                    </div>
                </div>

                <!-- Type 1: PG (Pilihan Ganda 5 Opsi, 1 Kunci Benar) -->
                <div id="edit_type_pg_container" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 8px;">Opsi Jawaban & Kunci Benar (Pilih Satu):</label>
                    <% ['A', 'B', 'C', 'D', 'E'].forEach(function(letter, idx) { %>
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                            <input type="radio" name="opsi_benar" value="<%= idx %>" id="edit_opsi_benar_<%= idx %>" style="transform: scale(1.2);">
                            <span style="font-weight: 700; width: 20px;"><%= letter %>.</span>
                            <input type="text" name="opsi_teks[]" id="edit_opsi_teks_<%= idx %>" placeholder="Teks opsi <%= letter %>" class="form-control" style="flex: 1; padding: 8px 12px; border: 1.5px solid #cbd5e1; border-radius: 6px;">
                        </div>
                    <% }); %>
                </div>

                <!-- Type 2: PG Kompleks (Multi Kunci Benar) -->
                <div id="edit_type_pg_kompleks_container" style="display: none; margin-bottom: 14px; background: #fffbeb; border: 1.5px solid #fef3c7; border-radius: 8px; padding: 14px;">
                    <label style="font-weight: 700; font-size: 0.88rem; color: #92400e; display: block; margin-bottom: 6px;">
                        <i class="fas fa-list-check"></i> Pilihan Ganda Kompleks (Centang Semua Pilihan yang Benar):
                    </label>
                    <p style="font-size: 0.82rem; color: #78350f; margin-bottom: 10px;">
                        Centang kotak pada opsi yang bernilai benar. Peserta dapat memilih lebih dari satu jawaban.
                    </p>
                    <% ['A', 'B', 'C', 'D', 'E'].forEach(function(letter, idx) { %>
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                            <input type="checkbox" name="pgk_opsi_benar" value="<%= idx %>" id="edit_pgk_opsi_benar_<%= idx %>" style="transform: scale(1.2);">
                            <span style="font-weight: 700; width: 20px; color: #92400e;"><%= letter %>.</span>
                            <input type="text" name="pgk_opsi_teks[]" id="edit_pgk_opsi_teks_<%= idx %>" placeholder="Pernyataan opsi <%= letter %>" class="form-control" style="flex: 1; padding: 8px 12px; border: 1.5px solid #cbd5e1; border-radius: 6px;">
                        </div>
                    <% }); %>
                </div>

                <!-- Type 3: TF (Benar / Salah) -->
                <div id="edit_type_tf_container" style="display: none; margin-bottom: 14px; background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 14px;">
                    <label style="font-weight: 700; font-size: 0.88rem; color: #1e293b; display: block; margin-bottom: 8px;">
                        <i class="fas fa-check-double"></i> Kunci Jawaban Benar / Salah:
                    </label>
                    <div style="display: flex; gap: 20px;">
                        <label style="display: flex; align-items: center; gap: 8px; font-weight: 700; color: #16a34a; cursor: pointer; padding: 6px 14px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 6px;">
                            <input type="radio" name="jawaban_tf" value="true" id="edit_tf_true" style="transform: scale(1.15);"> BENAR
                        </label>
                        <label style="display: flex; align-items: center; gap: 8px; font-weight: 700; color: #dc2626; cursor: pointer; padding: 6px 14px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 6px;">
                            <input type="radio" name="jawaban_tf" value="false" id="edit_tf_false" style="transform: scale(1.15);"> SALAH
                        </label>
                    </div>
                </div>

                <!-- Type 4: Menjodohkan Edit -->
                <div id="edit_type_menjodohkan_container" style="display: none; margin-bottom: 14px; background: #faf5ff; border: 1.5px solid #e9d5ff; border-radius: 8px; padding: 14px;">
                    <label style="font-weight: 700; font-size: 0.88rem; color: #7e22ce; display: block; margin-bottom: 6px;">
                        <i class="fas fa-link"></i> Pasangan Kunci Menjodohkan (Premis <=> Pasangan Jawaban):
                    </label>
                    <div id="edit_matching_rows_wrap" style="display: flex; flex-direction: column; gap: 8px;">
                        <!-- populated via javascript -->
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addMatchingRow('edit_matching_rows_wrap')" style="margin-top: 10px; font-size: 0.82rem;">
                        <i class="fas fa-plus"></i> Tambah Baris Pasangan
                    </button>
                </div>

                <!-- Type 5: Short / Isian Singkat -->
                <div id="edit_type_short_container" style="display: none; margin-bottom: 14px; background: #f0fdf4; border: 1.5px solid #bbf7d0; border-radius: 8px; padding: 14px;">
                    <label style="font-weight: 700; font-size: 0.88rem; color: #166534; display: block; margin-bottom: 6px;">
                        <i class="fas fa-pen-nib"></i> Kunci Jawaban Isian Singkat:
                    </label>
                    <p style="font-size: 0.82rem; color: #15803d; margin-bottom: 8px;">
                        Tuliskan jawaban yang diterima. Pisahkan dengan tanda koma (,) bila terdapat variasi penulisan/sinonim.
                    </p>
                    <input type="text" name="keywords" id="edit_soal_keywords_short" placeholder="Contoh: Enkripsi, Kriptografi, Enkripsi Data" class="form-control" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 6px;">
                </div>

                <!-- Type 6: Esai / Uraian Kasus -->
                <div id="edit_type_esai_container" style="display: none; margin-bottom: 14px; background: #eff6ff; border: 1.5px solid #bfdbfe; border-radius: 8px; padding: 14px;">
                    <label style="font-weight: 700; font-size: 0.88rem; color: #1e40af; display: block; margin-bottom: 6px;">
                        <i class="fas fa-file-lines"></i> Kata Kunci Penilaian Otomatis Esai:
                    </label>
                    <p style="font-size: 0.82rem; color: #1d4ed8; margin-bottom: 8px;">
                        Tuliskan kata kunci materi penting yang harus ada dalam uraian peserta. Skor otomatis akan dihitung dari persentase kata kunci yang ditemukan.
                    </p>
                    <textarea name="keywords" id="edit_soal_keywords_esai" rows="3" placeholder="Contoh: integritas, kerahasiaan, ketersediaan, otentikasi (pisahkan dengan koma)" class="form-control" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 6px; font-family: inherit;"></textarea>
                </div>

                <div class="form-group" style="margin-bottom: 16px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Penjelasan / Pembahasan</label>
                    <textarea name="pembahasan" id="edit_soal_pembahasan" rows="2" class="form-control" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-family: inherit;"></textarea>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; border-top: 1px solid #f1f5f9; padding-top: 16px;">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('edit-soal-modal')" style="padding: 10px 18px; border-radius: 8px;">Batal</button>
                    <button type="submit" class="btn btn-primary" style="background: #1b4d3e; border: none; padding: 10px 22px; border-radius: 8px; font-weight: 600;"><i class="fas fa-check"></i> Simpan Perubahan</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL 4: RANCANG / UBAH STIMULUS GAMBAR DENGAN AI (UNTUK TAMBAH & EDIT SOAL) -->
    <div id="ai-single-img-modal" class="custom-modal-overlay" style="z-index: 1060;">
        <div class="custom-modal-card" style="max-width: 520px;">
            <div class="custom-modal-header">
                <h3><i class="fas fa-wand-magic-sparkles" style="color: #6366f1;"></i> Rancang / Ubah Stimulus Gambar (AI)</h3>
                <button type="button" class="close-modal-btn" onclick="closeModal('ai-single-img-modal')" title="Tutup">&times;</button>
            </div>

            <div class="custom-modal-body">
                <input type="hidden" id="single_ai_img_target_prefix" value="edit">

                <div id="single_ai_img_banner" style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 10px 14px; margin-bottom: 14px; font-size: 0.84rem; color: #1e40af;">
                    <i class="fas fa-info-circle"></i> Rancang visual diagram baru atau timpa gambar yang ada kapan saja sesuai materi naskah soal.
                </div>

                <div class="form-group" style="margin-bottom: 12px;">
                    <label style="font-weight: 600; font-size: 0.86rem; display: block; margin-bottom: 5px;">
                        Deskripsi Diagram / Topik Visual <span style="color: #dc2626;">*</span>
                    </label>
                    <textarea id="single_ai_img_prompt" rows="2" class="form-control" placeholder="Contoh: Skema Alur SDLC Waterfall, Arsitektur 3-Tier Client Server, Topologi Star Jaringan..." style="width: 100%; padding: 8px 12px; border: 1.5px solid #cbd5e1; border-radius: 6px; font-size: 0.88rem; font-family: inherit;"></textarea>
                    <small style="color: #64748b; font-size: 0.76rem;">Bisa berupa nama materi, skema diagram, atau alur kasus yang ingin divisualisasikan.</small>
                </div>

                <div class="form-group" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.86rem; display: block; margin-bottom: 5px;">
                        Gaya / Format Diagram
                    </label>
                    <select id="single_ai_img_style" class="form-select" style="width: 100%; padding: 8px 10px; border: 1.5px solid #cbd5e1; border-radius: 6px; font-size: 0.86rem;">
                        <option value="auto" selected>🤖 Otomatis Sesuai Materi</option>
                        <option value="process">🔄 Alur Proses / Flowchart</option>
                        <option value="architecture">🏗️ Arsitektur / Blok Sistem</option>
                        <option value="network">🌐 Topologi Jaringan & Node</option>
                        <option value="hierarchy">🌲 Hirarki / Pohon Konsep</option>
                        <option value="venn">⭕ Diagram Relasi / Venn</option>
                    </select>
                </div>

                <div id="single_ai_img_status" style="display: none; padding: 10px 14px; border-radius: 6px; font-size: 0.84rem; margin-bottom: 14px;"></div>

                <div style="display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid #f1f5f9; padding-top: 14px;">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('ai-single-img-modal')" style="padding: 8px 16px; border-radius: 6px;">Batal</button>
                    <button type="button" class="btn btn-primary" id="btn_execute_single_ai_img" onclick="executeSingleAiImageGenerate()" style="background: linear-gradient(135deg, #4f46e5, #7c3aed); border: none; padding: 8px 18px; border-radius: 6px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                        <i class="fas fa-sparkles"></i> Rancang & Terapkan Gambar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL 3: AI GENERATOR SOAL (PRESISI TINGGI & PERMANEN) -->
    <div id="ai-modal" class="custom-modal-overlay">
        <div class="custom-modal-card" style="max-width: 620px;">
            <div class="custom-modal-header">
                <h3><i class="fas fa-wand-magic-sparkles" style="color: #f59e0b;"></i> AI Generator Soal (Presisi Tinggi & Siap Uji)</h3>
                <button type="button" class="close-modal-btn" onclick="closeModal('ai-modal')" title="Tutup">&times;</button>
            </div>

            <div class="custom-modal-body">
                <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 10px 14px; margin-bottom: 16px; font-size: 0.88rem; color: #166534; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-shield-halved" style="font-size: 1.1rem;"></i>
                    <span>Butir soal disusun lengkap (5 pilihan A-E, 1 kunci valid, pembahasan) siap uji langsung dan tersimpan permanen.</span>
                </div>

                <form id="ai-generate-form" onsubmit="handleAiGenerate(event)">
                    <!-- SECTION 1: KONFIGURASI TEKNIS NASKAH SOAL (TEKS UTAMA) -->
                    <div style="background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 10px; padding: 14px; margin-bottom: 14px;">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">
                            <div style="font-weight: 700; font-size: 0.9rem; color: #1e293b; display: flex; align-items: center; gap: 6px;">
                                <span style="background: #1b4d3e; color: #ffffff; width: 22px; height: 22px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.78rem;">1</span>
                                <span>Konfigurasi Teknis Naskah Soal <span style="font-weight: 500; font-size: 0.8rem; color: #64748b;">(Teks Mandiri)</span></span>
                            </div>
                            <span class="pill-badge pill-badge-success" style="font-size: 0.75rem;">Standar Akademik</span>
                        </div>

                        <div class="form-group" style="margin-bottom: 12px;">
                            <label style="font-weight: 600; font-size: 0.86rem; display: block; margin-bottom: 5px;">Topik / Materi Ujian <span style="color: #dc2626;">*</span></label>
                            <input type="text" id="ai-topic" required class="form-control" value="<%= currentUjian ? (currentUjian.nama_mk || currentUjian.judul_ujian) : 'Etika Profesi Komputer' %>" style="width: 100%; padding: 8px 12px; border: 1.5px solid #cbd5e1; border-radius: 6px; font-size: 0.88rem;">
                        </div>

                        <div class="form-group" style="margin-bottom: 12px;">
                            <label style="font-weight: 600; font-size: 0.86rem; display: flex; justify-content: space-between; margin-bottom: 5px;">
                                <span>Sub-Topik / Batasan Pembahasan</span>
                                <span style="font-size: 0.78rem; color: #0284c7; font-weight: 500;"><i class="fas fa-bullseye"></i> Fokus Ruang Lingkup</span>
                            </label>
                            <textarea id="ai-subtopic" class="form-control" rows="2" placeholder="Contoh: Kode Etik ACM/IEEE, Hak Cipta Perangkat Lunak, Studi Kasus Pelanggaran Privasi Data" style="width: 100%; padding: 8px 12px; border: 1.5px solid #cbd5e1; border-radius: 6px; font-family: inherit; font-size: 0.86rem;"></textarea>
                        </div>

                        <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 10px; margin-bottom: 12px;">
                            <div class="form-group">
                                <label style="font-weight: 600; font-size: 0.86rem; display: block; margin-bottom: 5px;">
                                    <i class="fas fa-feather-pointed" style="color: #1b4d3e;"></i> Gaya Narasi Naskah Soal
                                </label>
                                <select id="ai-gaya-naskah" class="form-select" style="width: 100%; padding: 8px 10px; border: 1.5px solid #cbd5e1; border-radius: 6px; font-size: 0.85rem;">
                                    <option value="kasus" selected>🏢 Kasus Kontekstual & Kasus Nyata</option>
                                    <option value="problem_solving">⚙️ Problem Solving & Algoritmik</option>
                                    <option value="konseptual">📚 Konseptual & Teori Terapan</option>
                                    <option value="standar">📝 Standar Evaluasi Akademik</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label style="font-weight: 600; font-size: 0.86rem; display: block; margin-bottom: 5px;">Tingkat Kesulitan</label>
                                <select id="ai-kesulitan" class="form-select" style="width: 100%; padding: 8px 10px; border: 1.5px solid #cbd5e1; border-radius: 6px; font-size: 0.85rem;">
                                    <option value="proporsional" selected>Proporsional (30:50:20)</option>
                                    <option value="sedang">Sedang</option>
                                    <option value="sulit">HOTS (Sulit)</option>
                                    <option value="mudah">Mudah</option>
                                </select>
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px;">
                            <div class="form-group">
                                <label style="font-weight: 600; font-size: 0.86rem; display: block; margin-bottom: 5px;">Jumlah Butir Soal</label>
                                <input type="number" id="ai-count" min="1" max="25" value="5" oninput="updateAiGambarSummary()" class="form-control" style="width: 100%; padding: 8px 10px; border: 1.5px solid #cbd5e1; border-radius: 6px; font-size: 0.86rem;">
                            </div>
                            <div class="form-group">
                                <label style="font-weight: 600; font-size: 0.86rem; display: block; margin-bottom: 5px;">Poin per Butir Soal</label>
                                <input type="number" id="ai-poin" min="1" max="50" value="4" class="form-control" style="width: 100%; padding: 8px 10px; border: 1.5px solid #cbd5e1; border-radius: 6px; font-size: 0.86rem;">
                            </div>
                        </div>

                        <!-- Pilihan Bentuk / Jenis Soal (Multi-select) -->
                        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 6px; padding: 10px 12px; margin-bottom: 12px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; flex-wrap: wrap; gap: 6px;">
                                <label style="font-weight: 700; font-size: 0.82rem; color: #1e293b; margin: 0;">
                                    <i class="fas fa-list-check" style="color: #1b4d3e; margin-right: 4px;"></i> Bentuk Soal <span style="font-weight: 500; font-size: 0.78rem; color: #64748b;">(Bisa multi-pilih)</span>
                                </label>
                                <div style="display: flex; gap: 4px;">
                                    <button type="button" class="quick-chip" onclick="setAllCheckboxes('cb-soal-jenis', true)">Semua</button>
                                    <button type="button" class="quick-chip" onclick="setOnlyCheckbox('cb-soal-jenis', 'pg')">Hanya PG</button>
                                    <button type="button" class="quick-chip" onclick="setPresetJenisSoal()">Campuran</button>
                                </div>
                            </div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px 12px;">
                                <label style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: #334155; cursor: pointer;">
                                    <input type="checkbox" class="cb-soal-jenis" value="pg" checked style="transform: scale(1.1);">
                                    <span>Pilihan Ganda (PG 5 Opsi)</span>
                                </label>
                                <label style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: #334155; cursor: pointer;">
                                    <input type="checkbox" class="cb-soal-jenis" value="pg_kompleks" checked style="transform: scale(1.1);">
                                    <span>PG Kompleks (Multi Kunci)</span>
                                </label>
                                <label style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: #334155; cursor: pointer;">
                                    <input type="checkbox" class="cb-soal-jenis" value="tf" style="transform: scale(1.1);">
                                    <span>Benar / Salah (True/False)</span>
                                </label>
                                <label style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: #334155; cursor: pointer;">
                                    <input type="checkbox" class="cb-soal-jenis" value="menjodohkan" style="transform: scale(1.1);">
                                    <span>Menjodohkan (Matching)</span>
                                </label>
                                <label style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: #334155; cursor: pointer;">
                                    <input type="checkbox" class="cb-soal-jenis" value="short" style="transform: scale(1.1);">
                                    <span>Isian Singkat (Short Answer)</span>
                                </label>
                                <label style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: #334155; cursor: pointer;">
                                    <input type="checkbox" class="cb-soal-jenis" value="esai" style="transform: scale(1.1);">
                                    <span>Uraian / Esai (Essay Kasus)</span>
                                </label>
                            </div>
                        </div>

                        <!-- Level Kognitif Taksonomi Bloom (Multi-select) -->
                        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 6px; padding: 10px 12px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; flex-wrap: wrap; gap: 6px;">
                                <label style="font-weight: 700; font-size: 0.82rem; color: #1e293b; margin: 0;">
                                    <i class="fas fa-layer-group" style="color: #0284c7; margin-right: 4px;"></i> Level Kognitif Bloom
                                </label>
                                <div style="display: flex; gap: 4px;">
                                    <button type="button" class="quick-chip" onclick="setAllCheckboxes('cb-soal-kognitif', true)">Semua</button>
                                    <button type="button" class="quick-chip" onclick="setHotsOnly('cb-soal-kognitif')">Hanya HOTS</button>
                                    <button type="button" class="quick-chip" onclick="setBasicApplied('cb-soal-kognitif')">C1-C3</button>
                                </div>
                            </div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px 12px;">
                                <label style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: #334155; cursor: pointer;">
                                    <input type="checkbox" class="cb-soal-kognitif" value="C1" style="transform: scale(1.1);">
                                    <span><strong>C1</strong> - Mengingat</span>
                                </label>
                                <label style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: #334155; cursor: pointer;">
                                    <input type="checkbox" class="cb-soal-kognitif" value="C2" checked style="transform: scale(1.1);">
                                    <span><strong>C2</strong> - Memahami</span>
                                </label>
                                <label style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: #334155; cursor: pointer;">
                                    <input type="checkbox" class="cb-soal-kognitif" value="C3" checked style="transform: scale(1.1);">
                                    <span><strong>C3</strong> - Menerapkan</span>
                                </label>
                                <label style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: #334155; cursor: pointer;">
                                    <input type="checkbox" class="cb-soal-kognitif" value="C4" checked style="transform: scale(1.1);">
                                    <span><strong>C4</strong> - Menganalisis (HOTS)</span>
                                </label>
                                <label style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: #334155; cursor: pointer;">
                                    <input type="checkbox" class="cb-soal-kognitif" value="C5" style="transform: scale(1.1);">
                                    <span><strong>C5</strong> - Mengevaluasi (HOTS)</span>
                                </label>
                                <label style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: #334155; cursor: pointer;">
                                    <input type="checkbox" class="cb-soal-kognitif" value="C6" style="transform: scale(1.1);">
                                    <span><strong>C6</strong> - Mencipta (HOTS)</span>
                                </label>
                            </div>
                        </div>
                    <!-- SECTION 2: KONFIGURASI TEKNIS STIMULUS GAMBAR / DIAGRAM VISUAL (TERARAH, TIDAK ACAK) -->
                    <div style="background: #eff6ff; border: 1.5px solid #bfdbfe; border-radius: 10px; padding: 14px; margin-bottom: 14px;">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; border-bottom: 1px solid #dbeafe; padding-bottom: 8px;">
                            <div style="font-weight: 700; font-size: 0.9rem; color: #1e3a8a; display: flex; align-items: center; gap: 6px;">
                                <span style="background: #2563eb; color: #ffffff; width: 22px; height: 22px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 0.78rem;">2</span>
                                <span>Konfigurasi Stimulus Gambar / Diagram <span style="font-weight: 500; font-size: 0.8rem; color: #3b82f6;">(Opsional / Terarah)</span></span>
                            </div>
                            <span class="pill-badge" style="background: #dbeafe; color: #1d4ed8; border: 1px solid #bfdbfe; font-size: 0.75rem;">Vektor SVG Tajam</span>
                        </div>

                        <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer; font-size: 0.88rem; color: #1e40af; margin: 0;">
                            <input type="checkbox" id="ai-generate-gambar" checked onchange="toggleAiGambarConfig(this.checked)" style="margin-top: 3px; transform: scale(1.2);">
                            <div>
                                <strong style="font-size: 0.92rem;"><i class="fas fa-image"></i> Sisipkan Gambar / Diagram Stimulus dengan AI</strong>
                                <div style="font-size: 0.8rem; color: #2563eb; margin-top: 2px;">
                                    Diagram dibuat berbasis format vektor SVG beresolusi tinggi, diintegrasikan langsung sebagai acuan analisis naskah soal.
                                </div>
                            </div>
                        </label>

                        <!-- Panel Konfigurasi Kriteria Spesifik -->
                        <div id="ai-gambar-config-panel" style="margin-top: 12px; padding-top: 12px; border-top: 1px dashed #93c5fd;">
                            <!-- 1. Kriteria Target Soal yang Mendapat Gambar -->
                            <div style="margin-bottom: 12px;">
                                <label style="font-weight: 700; font-size: 0.82rem; color: #1e3a8a; display: block; margin-bottom: 4px;">
                                    <i class="fas fa-crosshairs" style="color: #2563eb;"></i> Kriteria Target Butir Soal Bergambar:
                                </label>
                                <select id="ai-gambar-target-mode" class="form-select" onchange="handleAiGambarTargetModeChange(this.value)" style="width: 100%; padding: 8px 10px; font-size: 0.85rem; border: 1.5px solid #93c5fd; border-radius: 6px; background: #ffffff;">
                                    <option value="hots_only" selected>⭐ Hanya Soal Studi Kasus / HOTS (C4 - C6) [Standar Akademik]</option>
                                    <option value="specific_types">🎯 Hanya Bentuk Soal Tertentu Saja (Tentukan di bawah)</option>
                                    <option value="custom_count">🔢 Batasi Berdasarkan Nomor (Hanya N butir kasus pertama)</option>
                                    <option value="all">🌐 Seluruh Butir Soal yang Di-generate</option>
                                </select>
                                <small style="display: block; font-size: 0.75rem; color: #1d4ed8; margin-top: 3px;">
                                    <i class="fas fa-circle-info"></i> Memastikan stimulus gambar hanya dipasangkan pada soal penalaran analisis, bukan soal hafalan/teori dasar.
                                </small>
                            </div>

                            <!-- Pilihan Bentuk Soal Spesifik (jika specific_types dipilih) -->
                            <div id="ai-gambar-specific-types-wrap" style="display: none; margin-bottom: 12px; background: #ffffff; border: 1px solid #bfdbfe; border-radius: 6px; padding: 10px 12px;">
                                <label style="font-weight: 600; font-size: 0.8rem; color: #1e40af; display: block; margin-bottom: 6px;">
                                    Pilih Bentuk Soal yang Diizinkan Mendapat Stimulus Gambar:
                                </label>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 6px 12px;">
                                    <label style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: #334155; cursor: pointer;">
                                        <input type="checkbox" class="cb-gambar-type" value="pg" checked onchange="updateAiGambarSummary()"> Pilihan Ganda (PG)
                                    </label>
                                    <label style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: #334155; cursor: pointer;">
                                        <input type="checkbox" class="cb-gambar-type" value="pg_kompleks" checked onchange="updateAiGambarSummary()"> PG Kompleks
                                    </label>
                                    <label style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: #334155; cursor: pointer;">
                                        <input type="checkbox" class="cb-gambar-type" value="esai" checked onchange="updateAiGambarSummary()"> Uraian / Esai Kasus
                                    </label>
                                    <label style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: #334155; cursor: pointer;">
                                        <input type="checkbox" class="cb-gambar-type" value="menjodohkan" onchange="updateAiGambarSummary()"> Menjodohkan
                                    </label>
                                </div>
                            </div>

                            <!-- 2. Kuota Maksimal & Gaya Diagram -->
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px;">
                                <div>
                                    <label style="font-weight: 700; font-size: 0.82rem; color: #1e3a8a; display: block; margin-bottom: 4px;">
                                        <i class="fas fa-calculator" style="color: #2563eb;"></i> Batas Kuota Gambar:
                                    </label>
                                    <select id="ai-gambar-max-count" class="form-select" onchange="updateAiGambarSummary()" style="width: 100%; padding: 8px 10px; font-size: 0.85rem; border: 1.5px solid #93c5fd; border-radius: 6px; background: #ffffff;">
                                        <option value="1">Maksimal 1 Butir Soal (Fokus 1 Kasus)</option>
                                        <option value="2" selected>Maksimal 2 Butir Soal (Proporsional)</option>
                                        <option value="3">Maksimal 3 Butir Soal</option>
                                        <option value="999">Semua yang Memenuhi Kriteria</option>
                                    </select>
                                </div>
                                <div>
                                    <label style="font-weight: 700; font-size: 0.82rem; color: #1e3a8a; display: block; margin-bottom: 4px;">
                                        <i class="fas fa-shapes" style="color: #2563eb;"></i> Gaya / Format Visual:
                                    </label>
                                    <select id="ai-gambar-style" class="form-select" onchange="updateAiGambarSummary()" style="width: 100%; padding: 8px 10px; font-size: 0.85rem; border: 1.5px solid #93c5fd; border-radius: 6px; background: #ffffff;">
                                        <option value="auto" selected>🤖 Otomatis Sesuai Materi</option>
                                        <option value="process">🔄 Alur Proses / Flowchart</option>
                                        <option value="architecture">🏗️ Arsitektur / Blok Sistem</option>
                                        <option value="network">🌐 Topologi Jaringan & Node</option>
                                        <option value="hierarchy">🌲 Hirarki / Pohon Konsep</option>
                                        <option value="venn">⭕ Diagram Relasi / Venn</option>
                                    </select>
                                </div>
                            </div>

                            <!-- 3. Instruksi Khusus Visual (Opsional) -->
                            <div style="margin-bottom: 10px;">
                                <label style="font-weight: 700; font-size: 0.82rem; color: #1e3a8a; display: block; margin-bottom: 4px;">
                                    <i class="fas fa-pen-nib" style="color: #2563eb;"></i> Instruksi Khusus Visual / Diagram (Opsional):
                                </label>
                                <input type="text" id="ai-gambar-custom-prompt" placeholder="Contoh: Skema topologi client-server mikrotik, alur SDLC, siklus audit..." class="form-control" oninput="updateAiGambarSummary()" style="width: 100%; padding: 8px 10px; font-size: 0.85rem; border: 1.5px solid #93c5fd; border-radius: 6px; background: #ffffff;">
                            </div>

                            <!-- Live Summary Chip -->
                            <div id="ai-gambar-summary-box" style="background: #dbeafe; border-radius: 6px; padding: 7px 12px; font-size: 0.78rem; color: #1e40af; display: flex; align-items: center; gap: 8px;">
                                <i class="fas fa-bullseye" style="font-size: 0.95rem; color: #2563eb;"></i>
                                <span id="ai-gambar-summary-text">Stimulus gambar hanya akan dipasangkan ke butir soal HOTS (C4-C6), maksimal 2 butir soal, tanpa penempatan acak.</span>
                            </div>
                        </div>
                    </div>

                    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 14px; margin-bottom: 16px;">
                        <label style="display: flex; align-items: flex-start; gap: 8px; cursor: pointer; font-size: 0.88rem; color: #334155; margin: 0;">
                            <input type="checkbox" id="ai-auto-save" checked style="margin-top: 3px; transform: scale(1.15);">
                            <span><strong>Langsung Simpan Permanen:</strong> Butir soal langsung disimpan ke database ujian ini secara otomatis, tidak akan hilang saat reload.</span>
                        </label>
                    </div>

                    <div id="ai-status" style="display: none; padding: 12px; margin-top: 10px; border-radius: 8px; font-size: 0.9rem;"></div>

                    <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; border-top: 1px solid #f1f5f9; padding-top: 16px;">
                        <button type="button" class="btn btn-secondary" onclick="closeModal('ai-modal')" style="padding: 10px 18px; border-radius: 8px;">Tutup</button>
                        <button type="submit" class="btn btn-accent" id="btn-generate-ai" style="padding: 10px 22px; border-radius: 8px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                            <i class="fas fa-sparkles"></i> Generate & Simpan Permanen
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL 4: KONFIRMASI HAPUS SOAL -->
    <div id="modalDeleteSoalOverlay" class="custom-modal-overlay">
        <div class="custom-modal-card" style="max-width: 440px;">
            <div class="custom-modal-header">
                <h3 style="color: #dc2626;"><i class="fas fa-trash"></i> Hapus Butir Soal</h3>
                <button type="button" class="close-modal-btn" onclick="closeConfirmDeleteSoal()">&times;</button>
            </div>
            <div class="custom-modal-body">
                <p style="color: #334155; margin: 0 0 16px; font-size: 0.95rem; line-height: 1.5;">
                    Apakah Anda yakin ingin menghapus butir soal <strong id="deleteSoalNumber"></strong> ini?
                </p>
                <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 12px 14px; color: #991b1b; font-size: 0.85rem; margin-bottom: 20px;">
                    <i class="fas fa-triangle-exclamation" style="margin-right: 6px;"></i> Butir soal beserta opsi jawabannya akan dihapus secara permanen.
                </div>

                <form method="POST" action="/admin/soal">
                    <input type="hidden" name="action" value="delete">
                    <input type="hidden" name="id_ujian" value="<%= selectedUjianId %>">
                    <input type="hidden" name="soal_id" id="deleteSoalId">

                    <div style="display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid #f1f5f9; padding-top: 16px;">
                        <button type="button" class="btn btn-secondary" onclick="closeConfirmDeleteSoal()" style="padding: 10px 18px; border-radius: 8px;">Batal</button>
                        <button type="submit" class="btn btn-primary" style="background: #dc2626; border: none; padding: 10px 22px; border-radius: 8px; font-weight: 600;">
                            <i class="fas fa-trash"></i> Ya, Hapus Soal
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        function confirmDelete(msg) {
            try {
                return window.confirm(msg);
            } catch (e) {
                return true;
            }
        }

        const soalListDb = <%- JSON.stringify(soalList) %>;

        function openEditSoalModalById(soalId) {
            const soal = soalListDb.find(s => s.id === Number(soalId));
            if (!soal) return;
            openEditSoalModal(soal);
        }

        function openModal(id) {
            document.getElementById(id).style.display = 'flex';
        }
        function closeModal(id) {
            document.getElementById(id).style.display = 'none';
        }

        function openConfirmDeleteSoal(id, no) {
            document.getElementById('deleteSoalId').value = id;
            document.getElementById('deleteSoalNumber').innerText = 'Nomor ' + no;
            document.getElementById('modalDeleteSoalOverlay').style.display = 'flex';
        }

        function closeConfirmDeleteSoal() {
            document.getElementById('modalDeleteSoalOverlay').style.display = 'none';
        }

        function switchSoalType(type, prefix) {
            const pgContainer = document.getElementById(prefix + '_type_pg_container');
            const pgkContainer = document.getElementById(prefix + '_type_pg_kompleks_container');
            const tfContainer = document.getElementById(prefix + '_type_tf_container');
            const matchContainer = document.getElementById(prefix + '_type_menjodohkan_container');
            const shortContainer = document.getElementById(prefix + '_type_short_container');
            const esaiContainer = document.getElementById(prefix + '_type_esai_container');

            if (pgContainer) pgContainer.style.display = (type === 'pg') ? 'block' : 'none';
            if (pgkContainer) pgkContainer.style.display = (type === 'pg_kompleks' || type === 'multiple') ? 'block' : 'none';
            if (tfContainer) tfContainer.style.display = (type === 'tf') ? 'block' : 'none';
            if (matchContainer) matchContainer.style.display = (type === 'menjodohkan' || type === 'matching') ? 'block' : 'none';
            if (shortContainer) shortContainer.style.display = (type === 'short' || type === 'isian') ? 'block' : 'none';
            if (esaiContainer) esaiContainer.style.display = (type === 'esai' || type === 'essay') ? 'block' : 'none';
        }

        function addMatchingRow(wrapId) {
            const wrap = document.getElementById(wrapId);
            if (!wrap) return;
            const count = wrap.querySelectorAll('.matching-pair-row').length + 1;
            const row = document.createElement('div');
            row.className = 'matching-pair-row';
            row.style.cssText = 'display: flex; gap: 8px; align-items: center;';
            row.innerHTML = `
                <span style="font-weight: 700; color: #9333ea; width: 20px;">${count}.</span>
                <input type="text" name="matching_keys[]" placeholder="Premis ${count} (Kolom Kiri)" class="form-control" style="flex: 1; padding: 8px 10px; border: 1.5px solid #cbd5e1; border-radius: 6px;">
                <span style="color: #a855f7;"><i class="fas fa-arrow-right"></i></span>
                <input type="text" name="matching_values[]" placeholder="Kunci Pasangan ${count} (Kolom Kanan)" class="form-control" style="flex: 1; padding: 8px 10px; border: 1.5px solid #cbd5e1; border-radius: 6px;">
            `;
            wrap.appendChild(row);
        }

        function openEditSoalModal(soal) {
            document.getElementById('edit_soal_id').value = soal.id;
            document.getElementById('edit_soal_poin').value = soal.poin || 4;
            document.getElementById('edit_soal_kesulitan').value = soal.tingkat_kesulitan || 'sedang';
            document.getElementById('edit_soal_kognitif').value = soal.level_kognitif || 'C1';
            document.getElementById('edit_soal_pertanyaan').value = (soal.pertanyaan || '').replace(/<[^>]*>?/gm, '');
            document.getElementById('edit_soal_pembahasan').value = soal.pembahasan || '';

            // Handle Question Image in Edit Modal
            const gUrl = soal.gambar || soal.gambar_soal || '';
            const editUrlInput = document.getElementById('edit_gambar_url');
            const editPreviewBox = document.getElementById('edit_gambar_preview_box');
            const editPreviewImg = document.getElementById('edit_gambar_preview_img');
            const editFileInput = document.getElementById('edit_gambar_file');
            const editStatusMsg = document.getElementById('edit_gambar_status_msg');
            if (editFileInput) editFileInput.value = '';
            if (editStatusMsg) editStatusMsg.style.display = 'none';

            if (gUrl) {
                if (editUrlInput) editUrlInput.value = gUrl;
                if (editPreviewImg) editPreviewImg.src = gUrl;
                if (editPreviewBox) editPreviewBox.style.display = 'block';
            } else {
                if (editUrlInput) editUrlInput.value = '';
                if (editPreviewImg) editPreviewImg.src = '';
                if (editPreviewBox) editPreviewBox.style.display = 'none';
            }

            let jType = (soal.jenis_soal || 'pg').toLowerCase();
            if (jType === 'multiple') jType = 'pg_kompleks';
            if (jType === 'matching') jType = 'menjodohkan';
            if (jType === 'isian') jType = 'short';
            if (jType === 'essay') jType = 'esai';

            const editSelect = document.getElementById('edit_soal_jenis');
            if (editSelect) editSelect.value = jType;
            switchSoalType(jType, 'edit');

            // Populate PG
            if (jType === 'pg') {
                const opsi = soal.opsi || [];
                for (let idx = 0; idx < 5; idx++) {
                    const textInput = document.getElementById('edit_opsi_teks_' + idx);
                    const radioInput = document.getElementById('edit_opsi_benar_' + idx);
                    const o = opsi[idx];
                    if (textInput) textInput.value = o ? (o.teks_opsi || o.teks || '') : '';
                    if (radioInput) radioInput.checked = Boolean(o && o.benar);
                }
            }

            // Populate PG Kompleks
            if (jType === 'pg_kompleks') {
                const opsi = soal.opsi || [];
                for (let idx = 0; idx < 5; idx++) {
                    const textInput = document.getElementById('edit_pgk_opsi_teks_' + idx);
                    const cbInput = document.getElementById('edit_pgk_opsi_benar_' + idx);
                    const o = opsi[idx];
                    if (textInput) textInput.value = o ? (o.teks_opsi || o.teks || '') : '';
                    if (cbInput) cbInput.checked = Boolean(o && o.benar);
                }
            }

            // Populate TF (Benar / Salah)
            if (jType === 'tf') {
                let isTrue = true;
                if (soal.data_tambahan && typeof soal.data_tambahan.jawaban_benar === 'boolean') {
                    isTrue = soal.data_tambahan.jawaban_benar;
                } else if (soal.opsi && Array.isArray(soal.opsi)) {
                    const falseOpt = soal.opsi.find(o => o.benar && (o.teks || o.teks_opsi || '').toLowerCase().includes('salah'));
                    if (falseOpt) isTrue = false;
                }
                const radioTrue = document.getElementById('edit_tf_true');
                const radioFalse = document.getElementById('edit_tf_false');
                if (radioTrue && radioFalse) {
                    radioTrue.checked = (isTrue === true);
                    radioFalse.checked = (isTrue === false);
                }
            }

            // Populate Menjodohkan
            if (jType === 'menjodohkan') {
                const wrap = document.getElementById('edit_matching_rows_wrap');
                if (wrap) {
                    wrap.innerHTML = '';
                    const pairs = (soal.data_tambahan && soal.data_tambahan.pairs) || soal.matching_pairs || {};
                    let entries = Object.entries(pairs);
                    if (entries.length === 0) entries = [['', ''], ['', ''], ['', '']];
                    entries.forEach(([k, v], idx) => {
                        const row = document.createElement('div');
                        row.className = 'matching-pair-row';
                        row.style.cssText = 'display: flex; gap: 8px; align-items: center;';
                        row.innerHTML = `
                            <span style="font-weight: 700; color: #9333ea; width: 20px;">${idx + 1}.</span>
                            <input type="text" name="matching_keys[]" value="${(k || '').replace(/"/g, '&quot;')}" placeholder="Premis (Kiri)" class="form-control" style="flex: 1; padding: 8px 10px; border: 1.5px solid #cbd5e1; border-radius: 6px;">
                            <span style="color: #a855f7;"><i class="fas fa-arrow-right"></i></span>
                            <input type="text" name="matching_values[]" value="${(v || '').replace(/"/g, '&quot;')}" placeholder="Kunci Pasangan (Kanan)" class="form-control" style="flex: 1; padding: 8px 10px; border: 1.5px solid #cbd5e1; border-radius: 6px;">
                        `;
                        wrap.appendChild(row);
                    });
                }
            }

            // Populate Short / Isian Singkat
            if (jType === 'short') {
                const kwInput = document.getElementById('edit_soal_keywords_short');
                if (kwInput) {
                    let kw = (soal.data_tambahan && soal.data_tambahan.keywords) || '';
                    if (!kw && soal.opsi && Array.isArray(soal.opsi)) {
                        kw = soal.opsi.filter(o => o.benar).map(o => o.teks_opsi || o.teks || '').join(', ');
                    }
                    kwInput.value = kw;
                }
            }

            // Populate Esai / Uraian
            if (jType === 'esai') {
                const kwTextarea = document.getElementById('edit_soal_keywords_esai');
                if (kwTextarea) {
                    kwTextarea.value = (soal.data_tambahan && soal.data_tambahan.keywords) || '';
                }
            }

            openModal('edit-soal-modal');
        }

        // Image Attachment & AI Generator Handlers
        async function handleImageFileSelected(input, prefix) {
            if (!input.files || !input.files[0]) return;
            const file = input.files[0];
            const previewBox = document.getElementById(prefix + '_gambar_preview_box');
            const previewImg = document.getElementById(prefix + '_gambar_preview_img');
            const urlInput = document.getElementById(prefix + '_gambar_url');

            // Show instant local preview
            const reader = new FileReader();
            reader.onload = function(e) {
                if (previewImg) previewImg.src = e.target.result;
                if (previewBox) previewBox.style.display = 'block';
            };
            reader.readAsDataURL(file);

            // Asynchronously upload to server for permanent URL storage
            try {
                const formData = new FormData();
                formData.append('image', file);
                const res = await fetch('/admin/upload_soal_image', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success && data.url) {
                    if (urlInput) urlInput.value = data.url;
                }
            } catch (e) {
                console.warn('Upload image async note:', e);
            }
        }

        function handleImageUrlInput(val, prefix) {
            const previewBox = document.getElementById(prefix + '_gambar_preview_box');
            const previewImg = document.getElementById(prefix + '_gambar_preview_img');
            const clean = (val || '').trim();
            if (clean && (clean.startsWith('http://') || clean.startsWith('https://') || clean.startsWith('/') || clean.startsWith('data:image/'))) {
                if (previewImg) previewImg.src = clean;
                if (previewBox) previewBox.style.display = 'block';
            } else if (!clean) {
                const fileInput = document.getElementById(prefix + '_gambar_file');
                if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
                    if (previewBox) previewBox.style.display = 'none';
                }
            }
        }

        function removeQuestionImage(prefix) {
            const fileInput = document.getElementById(prefix + '_gambar_file');
            const urlInput = document.getElementById(prefix + '_gambar_url');
            const previewBox = document.getElementById(prefix + '_gambar_preview_box');
            const previewImg = document.getElementById(prefix + '_gambar_preview_img');
            const statusMsg = document.getElementById(prefix + '_gambar_status_msg');

            if (fileInput) fileInput.value = '';
            if (urlInput) urlInput.value = '';
            if (previewImg) previewImg.src = '';
            if (previewBox) previewBox.style.display = 'none';

            if (statusMsg) {
                statusMsg.style.display = 'block';
                statusMsg.style.background = '#fef2f2';
                statusMsg.style.border = '1px solid #fecaca';
                statusMsg.style.color = '#b91c1c';
                statusMsg.innerHTML = '<i class="fas fa-trash"></i> Gambar stimulus telah dilepas. Klik Simpan untuk memperbarui.';
            }
        }

        // Open Dedicated In-Page Modal for AI Image Generation (iFrame safe, zero window.prompt)
        function openAiImageGeneratorModal(prefix) {
            const targetPrefixInput = document.getElementById('single_ai_img_target_prefix');
            if (targetPrefixInput) targetPrefixInput.value = prefix;

            const pertInput = prefix === 'edit'
                ? document.getElementById('edit_soal_pertanyaan')
                : document.querySelector('#create-soal-modal textarea[name="pertanyaan"]');
            const currentText = pertInput ? pertInput.value.trim() : '';
            const defaultTopic = "<%= currentUjian ? (currentUjian.nama_mk || currentUjian.judul_ujian) : 'Diagram Konseptual Akademik' %>";

            const promptInput = document.getElementById('single_ai_img_prompt');
            if (promptInput) {
                promptInput.value = currentText.substring(0, 90) || defaultTopic;
            }

            const banner = document.getElementById('single_ai_img_banner');
            const existingUrl = document.getElementById(prefix + '_gambar_url') ? document.getElementById(prefix + '_gambar_url').value : '';
            if (banner) {
                if (existingUrl) {
                    banner.innerHTML = '<i class="fas fa-arrows-rotate"></i> <strong>Mode Ganti / Regenerate:</strong> Butir soal ini sudah memiliki stimulus gambar. Diagram baru dari AI akan langsung menggantikan gambar saat ini.';
                    banner.style.background = '#fef3c7';
                    banner.style.borderColor = '#fde68a';
                    banner.style.color = '#92400e';
                } else {
                    banner.innerHTML = '<i class="fas fa-wand-magic-sparkles"></i> <strong>Rancang Diagram Stimulus:</strong> Tuliskan topik atau konsep visual diagram yang ingin dibuat oleh AI.';
                    banner.style.background = '#eff6ff';
                    banner.style.borderColor = '#bfdbfe';
                    banner.style.color = '#1e40af';
                }
            }

            const statusBox = document.getElementById('single_ai_img_status');
            if (statusBox) statusBox.style.display = 'none';

            const btn = document.getElementById('btn_execute_single_ai_img');
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-sparkles"></i> Rancang & Terapkan Gambar';
            }

            openModal('ai-single-img-modal');
        }

        // Backward compatibility
        function triggerAiGenerateImage(prefix) {
            openAiImageGeneratorModal(prefix);
        }

        // Execute AI Image Generation with full resilience
        async function executeSingleAiImageGenerate() {
            const prefix = document.getElementById('single_ai_img_target_prefix').value || 'edit';
            const promptInput = document.getElementById('single_ai_img_prompt');
            const styleInput = document.getElementById('single_ai_img_style');
            const statusBox = document.getElementById('single_ai_img_status');
            const btn = document.getElementById('btn_execute_single_ai_img');

            const promptVal = promptInput ? promptInput.value.trim() : '';
            const styleVal = styleInput ? styleInput.value : 'auto';
            const defaultTopic = "<%= currentUjian ? (currentUjian.nama_mk || currentUjian.judul_ujian) : 'Diagram Konseptual Akademik' %>";

            const pertInput = prefix === 'edit'
                ? document.getElementById('edit_soal_pertanyaan')
                : document.querySelector('#create-soal-modal textarea[name="pertanyaan"]');
            const currentText = pertInput ? pertInput.value.trim() : '';
            const soalId = prefix === 'edit' ? (document.getElementById('edit_soal_id') ? document.getElementById('edit_soal_id').value : null) : null;

            if (!promptVal) {
                if (statusBox) {
                    statusBox.style.display = 'block';
                    statusBox.style.background = '#fee2e2';
                    statusBox.style.border = '1px solid #fecaca';
                    statusBox.style.color = '#dc2626';
                    statusBox.innerHTML = '<i class="fas fa-triangle-exclamation"></i> Masukkan deskripsi diagram terlebih dahulu.';
                }
                return;
            }

            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Merancang Diagram SVG...';
            }
            if (statusBox) {
                statusBox.style.display = 'block';
                statusBox.style.background = '#eef6fc';
                statusBox.style.border = '1px solid #bfdbfe';
                statusBox.style.color = '#1e40af';
                statusBox.innerHTML = '<i class="fas fa-brain fa-fade" style="margin-right: 6px;"></i> AI sedang merancang diagram vektor SVG presisi tinggi...';
            }

            try {
                const res = await fetch('/admin/generate_soal_image_ai', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        prompt: promptVal,
                        topik: defaultTopic,
                        pertanyaan: currentText,
                        style: styleVal,
                        soal_id: soalId
                    })
                });
                const data = await res.json();
                if (data.success && data.url) {
                    const urlInput = document.getElementById(prefix + '_gambar_url');
                    const previewBox = document.getElementById(prefix + '_gambar_preview_box');
                    const previewImg = document.getElementById(prefix + '_gambar_preview_img');
                    const fileInput = document.getElementById(prefix + '_gambar_file');

                    if (urlInput) urlInput.value = data.url;
                    if (previewImg) previewImg.src = data.url;
                    if (previewBox) previewBox.style.display = 'block';
                    if (fileInput) fileInput.value = '';

                    const statusMsg = document.getElementById(prefix + '_gambar_status_msg');
                    if (statusMsg) {
                        statusMsg.style.display = 'block';
                        statusMsg.style.background = '#dcfce7';
                        statusMsg.style.border = '1px solid #bbf7d0';
                        statusMsg.style.color = '#15803d';
                        statusMsg.innerHTML = '<i class="fas fa-check-circle"></i> <strong>Berhasil!</strong> Diagram stimulus AI baru telah dipasang. Klik "Simpan Perubahan" untuk memfinalisasi.';
                    }

                    closeModal('ai-single-img-modal');
                } else {
                    if (statusBox) {
                        statusBox.style.display = 'block';
                        statusBox.style.background = '#fee2e2';
                        statusBox.style.border = '1px solid #fecaca';
                        statusBox.style.color = '#dc2626';
                        statusBox.innerHTML = '<i class="fas fa-circle-xmark"></i> ' + (data.message || 'Gagal merancang gambar.');
                    }
                }
            } catch (err) {
                if (statusBox) {
                    statusBox.style.display = 'block';
                    statusBox.style.background = '#fee2e2';
                    statusBox.style.border = '1px solid #fecaca';
                    statusBox.style.color = '#dc2626';
                    statusBox.innerHTML = '<i class="fas fa-circle-xmark"></i> Terjadi kendala teknis: ' + err.message;
                }
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-sparkles"></i> Rancang & Terapkan Gambar';
                }
            }
        }

        // Dropdown Cetak Handler
        function toggleCetakMenuSoal(e) {
            e.stopPropagation();
            const menu = document.getElementById('cetakDropdownSoal');
            if (menu) menu.classList.toggle('show');
        }

        // Checkbox helpers for multi-select jenis soal & bloom levels
        function setAllCheckboxes(className, checked) {
            document.querySelectorAll('.' + className).forEach(cb => cb.checked = checked);
        }

        function setOnlyCheckbox(className, targetVal) {
            document.querySelectorAll('.' + className).forEach(cb => {
                cb.checked = (cb.value === targetVal);
            });
        }

        function setPresetJenisSoal() {
            document.querySelectorAll('.cb-soal-jenis').forEach(cb => {
                cb.checked = ['pg', 'esai', 'tf'].includes(cb.value);
            });
        }

        function setHotsOnly(className) {
            document.querySelectorAll('.' + className).forEach(cb => {
                cb.checked = ['C4', 'C5', 'C6'].includes(cb.value);
            });
        }

        function setBasicApplied(className) {
            document.querySelectorAll('.' + className).forEach(cb => {
                cb.checked = ['C1', 'C2', 'C3'].includes(cb.value);
            });
        }

        // Helpers for Targeted AI Question & Stimulus Image Generation
        function toggleAiGambarConfig(checked) {
            const panel = document.getElementById('ai-gambar-config-panel');
            if (panel) panel.style.display = checked ? 'block' : 'none';
            updateAiGambarSummary();
        }

        function handleAiGambarTargetModeChange(val) {
            const typesWrap = document.getElementById('ai-gambar-specific-types-wrap');
            if (typesWrap) {
                typesWrap.style.display = (val === 'specific_types') ? 'block' : 'none';
            }
            updateAiGambarSummary();
        }

        function updateAiGambarSummary() {
            const summaryText = document.getElementById('ai-gambar-summary-text');
            const chk = document.getElementById('ai-generate-gambar');
            const totalCount = parseInt(document.getElementById('ai-count') ? document.getElementById('ai-count').value : '5', 10) || 5;
            if (!summaryText) return;

            if (!chk || !chk.checked) {
                summaryText.innerHTML = `<strong>Teks Murni (Tanpa Gambar):</strong> Seluruh ${totalCount} butir naskah soal akan disusun sebagai teks mandiri (self-contained) tanpa stimulus gambar.`;
                return;
            }

            const targetMode = document.getElementById('ai-gambar-target-mode') ? document.getElementById('ai-gambar-target-mode').value : 'hots_only';
            const rawMax = parseInt(document.getElementById('ai-gambar-max-count') ? document.getElementById('ai-gambar-max-count').value : '2', 10) || 2;
            const maxGambar = Math.min(totalCount, rawMax);
            const style = document.getElementById('ai-gambar-style') ? document.getElementById('ai-gambar-style').value : 'auto';
            const customPrompt = document.getElementById('ai-gambar-custom-prompt') ? document.getElementById('ai-gambar-custom-prompt').value.trim() : '';

            let targetDesc = '';
            if (targetMode === 'hots_only') {
                targetDesc = 'hanya butir soal <strong>HOTS (C4-C6)</strong>';
            } else if (targetMode === 'specific_types') {
                const types = getCheckedValues('cb-gambar-type', ['pg']);
                const typeLabels = types.map(t => {
                    if (t === 'pg') return 'PG';
                    if (t === 'pg_kompleks') return 'PG Kompleks';
                    if (t === 'esai') return 'Esai';
                    if (t === 'menjodohkan') return 'Menjodohkan';
                    return t;
                }).join(', ');
                targetDesc = `hanya bentuk <strong>[${typeLabels || 'PG'}]</strong>`;
            } else if (targetMode === 'custom_count') {
                targetDesc = `hanya untuk <strong>${maxGambar} butir pertama</strong>`;
            } else {
                targetDesc = 'seluruh butir soal yang di-generate';
            }

            let styleDesc = '';
            if (style === 'process') styleDesc = 'Alur Proses / Flowchart';
            else if (style === 'architecture') styleDesc = 'Arsitektur Sistem';
            else if (style === 'network') styleDesc = 'Topologi Jaringan';
            else if (style === 'hierarchy') styleDesc = 'Pohon Hirarki';
            else if (style === 'venn') styleDesc = 'Diagram Venn';
            else styleDesc = 'Otomatis Sesuai Materi';

            const textOnlyCount = Math.max(0, totalCount - maxGambar);
            let summary = `<strong>Distribusi:</strong> Maksimal <strong>${maxGambar} butir</strong> bergambar (${targetDesc}, format: <em>${styleDesc}</em>)`;
            if (textOnlyCount > 0) {
                summary += ` & <strong>${textOnlyCount} butir</strong> naskah teks mandiri (tanpa gambar).`;
            } else {
                summary += `.`;
            }
            if (customPrompt) {
                summary += ` <em>(Fokus: "${customPrompt}")</em>`;
            }
            summaryText.innerHTML = summary;
        }

        function getCheckedValues(className, defaultValues = []) {
            const checked = Array.from(document.querySelectorAll('.' + className + ':checked')).map(cb => cb.value);
            return checked.length > 0 ? checked : defaultValues;
        }

        async function handleAiGenerate(e) {
            e.preventDefault();
            const btn = document.getElementById('btn-generate-ai');
            const status = document.getElementById('ai-status');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Menyusun Soal Akademik...';
            status.style.display = 'block';
            status.style.background = '#eef6fc';
            status.style.color = '#1e429f';
            status.innerHTML = '<i class="fas fa-brain fa-fade" style="margin-right: 6px;"></i> AI sedang menyusun butir soal terarah, stimulus diagram presisi, dan kunci valid...';

            const autoSave = document.getElementById('ai-auto-save') ? document.getElementById('ai-auto-save').checked : true;
            const generateGambar = document.getElementById('ai-generate-gambar') ? document.getElementById('ai-generate-gambar').checked : true;
            const gambarTargetMode = document.getElementById('ai-gambar-target-mode') ? document.getElementById('ai-gambar-target-mode').value : 'hots_only';
            const gambarTargetTypes = getCheckedValues('cb-gambar-type', ['pg', 'pg_kompleks', 'esai']);
            const gambarMaxCount = parseInt(document.getElementById('ai-gambar-max-count') ? document.getElementById('ai-gambar-max-count').value : '2', 10) || 2;
            const gambarStyle = document.getElementById('ai-gambar-style') ? document.getElementById('ai-gambar-style').value : 'auto';
            const gambarCustomPrompt = document.getElementById('ai-gambar-custom-prompt') ? document.getElementById('ai-gambar-custom-prompt').value.trim() : '';
            const gayaNaskah = document.getElementById('ai-gaya-naskah') ? document.getElementById('ai-gaya-naskah').value : 'kasus';

            const jenisSoalList = getCheckedValues('cb-soal-jenis', ['pg']);
            const kognitifList = getCheckedValues('cb-soal-kognitif', ['C2', 'C3', 'C4']);

            try {
                const res = await fetch('/admin/ai_generate_api', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        ujian_id: '<%= selectedUjianId %>',
                        topik: document.getElementById('ai-topic').value,
                        sub_topik: document.getElementById('ai-subtopic') ? document.getElementById('ai-subtopic').value : '',
                        gaya_naskah: gayaNaskah,
                        jenis_soal_list: jenisSoalList,
                        kognitif_list: kognitifList,
                        jumlah: parseInt(document.getElementById('ai-count').value, 10) || 5,
                        poin: parseInt(document.getElementById('ai-poin').value, 10) || 4,
                        kesulitan: document.getElementById('ai-kesulitan').value,
                        generate_gambar: generateGambar,
                        gambar_target_mode: gambarTargetMode,
                        gambar_target_types: gambarTargetTypes,
                        gambar_max_count: gambarMaxCount,
                        gambar_style: gambarStyle,
                        gambar_custom_prompt: gambarCustomPrompt,
                        apply: autoSave
                    })
                });
                const result = await res.json();
                if (result.success || (Array.isArray(result) && result.length > 0)) {
                    const count = result.count || (Array.isArray(result) ? result.length : 1);
                    status.style.background = '#dcfce7';
                    status.style.color = '#15803d';
                    status.innerHTML = `<i class="fas fa-circle-check" style="margin-right: 6px;"></i> Berhasil menghasilkan <strong>${count}</strong> butir soal siap uji dan tersimpan permanen! Memperbarui halaman...`;
                    setTimeout(() => window.location.reload(), 850);
                } else {
                    throw new Error(result.message || 'Format output AI tidak valid');
                }
            } catch (err) {
                status.style.background = '#fee2e2';
                status.style.color = '#b91c1c';
                status.innerHTML = '<i class="fas fa-circle-exclamation" style="margin-right: 6px;"></i> Gagal menghasilkan soal: ' + err.message;
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-sparkles"></i> Generate & Simpan Permanen';
            }
        }

        // Searchable Custom Select Penilaian in Soal
        function toggleSearchablePenilaianSoal(e) {
            e.stopPropagation();
            const dd = document.getElementById('dropdownPilihPenilaianSoal');
            const chevron = document.getElementById('chevronPenilaianSoal');
            const isShown = dd.classList.contains('show');
            if (isShown) {
                dd.classList.remove('show');
                if (chevron) chevron.style.transform = 'rotate(0deg)';
            } else {
                dd.classList.add('show');
                if (chevron) chevron.style.transform = 'rotate(180deg)';
                const input = document.getElementById('searchPenilaianSoalInput');
                if (input) {
                    input.value = '';
                    filterOptionsPenilaianSoal('');
                    setTimeout(() => input.focus(), 60);
                }
            }
        }

        function filterOptionsPenilaianSoal(query) {
            const q = (query || '').toLowerCase().trim();
            const items = document.querySelectorAll('#listPenilaianSoal .searchable-option-item');
            let matchCount = 0;
            items.forEach(item => {
                const title = item.getAttribute('data-title') || '';
                if (title.includes(q)) {
                    item.style.display = 'flex';
                    matchCount++;
                } else {
                    item.style.display = 'none';
                }
            });
            const emptyHint = document.getElementById('emptyPenilaianSoalHint');
            if (emptyHint) {
                emptyHint.style.display = matchCount === 0 ? 'block' : 'none';
            }
        }

        function selectPenilaianSoal(ujianId) {
            window.location.href = '/admin/soal?ujian_id=' + ujianId;
        }

        window.addEventListener('click', function(e) {
            if (e.target.classList.contains('custom-modal-overlay')) {
                e.target.style.display = 'none';
            }
            const cetakMenu = document.getElementById('cetakDropdownSoal');
            if (cetakMenu && cetakMenu.classList.contains('show') && !e.target.closest('.dropdown-cetak')) {
                cetakMenu.classList.remove('show');
            }
            const wrapPenilaian = document.getElementById('wrapPilihPenilaianSoal');
            if (wrapPenilaian && !wrapPenilaian.contains(e.target)) {
                const dd = document.getElementById('dropdownPilihPenilaianSoal');
                const chevron = document.getElementById('chevronPenilaianSoal');
                if (dd) dd.classList.remove('show');
                if (chevron) chevron.style.transform = 'rotate(0deg)';
            }
        });

        window.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.custom-modal-overlay').forEach(m => m.style.display = 'none');
            }
        });
    </script>
</body>
</html>
