                        <div style="display: flex; gap: 6px;">
                            <button type="button" class="btn btn-sm btn-outline-secondary" style="padding: 2px 8px; font-size: 0.75rem; border-radius: 4px;" onclick="setAllCheckboxes('soal_jenis_cb', true)">Pilih Semua</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" style="padding: 2px 8px; font-size: 0.75rem; border-radius: 4px;" onclick="setOnlyOneCheckbox('soal_jenis_cb', 'pg')">PG Saja</button>
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px;">
                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="soal_jenis" class="soal_jenis_cb" value="pg" checked>
                            <span><strong>Pilihan Ganda (PG)</strong></span>
