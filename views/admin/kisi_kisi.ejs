                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="soal_jenis" class="soal_jenis_cb" value="pg_kompleks">
                            <span><strong>PG Kompleks</strong></span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="soal_jenis" class="soal_jenis_cb" value="tf">
