                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; flex-wrap: wrap; gap: 6px;">
                        <label style="font-weight: 600; font-size: 0.9rem; margin: 0; color: #1e293b;">
                            <i class="fas fa-layer-group" style="color: #1e5631;"></i> Pilihan Jenis Soal <span style="font-size: 0.8rem; font-weight: normal; color: #64748b;">(Bisa pilih lebih dari satu)</span>
                        </label>
                        <div style="display: flex; gap: 6px;">
                            <button type="button" class="btn btn-sm btn-outline-secondary" style="padding: 2px 8px; font-size: 0.75rem; border-radius: 4px;" onclick="setAllCheckboxes('kisi_jenis_cb', true)">Pilih Semua</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" style="padding: 2px 8px; font-size: 0.75rem; border-radius: 4px;" onclick="setOnlyOneCheckbox('kisi_jenis_cb', 'pg')">PG Saja</button>
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px;">
                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="kisi_jenis" class="kisi_jenis_cb" value="pg" checked>
                            <span><strong>Pilihan Ganda (PG)</strong></span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="kisi_jenis" class="kisi_jenis_cb" value="pg_kompleks">
                            <span><strong>PG Kompleks</strong></span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="kisi_jenis" class="kisi_jenis_cb" value="tf">
                            <span><strong>Benar / Salah (TF)</strong></span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="kisi_jenis" class="kisi_jenis_cb" value="menjodohkan">
                            <span><strong>Menjodohkan</strong></span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="kisi_jenis" class="kisi_jenis_cb" value="short">
                            <span><strong>Isian Singkat</strong></span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="kisi_jenis" class="kisi_jenis_cb" value="esai">
                            <span><strong>Uraian / Esai</strong></span>
                        </label>
                    </div>
                </div>

                <!-- LEVEL KOGNITIF BLOOM (MULTI-SELECT) -->
                <div class="form-group" style="margin-bottom: 18px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 14px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; flex-wrap: wrap; gap: 6px;">
                        <label style="font-weight: 600; font-size: 0.9rem; margin: 0; color: #1e293b;">
                            <i class="fas fa-brain" style="color: #0284c7;"></i> Level Kognitif Taksonomi Bloom <span style="font-size: 0.8rem; font-weight: normal; color: #64748b;">(Bisa pilih lebih dari satu)</span>
                        </label>
                        <div style="display: flex; gap: 6px;">
                            <button type="button" class="btn btn-sm btn-outline-secondary" style="padding: 2px 8px; font-size: 0.75rem; border-radius: 4px;" onclick="setAllCheckboxes('kisi_bloom_cb', true)">Semua C1-C6</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" style="padding: 2px 8px; font-size: 0.75rem; border-radius: 4px;" onclick="setPresetCheckboxes('kisi_bloom_cb', ['C2','C3','C4'])">Terapan C2-C4</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" style="padding: 2px 8px; font-size: 0.75rem; border-radius: 4px;" onclick="setPresetCheckboxes('kisi_bloom_cb', ['C4','C5','C6'])">HOTS C4-C6</button>
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px;">
                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="kisi_bloom" class="kisi_bloom_cb" value="C1">
                            <span><strong>C1</strong> Mengingat</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="kisi_bloom" class="kisi_bloom_cb" value="C2" checked>
                            <span><strong>C2</strong> Memahami</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="kisi_bloom" class="kisi_bloom_cb" value="C3" checked>
                            <span><strong>C3</strong> Menerapkan</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="kisi_bloom" class="kisi_bloom_cb" value="C4" checked>
                            <span><strong>C4</strong> Menganalisis</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="kisi_bloom" class="kisi_bloom_cb" value="C5">
                            <span><strong>C5</strong> Mengevaluasi</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="kisi_bloom" class="kisi_bloom_cb" value="C6">
                            <span><strong>C6</strong> Mencipta</span>
                        </label>
                    </div>
                </div>

                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 14px; margin-bottom: 18px;">
                    <label style="display: flex; align-items: flex-start; gap: 8px; cursor: pointer; font-size: 0.88rem; color: #334155; margin: 0;">
                        <input type="checkbox" id="kisi_auto_save" checked style="margin-top: 3px; transform: scale(1.15);">
                        <span><strong>Simpan Permanen ke Bank Soal:</strong> Setiap butir kisi-kisi dan naskah soal lengkap (5 pilihan jawaban A-E, 1 kunci benar, dan pembahasan) langsung disimpan permanen ke database dan siap diujikan peserta tanpa perbaikan manual.</span>
                    </label>
                </div>

                <div id="kisiAiLoading" style="display: none; padding: 14px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; margin-bottom: 16px; text-align: center; color: #166534;">
                    <div class="loading-spinner" style="border-top-color: #166534; border-color: rgba(22,101,52,0.2); vertical-align: middle; margin-right: 8px;"></div>
                    <span id="kisiAiLoadingText">AI sedang menyusun matriks kisi-kisi dan naskah soal siap uji... Mohon tunggu.</span>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 10px;">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('modalGenKisi')">Batal</button>
                    <button type="submit" id="btnSubmitKisi" class="btn btn-kisi-ai">
                        <i class="fas fa-magic"></i> Mulai Generate & Simpan Permanen
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL 2: GENERATE SOAL DARI KISI-KISI (SIAP DIUJIKAN LANGSUNG) -->
