                            <input type="checkbox" name="soal_jenis" class="soal_jenis_cb" value="esai">
                            <span><strong>Uraian / Esai</strong></span>
                        </label>
                    </div>
                </div>

                <!-- LEVEL KOGNITIF BLOOM (MULTI-SELECT) -->
                <div class="form-group" style="margin-bottom: 18px; background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 12px 14px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; flex-wrap: wrap; gap: 6px;">
                        <label style="font-weight: 600; font-size: 0.9rem; margin: 0; color: #92400e;">
                            <i class="fas fa-brain" style="color: #d97706;"></i> Domain Kognitif Bloom <span style="font-size: 0.8rem; font-weight: normal; color: #78350f;">(Bisa pilih lebih dari satu)</span>
                        </label>
                        <div style="display: flex; gap: 6px;">
                            <button type="button" class="btn btn-sm btn-outline-secondary" style="padding: 2px 8px; font-size: 0.75rem; border-radius: 4px;" onclick="setAllCheckboxes('soal_bloom_cb', true)">Semua C1-C6</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" style="padding: 2px 8px; font-size: 0.75rem; border-radius: 4px;" onclick="setPresetCheckboxes('soal_bloom_cb', ['C2','C3','C4'])">Terapan C2-C4</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" style="padding: 2px 8px; font-size: 0.75rem; border-radius: 4px;" onclick="setPresetCheckboxes('soal_bloom_cb', ['C4','C5','C6'])">HOTS C4-C6</button>
                        </div>
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px;">
                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="soal_bloom" class="soal_bloom_cb" value="C1">
                            <span><strong>C1</strong> Mengingat</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="soal_bloom" class="soal_bloom_cb" value="C2" checked>
                            <span><strong>C2</strong> Memahami</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="soal_bloom" class="soal_bloom_cb" value="C3" checked>
                            <span><strong>C3</strong> Menerapkan</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="soal_bloom" class="soal_bloom_cb" value="C4" checked>
                            <span><strong>C4</strong> Menganalisis</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="soal_bloom" class="soal_bloom_cb" value="C5">
                            <span><strong>C5</strong> Mengevaluasi</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 7px; cursor: pointer; font-size: 0.85rem; margin: 0; padding: 6px 8px; background: #fff; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <input type="checkbox" name="soal_bloom" class="soal_bloom_cb" value="C6">
                            <span><strong>C6</strong> Mencipta</span>
                        </label>
                    </div>
                </div>

                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 14px; margin-bottom: 18px;">
                    <label style="display: flex; align-items: flex-start; gap: 8px; cursor: pointer; font-size: 0.88rem; color: #334155; margin: 0;">
                        <input type="checkbox" id="soal_auto_save" checked style="margin-top: 3px; transform: scale(1.15);">
                        <span><strong>Langsung Simpan Permanen ke Bank Soal:</strong> Butir soal otomatis ditambahkan ke ujian ini tanpa risiko kehilangan data saat navigasi/refresh halaman.</span>
                    </label>
                </div>

                <div id="soalAiLoading" style="display: none; padding: 14px; background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; margin-bottom: 16px; text-align: center; color: #b45309;">
                    <div class="loading-spinner" style="border-top-color: #b45309; border-color: rgba(180,83,9,0.2); vertical-align: middle; margin-right: 8px;"></div>
                    <span>AI sedang menyusun naskah soal, opsi A-E, dan kunci jawaban... Mohon tunggu.</span>
                </div>

                <div id="previewGeneratedSoal" style="display: none; max-height: 250px; overflow-y: auto; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px; margin-bottom: 16px;"></div>

                <div style="display: flex; justify-content: flex-end; gap: 10px;">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('modalGenSoal')">Batal</button>
                    <button type="submit" id="btnSubmitSoal" class="btn btn-soal-ai">
                        <i class="fas fa-sparkles"></i> Generate & Tambahkan ke Ujian
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL 3: VIEW DETAIL SOAL -->
    <div class="modal-overlay" id="modalViewSoal">
        <div class="modal-content" style="max-width: 600px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                <h3 style="margin: 0; color: #1e293b;" id="modalSoalTitle">Detail Butir Soal</h3>
                <button type="button" onclick="closeModal('modalViewSoal')" style="background: none; border: none; font-size: 1.3rem; cursor: pointer; color: #94a3b8;">&times;</button>
            </div>
            <div id="modalSoalBody" style="font-size: 0.95rem; line-height: 1.5; color: #334155;"></div>
            <div style="text-align: right; margin-top: 18px;">
                <button type="button" class="btn btn-secondary" onclick="closeModal('modalViewSoal')">Tutup</button>
            </div>
        </div>
    </div>

    <!-- MODAL 4: EDIT KISI-KISI / BUTIR SOAL -->
    <div class="modal-overlay" id="modalEditKisiOverlay">
        <div class="modal-content" style="max-width: 650px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                <h3 style="margin: 0; color: #1b4d3e; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-pen-to-square"></i> Edit Butir Kisi-Kisi Soal
                </h3>
                <button type="button" onclick="closeEditKisiModal()" style="background: none; border: none; font-size: 1.4rem; cursor: pointer; color: #94a3b8;">&times;</button>
            </div>

            <form method="POST" action="/admin/kisi_kisi">
                <input type="hidden" name="action" value="edit">
                <input type="hidden" name="ujian_id" value="<%= selectedUjianId %>">
                <input type="hidden" name="soal_id" id="edit_kisi_soal_id">

                <div class="form-group" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Capaian Pembelajaran (CPMK / Kompetensi)</label>
                    <input type="text" name="cpmk" id="edit_kisi_cpmk" required class="form-control" style="width: 100%; padding: 9px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                </div>

                <div class="form-group" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Materi Pokok / Bahasan</label>
                    <input type="text" name="materi_pokok" id="edit_kisi_materi_pokok" required class="form-control" style="width: 100%; padding: 9px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                </div>

                <div class="form-group" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Indikator Soal</label>
                    <textarea name="indikator" id="edit_kisi_indikator" rows="2" required class="form-control" style="width: 100%; padding: 9px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-family: inherit;"></textarea>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; margin-bottom: 14px;">
                    <div class="form-group">
                        <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Level Kognitif</label>
                        <select name="level_kognitif" id="edit_kisi_kognitif" class="form-select" style="width: 100%; padding: 9px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                            <option value="C1">C1 - Mengingat</option>
                            <option value="C2">C2 - Memahami</option>
                            <option value="C3">C3 - Menerapkan</option>
                            <option value="C4">C4 - Menganalisis</option>
                            <option value="C5">C5 - Mengevaluasi</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Tingkat Kesulitan</label>
                        <select name="tingkat_kesulitan" id="edit_kisi_kesulitan" class="form-select" style="width: 100%; padding: 9px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                            <option value="mudah">Mudah</option>
                            <option value="sedang">Sedang</option>
                            <option value="sulit">Sulit</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Bobot Poin</label>
                        <input type="number" name="poin" id="edit_kisi_poin" required class="form-control" style="width: 100%; padding: 9px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px;">
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 18px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Teks Pertanyaan Soal</label>
                    <textarea name="pertanyaan" id="edit_kisi_pertanyaan" rows="3" class="form-control" style="width: 100%; padding: 9px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-family: inherit;"></textarea>
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid #f1f5f9; padding-top: 14px;">
                    <button type="button" class="btn btn-secondary" onclick="closeEditKisiModal()" style="padding: 9px 18px; border-radius: 8px;">Batal</button>
                    <button type="submit" class="btn btn-primary" style="background: #1b4d3e; border: none; padding: 9px 20px; border-radius: 8px; font-weight: 600;">
                        <i class="fas fa-check"></i> Simpan Perubahan
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL 5: KONFIRMASI HAPUS BUTIR KISI-KISI -->
    <div class="modal-overlay" id="modalDeleteKisiOverlay">
        <div class="modal-content" style="max-width: 440px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                <h3 style="margin: 0; color: #dc2626; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-trash"></i> Hapus Butir Kisi-Kisi
                </h3>
                <button type="button" onclick="closeConfirmDeleteKisi()" style="background: none; border: none; font-size: 1.4rem; cursor: pointer; color: #94a3b8;">&times;</button>
            </div>

            <p style="color: #334155; margin: 0 0 16px; font-size: 0.95rem; line-height: 1.5;">
                Apakah Anda yakin ingin menghapus butir kisi-kisi <strong id="deleteKisiNumber"></strong> beserta butir soal terkait?
            </p>
            <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 12px 14px; color: #991b1b; font-size: 0.85rem; margin-bottom: 20px;">
                <i class="fas fa-triangle-exclamation" style="margin-right: 6px;"></i> Tindakan ini tidak dapat dibatalkan.
            </div>

            <form method="POST" action="/admin/kisi_kisi">
                <input type="hidden" name="action" value="delete">
                <input type="hidden" name="ujian_id" value="<%= selectedUjianId %>">
                <input type="hidden" name="soal_id" id="deleteKisiSoalId">

                <div style="display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid #f1f5f9; padding-top: 14px;">
                    <button type="button" class="btn btn-secondary" onclick="closeConfirmDeleteKisi()" style="padding: 9px 18px; border-radius: 8px;">Batal</button>
                    <button type="submit" class="btn btn-primary" style="background: #dc2626; border: none; padding: 9px 20px; border-radius: 8px; font-weight: 600;">
                        <i class="fas fa-trash"></i> Ya, Hapus
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function confirmDelete(msg) {
            try {
                return window.confirm(msg);
            } catch (e) {
                return true;
            }
        }

        const soalListDb = <%- JSON.stringify(soalList) %>;

        // Searchable Custom Select Penilaian in Kisi-Kisi
        function toggleSearchablePenilaianKisi(e) {
            e.stopPropagation();
            const dd = document.getElementById('dropdownPilihPenilaianKisi');
            const chevron = document.getElementById('chevronPenilaianKisi');
            const isShown = dd.classList.contains('show');
            if (isShown) {
                dd.classList.remove('show');
                if (chevron) chevron.style.transform = 'rotate(0deg)';
            } else {
                dd.classList.add('show');
                if (chevron) chevron.style.transform = 'rotate(180deg)';
                const input = document.getElementById('searchPenilaianKisiInput');
                if (input) {
                    input.value = '';
                    filterOptionsPenilaianKisi('');
                    setTimeout(() => input.focus(), 60);
                }
            }
        }

        function filterOptionsPenilaianKisi(query) {
            const q = (query || '').toLowerCase().trim();
            const items = document.querySelectorAll('#listPenilaianKisi .searchable-option-item');
            let matchCount = 0;
            items.forEach(item => {
                const title = item.getAttribute('data-title') || '';
                if (title.includes(q)) {
                    item.style.display = 'flex';
                    matchCount++;
                } else {
                    item.style.display = 'none';
                }
            });
            const emptyHint = document.getElementById('emptyPenilaianKisiHint');
            if (emptyHint) {
                emptyHint.style.display = matchCount === 0 ? 'block' : 'none';
            }
        }

        function selectPenilaianKisi(ujianId) {
            window.location.href = '/admin/kisi_kisi?ujian_id=' + ujianId;
        }

        // Toggle Cetak Dropdown
        function toggleCetakMenu(e) {
            e.stopPropagation();
            const d = document.getElementById('cetakDropdown');
            d.classList.toggle('show');
        }

        window.addEventListener('click', function(e) {
            const d = document.getElementById('cetakDropdown');
            if (d && !e.target.closest('.dropdown-cetak')) {
                d.classList.remove('show');
            }
            const wrap = document.getElementById('wrapPilihPenilaianKisi');
            if (wrap && !wrap.contains(e.target)) {
                const dd = document.getElementById('dropdownPilihPenilaianKisi');
                const chevron = document.getElementById('chevronPenilaianKisi');
                if (dd) dd.classList.remove('show');
                if (chevron) chevron.style.transform = 'rotate(0deg)';
            }
        });

        // Modals control
        function openGenKisiModal() {
            document.getElementById('modalGenKisi').style.display = 'flex';
        }

        function openGenSoalModal() {
            document.getElementById('modalGenSoal').style.display = 'flex';
        }

        function closeModal(id) {
            document.getElementById(id).style.display = 'none';
        }

        function viewSoalDetail(soalId) {
            const s = soalListDb.find(item => item.id === soalId);
            if (!s) return;

            document.getElementById('modalSoalTitle').innerText = 'Butir Soal #' + (soalListDb.indexOf(s) + 1) + ' (' + (s.poin || 4) + ' Poin)';
            let html = '<div style="margin-bottom: 12px; font-weight: 500;">' + s.pertanyaan + '</div>';

            if (s.gambar_soal) {
                html += '<div style="margin-bottom: 12px;"><img src="' + s.gambar_soal + '" style="max-width: 100%; border: 1px solid #cbd5e1; border-radius: 4px;"></div>';
            }

            if (s.opsi && s.opsi.length > 0) {
                html += '<div style="margin-bottom: 12px; font-weight: 600; font-size: 0.85rem; color: #64748b;">PILIHAN JAWABAN:</div><ul style="padding-left: 20px; list-style-type: lower-alpha;">';
                s.opsi.forEach(o => {
                    const isKey = o.benar ? '<span style="color: #16a34a; font-weight: 600; margin-left: 8px;">(Kunci Benar)</span>' : '';
                    html += '<li style="margin-bottom: 4px;' + (o.benar ? 'font-weight: 600; color: #15803d;' : '') + '">' + o.teks + isKey + '</li>';
                });
                html += '</ul>';
            }

            if (s.pembahasan) {
                html += '<div style="background: #f8fafc; border-left: 3px solid #3b82f6; padding: 10px; margin-top: 14px; font-size: 0.85rem;"><strong>Pembahasan:</strong> ' + s.pembahasan + '</div>';
            }

            document.getElementById('modalSoalBody').innerHTML = html;
            document.getElementById('modalViewSoal').style.display = 'flex';
        }

        function openEditKisiModalById(soalId) {
            const s = (typeof soalListDb !== 'undefined' ? soalListDb : []).find(item => item.id === Number(soalId));
            if (!s) return;
            openEditKisiModal(s);
        }

        function openEditKisiModal(soal) {
            document.getElementById('edit_kisi_soal_id').value = soal.id;
            document.getElementById('edit_kisi_cpmk').value = soal.cpmk || '';
            document.getElementById('edit_kisi_materi_pokok').value = soal.materi_pokok || '';
            document.getElementById('edit_kisi_indikator').value = soal.indikator || '';
            document.getElementById('edit_kisi_kognitif').value = soal.level_kognitif || 'C2';
            document.getElementById('edit_kisi_kesulitan').value = soal.tingkat_kesulitan || 'sedang';
            document.getElementById('edit_kisi_poin').value = soal.poin || 4;
            document.getElementById('edit_kisi_pertanyaan').value = (soal.pertanyaan || '').replace(/<[^>]*>?/gm, '');
            document.getElementById('modalEditKisiOverlay').style.display = 'flex';
        }

        function closeEditKisiModal() {
            document.getElementById('modalEditKisiOverlay').style.display = 'none';
        }

        function openConfirmDeleteKisi(id, no) {
            document.getElementById('deleteKisiSoalId').value = id;
            document.getElementById('deleteKisiNumber').innerText = 'Nomor ' + no;
            document.getElementById('modalDeleteKisiOverlay').style.display = 'flex';
        }

        function closeConfirmDeleteKisi() {
            document.getElementById('modalDeleteKisiOverlay').style.display = 'none';
        }

        // Checkbox helpers for multi-select jenis soal & bloom levels
        function setAllCheckboxes(className, checked) {
            document.querySelectorAll('.' + className).forEach(cb => cb.checked = checked);
        }
        function setOnlyOneCheckbox(className, value) {
            document.querySelectorAll('.' + className).forEach(cb => {
                cb.checked = (cb.value === value);
            });
        }
        function setPresetCheckboxes(className, values) {
            document.querySelectorAll('.' + className).forEach(cb => {
                cb.checked = values.includes(cb.value);
            });
        }
        function getCheckedValues(className, defaultValues) {
            const list = Array.from(document.querySelectorAll('.' + className + ':checked')).map(cb => cb.value);
            return list.length > 0 ? list : defaultValues;
        }

        // Handle AI generation for Kisi-Kisi (Presisi Tinggi & Auto-Save)
        async function handleGenerateKisi(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitKisi');
            const loading = document.getElementById('kisiAiLoading');
            btn.disabled = true;
            loading.style.display = 'block';

            const autoSave = document.getElementById('kisi_auto_save') ? document.getElementById('kisi_auto_save').checked : true;
            const selectedTypes = getCheckedValues('kisi_jenis_cb', ['pg']);
            const selectedBlooms = getCheckedValues('kisi_bloom_cb', ['C2', 'C3', 'C4']);

            const payload = {
                ujian_id: <%= selectedUjianId %>,
                topik: document.getElementById('kisi_topik').value,
                sub_topik: document.getElementById('kisi_subtopik') ? document.getElementById('kisi_subtopik').value : '',
                cpmk: document.getElementById('kisi_cpmk').value,
                jumlah: parseInt(document.getElementById('kisi_jumlah').value, 10) || 10,
                kesulitan: document.getElementById('kisi_kesulitan').value,
                jenis_soal_list: selectedTypes,
                kognitif_list: selectedBlooms,
                apply: autoSave
            };

            try {
                const res = await fetch('/admin/api/generate_kisi_kisi', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    window.location.href = '/admin/kisi_kisi?ujian_id=<%= selectedUjianId %>&msg=' + encodeURIComponent('Berhasil menyusun ' + (data.count || payload.jumlah) + ' butir kisi-kisi dan naskah soal siap uji yang tersimpan permanen!');
                } else {
                    alert('Gagal menyusun kisi-kisi AI: ' + (data.message || 'Terjadi kendala pada respon sistem.'));
                    btn.disabled = false;
                    loading.style.display = 'none';
                }
            } catch (err) {
                console.error(err);
                alert('Gagal menghubungi generator AI: ' + err.message);
                btn.disabled = false;
                loading.style.display = 'none';
            }
        }

        // Handle AI generation for questions from Kisi-Kisi (Siap Uji & Auto-Save)
        async function handleGenerateSoal(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitSoal');
            const loading = document.getElementById('soalAiLoading');
            btn.disabled = true;
            loading.style.display = 'block';

            const autoSave = document.getElementById('soal_auto_save') ? document.getElementById('soal_auto_save').checked : true;
            const selectedTypes = getCheckedValues('soal_jenis_cb', ['pg']);
            const selectedBlooms = getCheckedValues('soal_bloom_cb', ['C2', 'C3', 'C4']);

            const payload = {
                ujian_id: <%= selectedUjianId %>,
                jumlah: parseInt(document.getElementById('soal_jumlah').value, 10) || 5,
                poin: parseInt(document.getElementById('soal_poin').value, 10) || 4,
                fokus_materi: document.getElementById('soal_fokus') ? document.getElementById('soal_fokus').value : '',
                kesulitan: document.getElementById('soal_kesulitan').value,
                jenis_soal_list: selectedTypes,
                kognitif_list: selectedBlooms,
                apply: autoSave
            };

            try {
                const res = await fetch('/admin/api/generate_soal_kisi_kisi', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    window.location.href = '/admin/kisi_kisi?ujian_id=<%= selectedUjianId %>&msg=' + encodeURIComponent('Berhasil menghasilkan ' + (data.count || payload.jumlah) + ' butir naskah soal siap uji dan tersimpan permanen!');
                } else {
                    alert('Gagal menyusun butir soal: ' + (data.message || 'Terjadi kendala pada sistem.'));
                    btn.disabled = false;
                    loading.style.display = 'none';
                }
            } catch (err) {
                console.error(err);
                alert('Gagal menghubungi generator soal: ' + err.message);
                btn.disabled = false;
                loading.style.display = 'none';
            }
        }

        window.addEventListener('click', function(e) {
            if (e.target.classList.contains('modal-overlay')) {
                e.target.style.display = 'none';
            }
        });

        window.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal-overlay').forEach(m => m.style.display = 'none');
            }
        });
    </script>
</body>
</html>
