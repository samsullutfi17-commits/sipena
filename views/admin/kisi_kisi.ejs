                    <input type="text" id="kisi_topik" class="form-control" required value="<%= currentUjian ? (currentUjian.nama_mk || currentUjian.judul_ujian) : 'Pengembangan Media Pembelajaran' %>" placeholder="Contoh: Pemrograman Web Lanjut, Rekayasa Perangkat Lunak">
                </div>

                <div class="form-group" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.9rem; display: flex; justify-content: space-between;">
                        <span>Ruang Lingkup & Sub-Topik (Batasan Materi)</span>
                        <span style="font-size: 0.8rem; color: #0284c7; font-weight: 500;"><i class="fas fa-bullseye"></i> Mencegah Penyimpangan AI</span>
                    </label>
                    <textarea id="kisi_subtopik" class="form-control" rows="2" placeholder="Tuliskan materi fokus/sub-bab agar naskah soal akurat, contoh: Prinsip Multimedia Mayer, Kerangka Dale, Evaluasi Formatif & Sumatif Bahan Ajar"></textarea>
                    <small style="color: #64748b; font-size: 0.8rem;">Menentukan cakupan materi spesifik agar AI menyusun butir indikator yang presisi.</small>
                </div>

                <div class="form-group" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.9rem;">Capaian Pembelajaran (CPMK / Standar Kompetensi)</label>
                    <textarea id="kisi_cpmk" class="form-control" rows="2" placeholder="Contoh: Menguasai prinsip multimedia, analisis taksonomi media, dan evaluasi kelayakan bahan ajar digital.">Menganalisis prinsip desain instruksional multimedia, klasifikasi media pembelajaran, dan evaluasi efektivitas media.</textarea>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
                    <div class="form-group">
                        <label style="font-weight: 600; font-size: 0.9rem;">Jumlah Indikator / Butir Soal</label>
                        <input type="number" id="kisi_jumlah" class="form-control" value="10" min="1" max="40">
                    </div>
                    <div class="form-group">
                        <label style="font-weight: 600; font-size: 0.9rem;">Komposisi Kesulitan</label>
                        <select id="kisi_kesulitan" class="form-select">
                            <option value="proporsional" selected>Proporsional (30% Mudah, 50% Sedang, 20% Sulit)</option>
                            <option value="sedang">Dominan Sedang (Aplikasi C3)</option>
                            <option value="hots">Dominan HOTS (Analisis C4 - Evaluasi C5)</option>
                            <option value="mudah">Dominan Pemahaman Dasar (C1 - C2)</option>
                        </select>
                    </div>
                </div>

                <!-- PILIHAN BENTUK / JENIS SOAL (MULTI-SELECT) -->
