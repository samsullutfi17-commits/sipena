<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ganti Password - SIPENA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="stylesheet" href="/assets/css/admin.css">
    <script src="/assets/js/admin-sidebar.js" defer></script>
</head>
<body>
    <header class="header">
        <div class="container header-flex" style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h1>SIPENA – Keamanan Akun</h1>
                <p class="subtitle"><%= adminNama %> (<%= adminRole.toUpperCase() %>)</p>
            </div>
        </div>
    </header>

    <div class="admin-container">
        <%- include('../partials/admin_sidebar', { currentPath: '/admin/ganti_password', adminRole: adminRole }) %>

        <main class="admin-main">
            <nav class="breadcrumb">
                <a href="/admin/dashboard">Beranda</a> &raquo;
                <span>Ganti Password</span>
            </nav>

            <h2><i class="fas fa-key"></i> Pengaturan Password Pribadi</h2>
            <p style="color: var(--text-muted); margin-bottom: 24px;">
                Ganti password standar (<code>12345*</code>) dengan password rahasia baru Anda untuk menjaga keamanan akun.
            </p>

            <% if (message) { %>
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> <%= message %>
                </div>
            <% } %>
            <% if (error) { %>
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle"></i> <%= error %>
                </div>
            <% } %>

            <div class="card" style="max-width: 550px;">
                <form method="POST" action="/admin/ganti_password">
                    <input type="hidden" name="sid" value="<%= sid %>">

                    <div class="form-group">
                        <label for="old_password">Password Saat Ini (Lama)</label>
                        <input type="password" id="old_password" name="old_password" class="form-control" required placeholder="Masukkan password saat ini (misal 12345*)">
                    </div>

                    <div class="form-group">
                        <label for="new_password">Password Baru</label>
                        <input type="password" id="new_password" name="new_password" class="form-control" required minlength="5" placeholder="Minimal 5 karakter rahasia">
                    </div>

                    <div class="form-group">
                        <label for="confirm_password">Konfirmasi Password Baru</label>
                        <input type="password" id="confirm_password" name="confirm_password" class="form-control" required minlength="5" placeholder="Ketik ulang password baru">
                    </div>

                    <div style="margin-top: 24px; display: flex; gap: 12px; align-items: center;">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Simpan Password Baru
                        </button>
                        <a href="/admin/dashboard" class="btn btn-secondary">Batal</a>
                    </div>
                </form>
            </div>
        </main>
    </div>
</body>
</html>
