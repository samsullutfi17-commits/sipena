        // Close on backdrop click
        window.addEventListener('click', function(e) {
            ['modalAddUser', 'modalEditUser', 'modalImportXlsx', 'modalConfirmReset', 'modalConfirmDelete', 'modalConfirmResetSesi', 'modalConfirmPaksaKeluar', 'modalConfirmAkhiriSesi', 'modalConfirmTandaiAktif'].forEach(id => {
                const el = document.getElementById(id);
                if (el && e.target === el) {
                    el.style.display = 'none';
                }
            });
        });

        // Toggle Kelas, NIM & NIDN fields
        function toggleAddKelasInput(role) {
            const nimRow = document.getElementById('add_nim_row');
            const nidnRow = document.getElementById('add_nidn_row');
            const kelasRow = document.getElementById('add_kelas_row');
            if (role === 'peserta') {
                nimRow.style.display = 'block';
                kelasRow.style.display = 'block';
                if (nidnRow) nidnRow.style.display = 'none';
            } else if (role === 'dosen') {
                nimRow.style.display = 'none';
                kelasRow.style.display = 'none';
                if (nidnRow) nidnRow.style.display = 'block';
            } else {
                nimRow.style.display = 'none';
                kelasRow.style.display = 'none';
                if (nidnRow) nidnRow.style.display = 'none';
            }
        }

        function toggleEditKelasInput(role) {
            const nimRow = document.getElementById('edit_nim_row');
            const nidnRow = document.getElementById('edit_nidn_row');
            const kelasRow = document.getElementById('edit_kelas_row');
            if (role === 'peserta') {
                nimRow.style.display = 'block';
                kelasRow.style.display = 'block';
                if (nidnRow) nidnRow.style.display = 'none';
            } else if (role === 'dosen') {
                nimRow.style.display = 'none';
                kelasRow.style.display = 'none';
                if (nidnRow) nidnRow.style.display = 'block';
            } else {
                nimRow.style.display = 'none';
                kelasRow.style.display = 'none';
                if (nidnRow) nidnRow.style.display = 'none';
            }
        }

        // Auto-run realtime when loaded if active tab is status
        document.addEventListener('DOMContentLoaded', () => {
            const isStatusTab = '<%= activeTab %>' === 'status';
            if (isStatusTab) {
                startAutoRefresh();
                fetchStatusPesertaRealtime(false);
            }
        });
