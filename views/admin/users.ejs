    <script>
        // State variables for real-time monitoring
        let autoRefreshTimer = null;
        let isPolling = false;
        let currentStatusPesertaData = [];

        // Toast notification system
        function showToast(msg, type = 'success') {
            const t = document.getElementById('toastNotification');
            t.style.display = 'block';
            t.style.backgroundColor = type === 'success' ? '#16a34a' : (type === 'warning' ? '#d97706' : '#dc2626');
            t.innerHTML = (type === 'success' ? '<i class="fas fa-check-circle" style="margin-right:8px;"></i>' : '<i class="fas fa-exclamation-triangle" style="margin-right:8px;"></i>') + msg;
            setTimeout(() => {
                t.style.display = 'none';
            }, 3000);
        }

        // Tab switching
        function switchTab(tabName) {
            const sectionDaftar = document.getElementById('sectionDaftarUser');
            const sectionStatus = document.getElementById('sectionStatusPeserta');
            const btnDaftar = document.getElementById('tabDaftarBtn');
            const btnStatus = document.getElementById('tabStatusBtn');

            if (tabName === 'status') {
                sectionDaftar.style.display = 'none';
                sectionStatus.style.display = 'block';
                btnDaftar.classList.remove('active');
                btnStatus.classList.add('active');
                startAutoRefresh();
                fetchStatusPesertaRealtime(false);
            } else {
                sectionDaftar.style.display = 'block';
                sectionStatus.style.display = 'none';
                btnDaftar.classList.add('active');
                btnStatus.classList.remove('active');
                stopAutoRefresh();
            }
        }

        // Real-time polling functions
        function startAutoRefresh() {
            stopAutoRefresh();
            const isChecked = document.getElementById('autoRefreshToggle')?.checked;
            if (isChecked) {
                autoRefreshTimer = setInterval(() => {
                    fetchStatusPesertaRealtime(false);
                }, 3000);
            }
        }

        function stopAutoRefresh() {
            if (autoRefreshTimer) {
                clearInterval(autoRefreshTimer);
                autoRefreshTimer = null;
            }
        }

        function toggleAutoRefresh(enabled) {
            if (enabled) {
                startAutoRefresh();
                fetchStatusPesertaRealtime(true);
            } else {
                stopAutoRefresh();
            }
        }

        // Fetch realtime status peserta from server
        async function fetchStatusPesertaRealtime(showIndicator = false) {
            if (isPolling) return;
            isPolling = true;

            const icon = document.getElementById('refreshIcon');
            if (showIndicator && icon) {
                icon.classList.add('fa-spin');
            }

            try {
                const res = await fetch('/admin/api/status_peserta');
                if (res.ok) {
                    const data = await res.json();
                    if (data.success && Array.isArray(data.data)) {
                        currentStatusPesertaData = data.data;
                        updateStatusPesertaUI(data);
                    }
                }
            } catch (err) {
                console.error('Error fetching realtime status peserta:', err);
            } finally {
                isPolling = false;
                if (showIndicator && icon) {
                    setTimeout(() => icon.classList.remove('fa-spin'), 400);
                }
            }
        }

        // Local timezone detection & client-side time formatters
        function getLocalTimezoneName() {
            try {
                const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
                const offsetMinutes = -new Date().getTimezoneOffset();
                const offsetHours = offsetMinutes / 60;
                if (tz === 'Asia/Jakarta' || offsetHours === 7) return 'WIB';
                if (tz === 'Asia/Makassar' || tz === 'Asia/Ujung_Pandang' || offsetHours === 8) return 'WITA';
                if (tz === 'Asia/Jayapura' || offsetHours === 9) return 'WIT';
                return offsetHours >= 0 ? `GMT+${offsetHours}` : `GMT${offsetHours}`;
            } catch (e) {
                return 'WIB';
            }
        }

        function formatClientDateTime(isoString) {
            if (!isoString) return '-';
            const d = new Date(isoString);
            if (isNaN(d.getTime())) return '-';
            const day = String(d.getDate()).padStart(2, '0');
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const year = d.getFullYear();
            const hours = String(d.getHours()).padStart(2, '0');
            const minutes = String(d.getMinutes()).padStart(2, '0');
            const seconds = String(d.getSeconds()).padStart(2, '0');
            return `${day}/${month}/${year} ${hours}:${minutes}:${seconds}`;
        }

        function formatClientTimeOnly(isoString) {
            if (!isoString) return '-';
            const d = new Date(isoString);
            if (isNaN(d.getTime())) return '-';
            const hours = String(d.getHours()).padStart(2, '0');
            const minutes = String(d.getMinutes()).padStart(2, '0');
            const seconds = String(d.getSeconds()).padStart(2, '0');
            return `${hours}:${minutes}:${seconds}`;
        }

        // Live ticking clock based on user's exact local device clock & timezone
        function renderLiveClock() {
            const clockElem = document.getElementById('realtimeTimestamp');
            if (!clockElem) return;
            const now = new Date();
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            const tz = getLocalTimezoneName();
            clockElem.innerHTML = `
                <strong style="font-family: monospace; font-size: 0.92rem; color: #0f172a; letter-spacing: 0.5px;">${hours}:${minutes}:${seconds}</strong>
                <span style="background: #e0f2fe; color: #0369a1; padding: 2px 7px; border-radius: 4px; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.5px;">${tz}</span>
            `;
        }

        // Start live ticking clock immediately
        setInterval(renderLiveClock, 1000);
        renderLiveClock();

        // Update table DOM & summary chips smoothly
        function updateStatusPesertaUI(apiResponse) {
            const list = apiResponse.data || [];

            // Briefly show sync pulse
            const syncPulse = document.getElementById('syncPulse');
            if (syncPulse) {
                syncPulse.style.display = 'inline-block';
                setTimeout(() => {
                    syncPulse.style.display = 'none';
                }, 1200);
            }

            // Update Summary Chips
            const chipTotal = document.getElementById('chipTotalPeserta');
            const chipLogin = document.getElementById('chipLoginPeserta');
            const chipActive = document.getElementById('chipActivePeserta');
            const chipSelesai = document.getElementById('chipSelesaiPeserta');

            if (chipTotal) chipTotal.innerText = apiResponse.total || list.length;
            if (chipLogin) chipLogin.innerText = apiResponse.login_count || 0;
            if (chipActive) chipActive.innerText = apiResponse.active_count || 0;
            if (chipSelesai) chipSelesai.innerText = apiResponse.completed_count || 0;

            renderStatusPesertaRows(list);
        }

        function renderStatusPesertaRows(list) {
            const tbody = document.getElementById('statusPesertaTableBody');
            if (!tbody) return;

            const q = (document.getElementById('statusSearchInput')?.value || '').toLowerCase().trim();
            const filterKelas = (document.getElementById('statusKelasFilterSelect')?.value || '').trim();
            const filterStatus = (document.getElementById('statusFilterSelect')?.value || '').trim();

            if (list.length === 0) {
                tbody.innerHTML = `<tr><td colspan="10" style="text-align: center; padding: 32px; color: #64748b;">Belum ada data aktivitas ujian mahasiswa.</td></tr>`;
                return;
            }

            let html = '';
            let visibleCount = 0;

            list.forEach((sp, idx) => {
                const nimLower = (sp.nim || '').toLowerCase();
                const namaLower = (sp.nama_lengkap || '').toLowerCase();
                const kelasLower = (sp.nama_kelas || '').toLowerCase();
                const idKelasStr = sp.id_kelas ? String(sp.id_kelas) : '';

                const matchQuery = !q || nimLower.includes(q) || namaLower.includes(q) || kelasLower.includes(q);
                const matchKelas = !filterKelas || idKelasStr === filterKelas || kelasLower === filterKelas.toLowerCase();
                const matchStatus = !filterStatus || sp.status === filterStatus;

                if (!matchQuery || !matchKelas || !matchStatus) return;
                visibleCount++;

                // Build status badge
                let statusBadge = '<span class="badge-belum">Belum Ujian</span>';
                if (sp.status === 'sedang_login') {
                    statusBadge = '<span class="badge-sedang-login"><i class="fas fa-user-check"></i> Sedang Login</span>';
                } else if (sp.status === 'berlangsung') {
                    statusBadge = '<span class="badge-dikerjakan"><i class="fas fa-spinner fa-spin"></i> Sedang Mengerjakan</span>';
                } else if (sp.status === 'selesai') {
                    statusBadge = '<span class="badge-selesai"><i class="fas fa-check-circle"></i> Test Selesai</span>';
                } else if (sp.status === 'timeout') {
                    statusBadge = '<span class="badge-timeout"><i class="fas fa-clock"></i> Waktu Habis</span>';
                }

                // Build action buttons
                let actionButtons = '<span style="color: #94a3b8; font-size: 0.85rem;">-</span>';
                const safeName = (sp.nama_lengkap || '').replace(/'/g, "\\'");

                if (sp.status === 'sedang_login' && sp.user_id) {
                    actionButtons = `
                        <button type="button" class="btn btn-sm btn-outline-danger" style="font-size: 0.78rem; padding: 4px 8px;" onclick="openPaksaKeluarModal(${sp.user_id}, '${safeName}')">
                            <i class="fas fa-right-from-bracket"></i> Paksa Keluar
                        </button>
                    `;
                } else if (sp.status === 'berlangsung' && sp.sesi_id) {
                    actionButtons = `
                        <button type="button" class="btn btn-sm" style="background: #dc2626; color: #fff; font-size: 0.78rem; padding: 4px 8px; border: none; border-radius: 4px;" onclick="openAkhiriSesiModal(${sp.sesi_id}, '${safeName}')">
                            <i class="fas fa-flag-checkered"></i> Akhiri Sesi
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-warning" style="font-size: 0.78rem; padding: 4px 8px;" onclick="openResetSesiModal(${sp.sesi_id}, '${safeName}')">
                            <i class="fas fa-rotate-left"></i> Reset
                        </button>
                    `;
                } else if (sp.status === 'selesai' && sp.sesi_id) {
                    actionButtons = `
                        <button type="button" class="btn btn-sm btn-outline-secondary" style="font-size: 0.78rem; padding: 4px 8px;" onclick="openResetSesiModal(${sp.sesi_id}, '${safeName}')">
                            <i class="fas fa-rotate-left"></i> Ujian Ulang
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-success" style="font-size: 0.78rem; padding: 4px 8px;" onclick="openTandaiAktifModal(${sp.sesi_id}, '${safeName}')">
                            <i class="fas fa-play"></i> Buka Sesi
                        </button>
                    `;
                } else if (sp.status === 'timeout' && sp.sesi_id) {
                    actionButtons = `
                        <button type="button" class="btn btn-sm btn-outline-success" style="font-size: 0.78rem; padding: 4px 8px;" onclick="openTandaiAktifModal(${sp.sesi_id}, '${safeName}')">
                            <i class="fas fa-play"></i> Aktifkan Lagi
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-warning" style="font-size: 0.78rem; padding: 4px 8px;" onclick="openResetSesiModal(${sp.sesi_id}, '${safeName}')">
                            <i class="fas fa-rotate-left"></i> Reset
                        </button>
                    `;
                }

                // Format Waktu Mulai in user's local timezone
                let waktuMulaiDisplay = '-';
                if (sp.waktu_mulai_iso) {
                    if (sp.is_login_only || sp.status === 'sedang_login') {
                        waktuMulaiDisplay = `Login: ${formatClientTimeOnly(sp.waktu_mulai_iso)}`;
                    } else {
                        waktuMulaiDisplay = formatClientDateTime(sp.waktu_mulai_iso);
                    }
                } else if (sp.waktu_mulai) {
                    waktuMulaiDisplay = sp.waktu_mulai;
                }

                // Format Waktu Selesai in user's local timezone
                let waktuSelesaiDisplay = '-';
                if (sp.waktu_selesai_iso) {
                    waktuSelesaiDisplay = formatClientDateTime(sp.waktu_selesai_iso);
                } else if (sp.waktu_selesai && sp.waktu_selesai !== '-') {
                    waktuSelesaiDisplay = sp.waktu_selesai;
                }

                // Compute exact duration locally
                let durasiDisplay = '-';
                if (sp.status === 'berlangsung' && sp.waktu_mulai_iso) {
                    const startMs = new Date(sp.waktu_mulai_iso).getTime();
                    const elapsedSec = Math.max(0, Math.floor((Date.now() - startMs) / 1000));
                    const jam = Math.floor(elapsedSec / 3600);
                    const mnt = Math.floor((elapsedSec % 3600) / 60);
                    const dtk = elapsedSec % 60;
                    durasiDisplay = (jam > 0 ? jam + ' jam ' : '') + mnt + ' mnt ' + dtk + ' dtk (Aktif)';
                } else if (sp.status === 'selesai' && sp.waktu_mulai_iso && sp.waktu_selesai_iso) {
                    const startMs = new Date(sp.waktu_mulai_iso).getTime();
                    const endMs = new Date(sp.waktu_selesai_iso).getTime();
                    const diffSec = Math.max(0, Math.floor((endMs - startMs) / 1000));
                    const jam = Math.floor(diffSec / 3600);
                    const mnt = Math.floor((diffSec % 3600) / 60);
                    const dtk = diffSec % 60;
                    durasiDisplay = (jam > 0 ? jam + ' jam ' : '') + mnt + ' mnt ' + dtk + ' dtk';
                } else if (sp.durasi_pengerjaan) {
                    durasiDisplay = sp.durasi_pengerjaan;
                }

                const durasiColor = sp.status === 'berlangsung' ? '#b45309' : '#334155';

                const kelasBadge = sp.nama_kelas && sp.nama_kelas !== '-' 
                    ? `<span class="badge-user-kelas"><i class="fas fa-graduation-cap"></i> ${sp.nama_kelas}</span>` 
                    : '<span style="color: #94a3b8; font-size: 0.82rem;">-</span>';

                html += `
                    <tr data-nim="${nimLower}" data-nama="${namaLower}" data-kelas="${kelasLower}" data-idkelas="${idKelasStr}" data-status="${sp.status}">
                        <td><strong>${sp.no || idx + 1}</strong></td>
                        <td><code>${sp.nim}</code></td>
                        <td>
                            <strong>${sp.nama_lengkap}</strong>
                            ${sp.judul_ujian && sp.judul_ujian !== '-' ? `<div style="font-size: 0.76rem; color: #64748b;">${sp.judul_ujian}</div>` : ''}
                        </td>
                        <td>${kelasBadge}</td>
                        <td>${statusBadge}</td>
                        <td style="font-size: 0.82rem; color: #475569;">${waktuMulaiDisplay}</td>
                        <td style="font-size: 0.82rem; color: #475569;">${waktuSelesaiDisplay}</td>
                        <td style="font-size: 0.82rem; font-weight: 500; color: ${durasiColor};">${durasiDisplay}</td>
                        <td><strong>${sp.nilai_total !== null && sp.nilai_total !== undefined ? sp.nilai_total : '-'}</strong></td>
                        <td><div style="display: flex; gap: 5px; flex-wrap: wrap; align-items: center;">${actionButtons}</div></td>
                    </tr>
                `;
            });

            if (visibleCount === 0) {
                tbody.innerHTML = `<tr><td colspan="10" style="text-align: center; padding: 28px; color: #64748b;">Tidak ada data peserta yang cocok dengan kriteria filter.</td></tr>`;
            } else {
                tbody.innerHTML = html;
            }
        }

        function filterStatusPesertaTable() {
            if (currentStatusPesertaData && currentStatusPesertaData.length > 0) {
                renderStatusPesertaRows(currentStatusPesertaData);
            }
        }

        function resetStatusPesertaFilter() {
            const searchInput = document.getElementById('statusSearchInput');
            const kelasSelect = document.getElementById('statusKelasFilterSelect');
            const statusSelect = document.getElementById('statusFilterSelect');
            if (searchInput) searchInput.value = '';
            if (kelasSelect) kelasSelect.value = '';
            if (statusSelect) statusSelect.value = '';
            filterStatusPesertaTable();
        }

        // Live table filtering for Tab 1 (Daftar User)
        function filterUserTable() {
            const q = (document.getElementById('searchInput').value || '').toLowerCase().trim();
            const role = (document.getElementById('roleFilter').value || '').toLowerCase().trim();
            const kelas = (document.getElementById('kelasFilter').value || '').trim();

            const table = document.getElementById('usersTable');
            const rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

            for (let i = 0; i < rows.length; i++) {
                const tr = rows[i];
                const uUsername = tr.getAttribute('data-username') || '';
                const uNama = tr.getAttribute('data-nama') || '';
                const uNim = tr.getAttribute('data-nim') || '';
                const uRole = tr.getAttribute('data-role') || '';
                const uKelas = tr.getAttribute('data-kelas') || '';
                const uNamaKelas = tr.getAttribute('data-namakelas') || '';

                const matchesQuery = !q || uUsername.includes(q) || uNama.includes(q) || uNim.includes(q) || uNamaKelas.includes(q);
                const matchesRole = !role || uRole === role;
                const matchesKelas = !kelas || String(uKelas) === String(kelas) || uNamaKelas === kelas.toLowerCase();

                if (matchesQuery && matchesRole && matchesKelas) {
                    tr.style.display = '';
                } else {
                    tr.style.display = 'none';
                }
            }
        }

        function resetUserTableFilter() {
            const searchInput = document.getElementById('searchInput');
            const roleSelect = document.getElementById('roleFilter');
            const kelasSelect = document.getElementById('kelasFilter');
            if (searchInput) searchInput.value = '';
            if (roleSelect) roleSelect.value = '';
            if (kelasSelect) kelasSelect.value = '';
            filterUserTable();
        }

