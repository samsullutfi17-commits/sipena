        // Action Executions
        async function executeResetPassword() {
            const userId = document.getElementById('reset_user_id').value;
            const btn = document.getElementById('btnConfirmReset');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Memproses...';

            try {
                const res = await fetch('/admin/api/users/action', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'reset_password', user_id: userId })
                });
                const data = await res.json();
                if (data.success) {
                    closeModal('modalConfirmReset');
                    showToast(data.message || 'Password berhasil direset ke 12345*', 'success');
                    setTimeout(() => { window.location.reload(); }, 800);
                } else {
                    showToast(data.message || 'Gagal mereset password', 'danger');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-check"></i> Ya, Reset ke 12345*';
                }
            } catch(err) {
                window.location.reload();
            }
        }

