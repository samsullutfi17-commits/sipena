<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laporan Hasil Ujian - SIPENA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="stylesheet" href="/assets/css/admin.css">
    <script src="/assets/js/admin-sidebar.js" defer></script>
</head>
<body>
    <header class="header">
        <div class="container header-flex" style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h1>SIPENA – Laporan Hasil Penilaian</h1>
                <p class="subtitle"><%= adminNama %> &bull; Administrator</p>
            </div>
            <a href="/admin/logout" class="btn btn-accent"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </header>

    <div class="admin-container">
        <%- include('../partials/admin_sidebar', { currentPath: '/admin/hasil', adminRole: adminRole }) %>

        <main class="admin-main">
            <nav class="breadcrumb">
                <a href="/admin/dashboard">Beranda</a> &raquo;
                <span>Laporan Hasil</span>
            </nav>

            <h2><i class="fas fa-chart-bar"></i> Laporan Rekapitulasi Hasil Penilaian</h2>

            <% if (message) { %>
                <div class="alert alert-success"><%= message %></div>
            <% } %>

            <!-- Filter Card -->
            <div class="card" style="margin-bottom: 20px;">
                <form method="GET" action="/admin/hasil" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)) 100px; gap: 12px; align-items: flex-end;">
                    <div class="form-group" style="margin-bottom: 0;">
                        <label>Filter Ujian</label>
                        <select name="ujian_id" class="form-select">
                            <option value="">Semua Penilaian</option>
                            <% ujianList.forEach(function(u) { %>
                                <option value="<%= u.id %>" <%= u.id === selectedUjianId ? 'selected' : '' %>><%= u.judul_ujian %></option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        <label>Filter Kelas</label>
                        <select name="kelas_id" class="form-select">
                            <option value="">Semua Kelas</option>
                            <% kelasList.forEach(function(k) { %>
                                <option value="<%= k.id %>" <%= k.id === selectedKelasId ? 'selected' : '' %>><%= k.nama_kelas %></option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        <label>Pencarian</label>
                        <input type="text" name="search" value="<%= search %>" class="form-control" placeholder="Nama / NIM...">
                    </div>

                    <div>
                        <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-filter"></i> Filter</button>
                    </div>
                </form>
            </div>

            <!-- Results Table -->
            <div class="card">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>NIM</th>
                                <th>Nama Lengkap</th>
                                <th>Kelas / Program</th>
                                <th>Penilaian</th>
                                <th>Waktu Selesai</th>
                                <th>Nilai</th>
                                <th>Status</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (results.length === 0) { %>
                                <tr><td colspan="9" class="text-center" style="padding: 24px;">Belum ada riwayat hasil ujian yang cocok dengan kriteria.</td></tr>
                            <% } else { %>
                                <% results.forEach(function(r, idx) { %>
                                    <tr>
                                        <td><%= idx + 1 %></td>
                                        <td><code><%= r.nim %></code></td>
                                        <td><strong><%= r.nama_lengkap %></strong></td>
                                        <td><%= r.nama_kelas %> &bull; <%= r.nama_prodi %></td>
                                        <td><%= r.judul_ujian %></td>
                                        <td><%= r.waktu_selesai ? new Date(r.waktu_selesai).toLocaleString('id-ID') : '-' %></td>
                                        <td><strong style="font-size: 1.1rem;"><%= r.nilai_total %></strong></td>
                                        <td>
                                            <span class="badge <%= r.status_lulus === 'Lulus' ? 'badge-success' : 'badge-danger' %>">
                                                <%= r.status_lulus %>
                                            </span>
                                        </td>
                                        <td style="white-space: nowrap; text-align: center;">
                                            <div style="display: flex; gap: 5px; justify-content: center; align-items: center; flex-wrap: wrap;">
                                                <a href="/admin/detail_hasil?sesi_id=<%= r.id %>" class="btn btn-sm btn-outline-primary" style="padding: 5px 9px; font-size: 0.82rem;" title="Rincian Jawaban">
                                                    <i class="fas fa-eye"></i> Detail
                                                </a>
                                                <button type="button" class="btn btn-sm" style="background: #1b4d3e; color: #ffffff; border: none; padding: 5px 9px; font-size: 0.82rem; border-radius: 6px; cursor: pointer; display: inline-flex; align-items: center; gap: 4px;" title="Edit Nilai" onclick="openEditNilaiModal(<%= r.id %>, '<%= (r.nama_lengkap || '').replace(/'/g, '\\\'') %>', <%= r.nilai_total || 0 %>)">
                                                    <i class="fas fa-pen-to-square"></i> Edit
                                                </button>
                                                <form method="POST" action="/admin/hasil" style="display: inline;" onsubmit="return confirm('Reset ujian untuk mahasiswa ini agar bisa ujian ulang?');">
                                                    <input type="hidden" name="action" value="reset_single">
                                                    <input type="hidden" name="sesi_id" value="<%= r.id %>">
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" style="padding: 5px 9px; font-size: 0.82rem;" title="Reset Ujian"><i class="fas fa-rotate-left"></i></button>
                                                </form>
                                                <form method="POST" action="/admin/hasil" style="display: inline;" onsubmit="return confirm('Hapus permanen data nilai ini?');">
                                                    <input type="hidden" name="action" value="delete_single">
                                                    <input type="hidden" name="sesi_id" value="<%= r.id %>">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" style="padding: 5px 9px; font-size: 0.82rem;" title="Hapus"><i class="fas fa-trash"></i></button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- MODAL EDIT NILAI (CENTERED) -->
    <div id="modal-edit-nilai" class="modal-overlay" style="display: none; position: fixed; inset: 0; width: 100vw; height: 100vh; background: rgba(15,23,42,0.6); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box;">
        <div class="card" style="max-width: 440px; width: 100%; border-radius: 12px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.25); border: 1px solid #e2e8f0; padding: 24px; box-sizing: border-box; background: #ffffff;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
                <h3 style="margin: 0; font-size: 1.25rem; font-weight: 700; color: #1b4d3e; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-pen-to-square"></i> Edit Nilai Mahasiswa
                </h3>
                <button type="button" style="background: none; border: none; font-size: 1.4rem; color: #94a3b8; cursor: pointer;" onclick="document.getElementById('modal-edit-nilai').style.display='none'">&times;</button>
            </div>
            <form method="POST" action="/admin/hasil">
                <input type="hidden" name="action" value="edit_nilai">
                <input type="hidden" name="sesi_id" id="edit_nilai_sesi_id">

                <div class="form-group" style="margin-bottom: 14px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Nama Mahasiswa</label>
                    <input type="text" id="edit_nilai_nama" readonly class="form-control" style="width: 100%; padding: 10px 12px; border: 1.5px solid #e2e8f0; border-radius: 8px; background: #f8fafc; color: #475569;">
                </div>

                <div class="form-group" style="margin-bottom: 18px;">
                    <label style="font-weight: 600; font-size: 0.88rem; display: block; margin-bottom: 6px;">Nilai Akhir (Skor) <span style="color:#dc2626;">*</span></label>
                    <input type="number" step="0.1" min="0" max="100" name="nilai_total" id="edit_nilai_angka" required class="form-control" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-size: 1.1rem; font-weight: 700;">
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; border-top: 1px solid #f1f5f9; padding-top: 14px;">
                    <button type="button" class="btn btn-secondary" onclick="document.getElementById('modal-edit-nilai').style.display='none'" style="padding: 9px 18px; border-radius: 8px;">Batal</button>
                    <button type="submit" class="btn btn-primary" style="background: #1b4d3e; border: none; padding: 9px 20px; border-radius: 8px; font-weight: 600;"><i class="fas fa-check"></i> Simpan Nilai</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openEditNilaiModal(sesiId, nama, nilai) {
            document.getElementById('edit_nilai_sesi_id').value = sesiId;
            document.getElementById('edit_nilai_nama').value = nama;
            document.getElementById('edit_nilai_angka').value = nilai;
            document.getElementById('modal-edit-nilai').style.display = 'flex';
        }

        window.addEventListener('click', function(e) {
            if (e.target === document.getElementById('modal-edit-nilai')) {
                document.getElementById('modal-edit-nilai').style.display = 'none';
            }
        });

        window.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const m = document.getElementById('modal-edit-nilai');
                if (m) m.style.display = 'none';
            }
        });
    </script>
</body>
</html>
