# Ingin menggunakan Groq API? Masukkan API key dari akun Groq Anda (gsk_...) di bawah ini:
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Atau gunakan Google Gemini:
GEMINI_API_KEY=

# Server Configuration
SESSION_SECRET=sipena-session-secret-key-change-in-production
PORT=3000
